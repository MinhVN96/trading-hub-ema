createBox(left, right, top, bottom, color) =>
    box.new(left=left, right=right, top=top, bottom=bottom, xloc = xloc.bar_time, bgcolor=color, border_color=color, extend = extend.right)

removeZone(zoneArray, box zone) =>
    index = array.indexof(zoneArray, zone)
    box.delete(zone)
    array.remove(zoneArray, index)

marginZone(zone) => [box.get_top(zone), box.get_bottom(zone), box.get_left(zone)]

handleZone(zoneArray, left, top, bot, color) =>
    _top = top
    _bot = bot
    _left = left

    zone = getNLastValue(zoneArray, 1)

    [topZone, botZone, leftZone] = marginZone(zone)
    rangeTop = math.abs(_top-topZone)/(topZone-botZone) < mergeRatio
    rangeBot = math.abs(_bot-botZone)/(topZone-botZone) < mergeRatio

    //Merge zone
    if _top >= topZone and _bot <= botZone or rangeTop or rangeBot
        _top := math.max(_top,topZone)
        _bot := math.min(_bot,botZone)
        _left := leftZone
        removeZone(zoneArray, zone)

    if not (_top <= topZone and _bot >= botZone)
        array.push(zoneArray, createBox(_left, time, _top, _bot, color))

processZones(zones, isSupply) =>
    if array.size(zones) > 0
        for i = array.size(zones) - 1 to 0 by 1
            zone = array.get(zones, i)
            [topZone, botZone, leftZone] = marginZone(zone)

            //Breaker block zones
            if isSupply and low < botZone and close > topZone
                array.push(demandZone, createBox(leftZone, time, topZone, botZone, colorDemand))
            else if not isSupply and high > topZone and close < botZone
                array.push(supplyZone, createBox(leftZone, time, topZone, botZone, colorSupply))
            //Mitigated zones
            else if (isSupply and high >= botZone and high < topZone) or (not isSupply and low <= topZone and low > botZone)
                box.set_right(zone, time)
                box.set_extend(zone,extend.none)
                box.set_bgcolor(zone, colorMitigated)
                box.set_border_color(zone, colorMitigated)

            //Delete sweep zones
            if (time - leftZone > len*maxBarHistory) or (isSupply and high >= topZone) or (not isSupply and low <= botZone)
                removeZone(zones, zone)

// Nến CƯƠNG LỰC / TIÊU CHUẨN: thân chiếm >= ofEscapeBody biên độ nến. Nến do dự / rút chân dài
// (thân nhỏ so với râu) KHÔNG tính — cú vọt ra khỏi vùng OF phải bằng nến có lực thật thì mới
// coi là giá đã rời hẳn vùng, chứ không phải một cái râu quét lên rồi thụt về.
isDecisiveBar(float o, float h, float l, float c) =>
    float rng = h - l
    rng > 0 and math.abs(c - o) / rng >= ofEscapeBody

createOFBox(int left, float top, float bot, color col) =>
    box.new(left=left, right=time, top=top, bottom=bot, xloc=xloc.bar_time, bgcolor=col, border_color=col, extend=extend.right)

removeOFZone(int i) =>
    box.delete(array.get(ofZone, i))
    label.delete(array.get(ofLabel, i))
    array.remove(ofZone, i)
    array.remove(ofLabel, i)
    array.remove(ofZoneBarIdx, i)
    array.remove(ofZoneIsBull, i)
    array.remove(ofZoneActive, i)
    array.remove(ofZoneMit, i)
    array.remove(ofZoneBroken, i)
    array.remove(ofZoneTouchTime, i)
    array.remove(ofZoneInside, i)
    array.remove(ofZoneOut, i)
    array.remove(ofZoneConf, i)

// Pivot MỚI xác nhận vượt qua biên giữ của vùng OF => cấu trúc đã phủ nhận vùng, xoá.
// Khác với wick: râu nến chọc qua biên KHÔNG giết vùng (xem processOFZones), nhưng một
// swing ĐÃ XÁC NHẬN vượt đỉnh vùng bear / thủng đáy vùng bull thì vùng hết giá trị —
// tránh vùng cũ bị giá vượt mặt vẫn kéo dài mãi. Vùng mitigated (đã đóng băng) giữ nguyên.
invalidateOFByPivot(bool isHighPivot, float p) =>
    if array.size(ofZone) > 0
        for i = array.size(ofZone) - 1 to 0 by 1
            if not array.get(ofZoneMit, i)
                [t, b, l] = marginZone(array.get(ofZone, i))
                bool isBull = array.get(ofZoneIsBull, i)
                if (isHighPivot and not isBull and t < p) or (not isHighPivot and isBull and b > p)
                    removeOFZone(i)

// Đẩy thẳng 1 vùng OF mới (không qua kiểm tra chứa/nuốt của addOFZone).
pushOFZone(int left, float top, float bot, bool isBull) =>
    color col = isBull ? colorOFBull : colorOFBear
    array.push(ofZone, createOFBox(left, top, bot, col))
    array.push(ofLabel, label.new(left, top, "OF", xloc.bar_time, yloc.price, color = transp, textcolor = col, style = label.style_label_down, size = size.tiny))
    array.push(ofZoneBarIdx, bar_index)
    array.push(ofZoneIsBull, isBull)
    array.push(ofZoneActive, false)
    array.push(ofZoneMit, false)
    array.push(ofZoneBroken, false)
    array.push(ofZoneTouchTime, na)
    array.push(ofZoneInside, 0)
    array.push(ofZoneOut, 0)
    array.push(ofZoneConf, false)

addOFZone(int left, float top, float bot, bool isBull) =>
    // LUẬT VÙNG LỌT TRONG VÙNG (cốt lõi cho thị trường đi ngang):
    // Giá đi ngang bên trong một vùng OF — lên chạm đỉnh vùng rồi vòng xuống, CHƯA chạm tới
    // biên XA — nghĩa là vùng đó VẪN ĐANG BỊ KHAI THÁC DỞ. Mọi "chân hồi" sinh ra trong lúc đó
    // chỉ là nhiễu của chính nhịp sideway, KHÔNG phải mất cân bằng mới => KHÔNG tạo OF nằm lọt
    // trong nó. Vùng cũ chỉ hết quyền chi phối khi giá đã VỌT HẲN ra ngoài (cả cây nến ở ngoài,
    // đúng chiều vùng đẩy) đủ ofEscapeBars nến CƯƠNG LỰC/TIÊU CHUẨN — lúc đó nhịp mới mới là
    // nhịp thật, và OF mới gần giá nhất bên trong biên vùng cũ được phép vẽ.
    // Bộ đếm ofZoneOut do processOFZones cập nhật mỗi nến; đủ ngưỡng thì giữ vĩnh viễn.
    //
    // KHÁC BẢN CŨ: trước đây chỉ vùng CHƯA mitigated mới chặn, nên đúng ca đang nói (giá đã
    // chạm vùng rồi quay đầu đi ngang bên trong = vùng ĐÃ mitigated) thì luật chặn mất tác dụng
    // và OF rác mọc đầy trong range. Nay vùng mitigated-nhưng-chưa-broken vẫn chặn; đổi lại
    // phải có cổng ofZoneOut để vùng cũ không chặn vĩnh viễn.
    bool contained = false
    if array.size(ofZone) > 0
        for i = array.size(ofZone) - 1 to 0 by 1
            if array.get(ofZoneIsBull, i) == isBull
                bool mitI = array.get(ofZoneMit, i)
                [t, b, l] = marginZone(array.get(ofZone, i))
                if top <= t and bot >= b
                    // Vùng cha CÒN quyền chặn khi: chưa bị phá hết chiều sâu (chưa broken) VÀ
                    // giá chưa từng vọt ra hẳn khỏi nó đủ ofEscapeBars nến cương lực/tiêu chuẩn.
                    // Vùng ĐÃ MITIGATED NHƯNG CHƯA BROKEN VẪN CHẶN — đây đúng là ca giá chạm vào
                    // vùng rồi đi ngang bên trong: vùng đang bị khai thác dở, chưa chạm biên xa.
                    // (Vùng broken = đã bị tiêu thụ hết => hết quyền chặn. Vùng cũ mà giá đã bỏ
                    // đi từ lâu thì bộ đếm ofZoneOut cũng đã vượt ngưỡng nên không chặn nữa.)
                    if not array.get(ofZoneBroken, i) and array.get(ofZoneOut, i) < ofEscapeBars
                        contained := true
                else if not mitI and t <= top and b >= bot
                    // vùng mitigated là lịch sử đã đóng băng: không bị vùng mới nuốt mất
                    removeOFZone(i)
    if not contained
        pushOFZone(left, top, bot, isBull)

processOFZones() =>
    if array.size(ofZone) > 0
        for i = array.size(ofZone) - 1 to 0 by 1
            box zone = array.get(ofZone, i)
            [t, b, l] = marginZone(zone)
            bool isBull = array.get(ofZoneIsBull, i)
            bool active = array.get(ofZoneActive, i)
            bool expired = bar_index - array.get(ofZoneBarIdx, i) > 1999

            // ĐẾM SIDEWAY: đếm CHUỖI NẾN LIÊN TIẾP mà giá còn kẹt trong vùng (nến giao với vùng);
            // nến nào ra hẳn ngoài vùng thì reset về 0. Đủ chopOFBars nến liên tiếp => cờ ĐÓNG
            // VĨNH VIỄN (không reset nữa) = vùng chỉ là biên độ đi ngang, tầng hiển thị ẩn hẳn.
            //   Vì sao dùng CHUỖI LIÊN TIẾP chứ không cộng dồn: vùng OF NHỎ sát giá trong một
            //   range cũng bị giá chạm đi chạm lại nhiều lần, cộng dồn thì nó cũng bị ẩn oan —
            //   trong khi đây chính là vùng đáng giữ nhất. Vùng nhỏ luôn có nến ra hẳn ngoài nên
            //   chuỗi bị reset liên tục; chỉ vùng RỘNG trùm cả range mới giữ được chuỗi dài.
            // Chỉ ảnh hưởng HIỂN THỊ; lifecycle (mitigate/broken/xoá) vẫn chạy y nguyên.
            bool touching = high >= b and low <= t
            if touching
                array.set(ofZoneInside, i, array.get(ofZoneInside, i) + 1)
            else if array.get(ofZoneInside, i) < chopOFBars
                array.set(ofZoneInside, i, 0)

            // ĐẾM NẾN VỌT RA HẲN NGOÀI VÙNG — điều kiện để vùng này thôi chặn OF mới nằm lọt
            // bên trong nó (xem addOFZone). "Ra hẳn" = CẢ CÂY NẾN nằm ngoài, về ĐÚNG PHÍA vùng
            // đẩy giá đi (bull/demand: nến nằm trên đỉnh vùng; bear/supply: nằm dưới đáy vùng)
            // — giống hệt điều kiện kích hoạt ofZoneActive. Chỉ nến CƯƠNG LỰC/TIÊU CHUẨN mới
            // được +1; nến do dự nằm ngoài thì không cộng nhưng cũng không xoá số đã đếm. Giá
            // chạm lại vào vùng khi CHƯA đủ số nến => đếm lại từ 0 (vùng vẫn đang bị khai thác).
            // ĐỦ ofEscapeBars RỒI THÌ GIỮ LUÔN, không reset nữa: giá đã một lần rời hẳn vùng thì
            // vùng hết quyền chi phối vĩnh viễn — nếu reset, cú hồi quay lại vùng cũ để tạo OF
            // mới (đúng ca ảnh 2) sẽ tự tay xoá điều kiện vừa thoả và OF mới lại bị chặn.
            if array.get(ofZoneOut, i) < ofEscapeBars
                if touching
                    array.set(ofZoneOut, i, 0)
                else if (isBull and low > t) or (not isBull and high < b)
                    if isDecisiveBar(open, high, low, close)
                        array.set(ofZoneOut, i, array.get(ofZoneOut, i) + 1)

            // QUY TẮC #1 BẮT BUỘC (BankTrap 1.5) — XÁC NHẬN OF: "Bearish OF: giá phải PHÁ KHỎI
            // ĐÁY của OF" / "Bullish OF: giá phải PHÁ KHỎI ĐỈNH của OF". Xác nhận = 1 nến cương
            // lực/tiêu chuẩn ĐÓNG CỬA vượt hẳn biên XA của vùng. Cờ sticky, chỉ set 1 lần.
            //   CỬA SỔ ofConfirmBars: phải phá TRONG những nến đầu sau khi vùng hình thành. OF
            //   theo định nghĩa là "chuyển động hồi cuối cùng TRƯỚC KHI TIẾP DIỄN xu hướng" —
            //   nhịp tiếp diễn đến NGAY sau chân hồi. Nếu giá lởn vởn trong vùng cả chục nến rồi
            //   mới thủng thì cú thủng đó không phải nhịp tiếp diễn của chân hồi này, chỉ là dao
            //   động của một cái range => vùng vô hiệu vĩnh viễn.
            //   ĐÂY LÀ ĐIỀU KIỆN KHÁC HẲN ofZoneOut/ofEscapeBars: cái kia (5 nến nằm hẳn ngoài)
            //   chỉ dùng cho Quy tắc #2 (vùng lọt trong vùng). Dùng nhầm ngưỡng 5 nến làm điều
            //   kiện hợp lệ sẽ giết oan các OF mà giá phá đáy rồi bật lại ngay — đúng ca BTCUSDT
            //   4H 29-30/7/26: đổ 65.4k -> 62.8k xuyên đáy vùng rồi hồi lên liền, không bao giờ
            //   có nổi 5 nến nằm dưới đáy.
            if not array.get(ofZoneConf, i) and bar_index - array.get(ofZoneBarIdx, i) <= ofConfirmBars
                if ((isBull and close > t) or (not isBull and close < b)) and isDecisiveBar(open, high, low, close)
                    array.set(ofZoneConf, i, true)

            if not active
                // Pha 1: box vừa tạo, giá thường còn nằm trong vùng => GIỮ NGUYÊN MÀU,
                // chỉ kích hoạt khi cả cây nến đã RỜI HẲN khỏi vùng.
                //   bull/demand: cả nến nằm trên đỉnh vùng (low > t)
                //   bear/supply: cả nến nằm dưới đáy vùng (high < b)
                if (isBull and low > t) or (not isBull and high < b)
                    array.set(ofZoneActive, i, true)
                // Hỏng trước khi kích hoạt: đóng cửa xuyên biên giữ, hoặc hết hạn => xoá
                if expired or (isBull and close < b) or (not isBull and close > t)
                    removeOFZone(i)
            else
                // Pha 2 (đã active): mitigated / phá qua / xoá. ĐÃ BỎ breaker flip: box bị phá
                // xuyên không lật màu thành vùng ngược hướng nữa.
                // Mitigated theo CHẠM: giá quay lại chạm vào vùng (kể cả chỉ bằng râu nến) =>
                // tô xám. Trước đây đòi close bên trong vùng nên cú hồi quét râu sâu vào vùng
                // rồi bật ra vẫn để vùng "như chưa test" — sai với thực tế vùng đã được tiêu thụ.
                // Ghi nhận NGAY khi chạm, không chờ đủ tuổi minOFAge — minOFAge chỉ trì hoãn
                // HIỂN THỊ (đỡ rối mắt vùng vừa tạo), không được phép làm mất trạng thái mitigate
                // thật của vùng (nếu không, cú chạm sớm trong 20 nến đầu bị bỏ qua vĩnh viễn dù
                // giá đã thực sự quay lại test vùng).
                bool isBroken = array.get(ofZoneBroken, i)
                bool wasMit = array.get(ofZoneMit, i)
                if not isBroken and ((not isBull and high >= b and close < t) or (isBull and low <= t and close > b))
                    array.set(ofZoneMit, i, true)
                    // Đóng băng cạnh phải MỘT LẦN DUY NHẤT tại lần chạm ĐẦU TIÊN — không đẩy
                    // dài thêm khi giá chạm lại các nến sau (trước đây set_right mỗi nến còn
                    // chạm khiến box bị kéo dài theo cả giai đoạn khai thác). Riêng vùng đang
                    // được khai thác realtime sẽ được tạm kéo dài ở tầng hiển thị bên dưới.
                    if not wasMit
                        box.set_right(zone, time)
                        box.set_extend(zone, extend.none)
                        array.set(ofZoneTouchTime, i, time)

                // Phá qua: vùng ĐÃ mitigated mà giá đi tới biên XA của vùng (chạm đỉnh vùng bear
                // / chạm đáy vùng bull) => toàn bộ chiều sâu vùng đã bị tiêu thụ, vùng chết.
                // Lưu cờ broken VĨNH VIỄN (sự kiện một lần) — cạnh phải GIỮ NGUYÊN tại lần chạm
                // đầu tiên, không đẩy tới nến phá.
                if array.get(ofZoneMit, i) and not isBroken and ((not isBull and high >= t) or (isBull and low <= b))
                    array.set(ofZoneBroken, i, true)

                // Xóa khi nến ĐÓNG CỬA xuyên qua biên giữ hoặc hết hạn (vùng gốc bị phá cũng xóa
                // ở đây, chỉ giữ vùng lật breaker). KHÔNG xoá theo wick: râu nến chọc qua biên chỉ
                // là quét thanh khoản (sweep) — nến đóng lại trong/ngoài vùng thì vùng vẫn còn
                // giá trị. Trước đây xoá theo wick khiến rất nhiều OF bị giết oan chỉ vì một râu
                // chọc nhẹ vài tick qua đáy/đỉnh vùng.
                if expired or (not isBull and close > t) or (isBull and close < b)
                    removeOFZone(i)

    // HIỂN THỊ — chỉ tính ở nến cuối (màu box là trạng thái sau cùng nên không cần set từng nến):
    //  - vùng non hơn minOFAge: ẩn
    //  - vùng xám (mitigated): chỉ hiện khi bật showMitOF (lịch sử, không giao dịch được nữa)
    //  - vùng active: mỗi chiều bull/bear chỉ hiện maxOFShow vùng GẦN GIÁ nhất; vùng xa tự ẩn,
    //    khi giá quay lại gần thì tự hiện. Lifecycle vẫn chạy bình thường cho vùng đang ẩn.
    if barstate.islast and array.size(ofZone) > 0
        int zCnt = array.size(ofZone)
        distArr = array.new_float(zCnt, 0.0)
        for i = 0 to zCnt - 1
            [t, b, l] = marginZone(array.get(ofZone, i))
            array.set(distArr, i, close > t ? close - t : close < b ? b - close : 0.0)
        // chopArr[i] = vùng đã bị giá đi ngang bên trong quá lâu (>= chopOFBars nến nằm trong
        // vùng). Vùng này bị ẩn HOÀN TOÀN và bị loại khỏi mọi xếp hạng bên dưới: không chiếm
        // suất hiển thị của vùng khác, không được tính là "vùng bên trong" bắt vùng bao ngoài
        // phải nhường chỗ, và không được chọn làm Extreme OF.
        chopArr = array.new_bool(zCnt, false)
        for i = 0 to zCnt - 1
            array.set(chopArr, i, hideChopOF and array.get(ofZoneInside, i) >= chopOFBars)
        // validArr[i] = OF ĐÃ ĐƯỢC XÁC NHẬN theo QUY TẮC #1 BẮT BUỘC của BankTrap (mục 1.5) —
        // cờ ofZoneConf, set trong lifecycle phía trên (xem giải thích đầy đủ ở đó).
        // Đây là điều kiện code TỪNG THIẾU HOÀN TOÀN: trước đây vẽ vùng ngay khi vừa tạo, nên
        // trong nhịp đi ngang mỗi pivot đẻ ra một box mà giá CHƯA HỀ phá khỏi nó — vùng chưa hợp
        // lệ nhưng vẫn nằm chình ình trên chart. Vùng chưa xác nhận: KHÔNG vẽ, KHÔNG chiếm suất
        // hiển thị của vùng khác, KHÔNG được chọn làm Extreme OF — nhưng vẫn sống trong mảng để
        // chặn OF rác sinh ra bên trong nó (Quy tắc #2, xem addOFZone) và để lifecycle chạy tiếp.
        validArr = array.new_bool(zCnt, false)
        for i = 0 to zCnt - 1
            array.set(validArr, i, array.get(ofZoneConf, i))
        // containsArr[i] = vùng i bao trọn (chặt) một vùng khác đã đủ tuổi hiển thị — vùng
        // "thô" cũ hơn, rộng hơn, đã mitigated và giá đi ngang bên trong nó. Vùng mitigated
        // bao trùm như vậy tự ẩn, nhường chỗ cho vùng nhỏ/mới hơn bên trong (ví dụ OF vàng
        // nằm lọt trong OF hồng cũ) — khi vùng nhỏ chết, vùng lớn tự hiện lại.
        containsArr = array.new_bool(zCnt, false)
        for i = 0 to zCnt - 1
            [ti, bi, li] = marginZone(array.get(ofZone, i))
            for j = 0 to zCnt - 1
                if j != i and array.get(validArr, j) and not array.get(chopArr, j) and bar_index - array.get(ofZoneBarIdx, j) >= minOFAge
                    [tj, bj, lj] = marginZone(array.get(ofZone, j))
                    if ti >= tj and bi <= bj and not (ti == tj and bi == bj)
                        array.set(containsArr, i, true)
        // Extreme OF: OF CHƯA khai thác (chưa mitigated/broken) nằm SÂU NHẤT mỗi chiều — bull =
        // đáy thấp nhất, bear = đỉnh cao nhất; dưới/trên nó không còn OF nào => xác suất cao nhất.
        // Các OF cùng chiều còn lại là Decisional. Chỉ đánh dấu, không đổi lifecycle.
        int exBullIdx = -1
        int exBearIdx = -1
        float exBullBot = na
        float exBearTop = na
        for i = 0 to zCnt - 1
            if array.get(validArr, i) and not array.get(ofZoneMit, i) and not array.get(ofZoneBroken, i) and not array.get(chopArr, i)
                [ti, bi, li] = marginZone(array.get(ofZone, i))
                if array.get(ofZoneIsBull, i)
                    if na(exBullBot) or bi < exBullBot
                        exBullBot := bi
                        exBullIdx := i
                else
                    if na(exBearTop) or ti > exBearTop
                        exBearTop := ti
                        exBearIdx := i
        for i = zCnt - 1 to 0 by 1
            box zone = array.get(ofZone, i)
            bool isBull = array.get(ofZoneIsBull, i)
            bool isMit = array.get(ofZoneMit, i)
            [zt, zb, zl] = marginZone(zone)
            // Vùng mitigated mà giá HIỆN ĐANG nằm trong (đang khai thác, chưa phá qua biên giữ)
            // vẫn hiện với MÀU GỐC: nếu để xám/ẩn theo showMitOF thì vùng biến mất đúng lúc giá
            // đang phản ứng với nó. Chỉ ưu ái vùng đang khai thác; mitigated khác vẫn ẩn như cũ.
            bool isBroken = array.get(ofZoneBroken, i)
            bool ofExploit = isMit and not isBroken and close <= zt and close >= zb
            // Mỗi vùng OF tự đóng băng cạnh phải tại đúng lần nó được test cuối cùng (xử lý ở
            // khối mitigate/broken phía trên) — KHÔNG ép cạnh theo vùng khác. Chỉ riêng MÀU
            // "đang khai thác" (đỏ/xanh) mới cần ưu tiên: nếu giá hiện đứng đúng dải GIAO NHAU
            // của 2+ vùng OF cùng chiều đang exploit cùng lúc, chỉ vùng được chạm GẦN ĐÂY NHẤT
            // mới được tô — tránh 2 vùng chồng lấn cùng sáng khi giá đứng đúng chỗ giao nhau.
            bool isPinkActive = ofExploit
            if ofExploit
                for j = 0 to zCnt - 1
                    if j != i and array.get(ofZoneIsBull, j) == isBull
                        [tj, bj, lj] = marginZone(array.get(ofZone, j))
                        bool jExploit = array.get(ofZoneMit, j) and not array.get(ofZoneBroken, j) and close <= tj and close >= bj
                        if jExploit and array.get(ofZoneTouchTime, j) > array.get(ofZoneTouchTime, i)
                            isPinkActive := false
            bool ofExploitFinal = ofExploit and isPinkActive
            // Vùng đang được khai thác realtime: tạm kéo cạnh phải tới nến hiện tại để box phủ
            // đúng chỗ giá đang test; khi giá rời khỏi vùng thì co về đúng mốc chạm ĐẦU TIÊN
            // (ofZoneTouchTime) — mọi vùng mitigated khác cũng luôn được neo về mốc đó.
            int firstTouch = array.get(ofZoneTouchTime, i)
            if isMit and not na(firstTouch)
                box.set_right(zone, ofExploitFinal ? time : firstTouch)
                box.set_extend(zone, extend.none)
            // QUY TẮC #1 (validArr) đứng TRƯỚC mọi luật hiển thị khác: chưa phá khỏi đáy/đỉnh
            // của chính nó thì chưa phải OF hợp lệ, không bàn tới chuyện hiện hay ẩn.
            bool visible = array.get(validArr, i) and bar_index - array.get(ofZoneBarIdx, i) >= minOFAge
            if visible and isMit
                if isBroken
                    // vùng đã bị giá phá qua toàn bộ chiều sâu: chỉ hiện khi bật showMitOF
                    visible := showMitOF
                else if ofExploitFinal
                    visible := true
                else if array.get(containsArr, i)
                    // vùng mitigated "thô" đang bao trùm vùng khác: nhường hiển thị cho vùng
                    // nhỏ/mới hơn bên trong, chỉ hiện khi bật showMitOF
                    visible := showMitOF
                else
                    // Dù showMitOF tắt, vẫn giữ hiện maxMitOFShow vùng mitigated GẦN GIÁ NHẤT
                    // ở mỗi phía (trên/dưới giá hiện tại) — đây là các vùng vừa được test gần
                    // đây nhất, không nên biến mất hoàn toàn khỏi chart. Vùng broken/bao trùm
                    // bị loại khỏi xếp hạng (không hiện, không chiếm suất của vùng khác).
                    bool isBelow = zt < close
                    int nearerMit = 0
                    float diMit = array.get(distArr, i)
                    for j = 0 to zCnt - 1
                        if j != i and array.get(validArr, j) and array.get(ofZoneMit, j) and not array.get(ofZoneBroken, j) and not array.get(containsArr, j) and not array.get(chopArr, j) and bar_index - array.get(ofZoneBarIdx, j) >= minOFAge
                            [tj, bj, lj] = marginZone(array.get(ofZone, j))
                            bool jExploit = close <= tj and close >= bj
                            bool sameSide = isBelow ? tj < close : bj > close
                            if not jExploit and sameSide
                                float dj = array.get(distArr, j)
                                if dj < diMit or (dj == diMit and j > i)
                                    nearerMit += 1
                    visible := showMitOF or nearerMit < maxMitOFShow
            if visible and not isMit
                // xếp hạng theo khoảng cách tới giá trong các vùng active cùng chiều, đã đủ tuổi
                int nearer = 0
                float di = array.get(distArr, i)
                for j = 0 to zCnt - 1
                    if j != i and array.get(validArr, j) and array.get(ofZoneIsBull, j) == isBull and not array.get(ofZoneMit, j) and not array.get(chopArr, j) and bar_index - array.get(ofZoneBarIdx, j) >= minOFAge
                        float dj = array.get(distArr, j)
                        if dj < di or (dj == di and j > i)
                            nearer += 1
                visible := nearer < maxOFShow
            // Màu "đang khai thác" (ĐỎ nếu là OF bán, XANH LÁ nếu là OF mua — theo chiều vùng,
            // không còn dùng màu hồng/tím riêng) chỉ áp cho khung khác 15m; trên khung 15m vẫn
            // để xám mitigated như bình thường (đỡ rối mắt ở khung theo dõi chính).
            // Extreme OF luôn hiện (level quan trọng nhất) + viền nổi bật + nhãn "Ex OF".
            bool isExtreme = markExtremeOF and (i == exBullIdx or i == exBearIdx)
            if isExtreme
                visible := true
            // Bộ lọc PHỤ (mặc định TẮT — xem hideChopOF): ẩn hẳn vùng mà giá kẹt bên trong quá
            // lâu. Việc xử lý sideway chính đã chuyển xuống khâu TẠO vùng (xem addOFZone), nên
            // bộ lọc này chỉ dùng khi vẫn muốn dọn nốt cái box mà giá đang quanh quẩn bên trong.
            if array.get(chopArr, i)
                visible := false
            color colExploit = isBull ? colorOFExploitBull : colorOFExploitBear
            color col = ofExploitFinal ? (is15m ? colorMitigated : colExploit) : isMit and not ofExploitFinal ? colorMitigated : isBull ? colorOFBull : colorOFBear
            color shownCol = visible ? col : color.new(col, 100)
            box.set_bgcolor(zone, shownCol)
            box.set_border_color(zone, isExtreme and visible ? colorExtremeOF : shownCol)
            box.set_border_width(zone, isExtreme and visible ? 2 : 1)
            label.set_textcolor(array.get(ofLabel, i), isExtreme and visible ? colorExtremeOF : shownCol)
            label.set_text(array.get(ofLabel, i), isExtreme and visible ? "Ex OF" : "OF")

addLastPullbackOF(bool isBull) =>
    // OF tại CHOCH luôn được vẽ, KHÔNG qua bộ lọc HH/LL: CHOCH đã tự xác nhận đảo chiều, nên
    // chân hồi cuối trước nhịp phá cấu trúc CHÍNH LÀ vùng OF hợp lệ (nếu lọc HH/LL ở đây thì
    // OF đảo chiều gần như không bao giờ được vẽ). Bộ lọc HH/LL chỉ dành cho pullback giữa trend.
    // NEO BẰNG QUÉT NẾN THÔ, chọn kiểu neo bằng input chochOFAnchor:
    //   "OB cực trị" (mặc định, scanExtremeOF) — cụm nến ngược chiều cuối ngay tại đỉnh/đáy tạo
    //     CHoCH: vùng nhỏ, sát giá, không phình theo biên độ sideway.
    //   "Chân hồi cuối" (scanLastPullback) — trọn chân hồi trước nhịp đẩy phá cấu trúc.
    // KHÔNG neo theo pivot puHigh/puLow nữa vì engine pullback bỏ sót mọi cú hồi nằm gọn trong
    // biên nến lớn trước đó (không sinh pivot) — OF từng bị thiếu/neo sai ở chính chỗ đảo chiều
    // vì vậy. Pivot chỉ còn là DỰ PHÒNG khi cả 2 cách quét thô đều thất bại (sát đầu lịch sử nạp).
    if showOF
        // Ưu tiên neo "OB cực trị" (vùng nhỏ ngay tại đỉnh/đáy tạo CHoCH — xem scanExtremeOF);
        // thất bại (không có nến ngược chiều nào tại cực trị) thì rơi về chân hồi cuối.
        float scanTop = na
        float scanBot = na
        int   scanBar = na
        if chochOFAnchor == "OB - cụm nến cực trị"
            [exT, exB, exBar] = scanExtremeOF(isBull, false)
            if not na(exT) and not na(exB) and exT > exB
                scanTop := exT
                scanBot := exB
                scanBar := exBar
        if na(scanTop)
            [pbA, pbABar, pbB, pbBBar] = scanLastPullback(isBull, false)
            scanTop := isBull ? pbB : pbA
            scanBot := isBull ? pbA : pbB
            scanBar := int(math.min(pbABar, pbBBar))
        if not na(scanTop) and not na(scanBot) and scanTop > scanBot
            addOFZone(scanBar, scanTop, scanBot, isBull)
        else if isBull
            float ofT = getNLastValue(puHigh, 1)
            int ofTBar = getNLastValue(puHBar, 1)
            if not na(ofT)
                [ofB, ofBBar] = findExtremeSince(puLow, puLBar, ofTBar, true)
                if not na(ofB)
                    addOFZone(math.min(ofTBar, ofBBar), ofT, ofB, true)
        else
            float ofB = getNLastValue(puLow, 1)
            int ofBBar = getNLastValue(puLBar, 1)
            if not na(ofB)
                [ofT, ofTBar] = findExtremeSince(puHigh, puHBar, ofBBar, false)
                if not na(ofT)
                    addOFZone(math.min(ofTBar, ofBBar), ofT, ofB, false)

scob(zones, isSupply) =>
    [topZone, botZone, leftZone] = marginZone(getNLastValue(zones, 1))

    if not isb[1]
        if not isSupply and low[1] < low[2] and low[1] < low and close > high[1] and low[1] < topZone and low[1] > botZone
            scobUp
        else if isSupply and high[1] > high[2] and high[1] > high and close < low[1] and high[1] < topZone and high[1] > botZone
            scobDn
        else
            na
