//#region OF 4H functions (bản sao độc lập của các hàm quản lý vùng OF, dùng riêng cho engine 4H)
removeOFZone4(int i) =>
    box.delete(array.get(ofZone4, i))
    label.delete(array.get(ofLabel4, i))
    array.remove(ofZone4, i)
    array.remove(ofLabel4, i)
    array.remove(ofZoneBarIdx4, i)
    array.remove(ofZoneIsBull4, i)
    array.remove(ofZoneActive4, i)
    array.remove(ofZoneMit4, i)
    array.remove(ofZoneBroken4, i)
    array.remove(ofZoneTouchTime4, i)
    array.remove(ofZone4Setup, i)
    array.remove(ofZoneInside4, i)
    array.remove(ofZoneOut4, i)
    array.remove(ofZoneConf4, i)

invalidateOFByPivot4(bool isHighPivot, float p) =>
    if array.size(ofZone4) > 0
        for i = array.size(ofZone4) - 1 to 0 by 1
            if not array.get(ofZoneMit4, i)
                [t, b, l] = marginZone(array.get(ofZone4, i))
                bool isBull = array.get(ofZoneIsBull4, i)
                if (isHighPivot and not isBull and t < p) or (not isHighPivot and isBull and b > p)
                    removeOFZone4(i)

pushOFZone4(int left, float top, float bot, bool isBull) =>
    color col = isBull ? colorOF4Bull : colorOF4Bear
    array.push(ofZone4, createOFBox(left, top, bot, col))
    array.push(ofLabel4, label.new(left, top, "OF 4H", xloc.bar_time, yloc.price, color = transp, textcolor = col, style = label.style_label_down, size = size.tiny))
    array.push(ofZoneBarIdx4, h4barCnt)
    array.push(ofZoneIsBull4, isBull)
    array.push(ofZoneActive4, false)
    array.push(ofZoneMit4, false)
    array.push(ofZoneBroken4, false)
    array.push(ofZoneTouchTime4, na)
    array.push(ofZone4Setup, false)
    array.push(ofZoneInside4, 0)
    array.push(ofZoneOut4, 0)
    array.push(ofZoneConf4, false)

addOFZone4(int left, float top, float bot, bool isBull) =>
    // Vùng lọt trong vùng chỉ được tạo khi vùng cũ đã bị giá vọt ra hẳn đủ ofEscapeBars nến 4H
    // cương lực/tiêu chuẩn — cùng logic với addOFZone, xem giải thích đầy đủ ở đó.
    bool contained = false
    if array.size(ofZone4) > 0
        for i = array.size(ofZone4) - 1 to 0 by 1
            if array.get(ofZoneIsBull4, i) == isBull
                bool mitI = array.get(ofZoneMit4, i)
                [t, b, l] = marginZone(array.get(ofZone4, i))
                if top <= t and bot >= b
                    if not array.get(ofZoneBroken4, i) and array.get(ofZoneOut4, i) < ofEscapeBars
                        contained := true
                else if not mitI and t <= top and b >= bot
                    removeOFZone4(i)
    if not contained
        pushOFZone4(left, top, bot, isBull)

// Lifecycle vùng OF 4H — chạy MỖI KHI ĐÓNG 1 NẾN 4H với giá 4H (hh/ll/cc), KHÔNG chạy theo
// nến 15m: vùng 4H rộng theo biên độ chân hồi 4H, nếu xét close 15m thì chỉ vài giờ là có
// nến 15m đóng trong vùng -> mitigated/xoá oan hàng loạt, không còn vùng nào hiển thị.
// Xét theo close 4H thì hành vi giống hệt khi xem vùng đó trên chart 4H.
lifecycleOFZones4(float oo, float hh, float ll, float cc) =>
    if array.size(ofZone4) > 0
        for i = array.size(ofZone4) - 1 to 0 by 1
            box zone = array.get(ofZone4, i)
            [t, b, l] = marginZone(zone)
            bool isBull = array.get(ofZoneIsBull4, i)
            bool active = array.get(ofZoneActive4, i)
            bool expired = h4barCnt - array.get(ofZoneBarIdx4, i) > 1999

            // Đếm sideway bằng NẾN 4H (hàm này chỉ chạy khi 1 nến 4H đóng) — chuỗi liên tiếp,
            // reset khi nến ra hẳn ngoài vùng, cùng logic với processOFZones (xem ở đó).
            bool touching = hh >= b and ll <= t
            if touching
                array.set(ofZoneInside4, i, array.get(ofZoneInside4, i) + 1)
            else if array.get(ofZoneInside4, i) < chopOFBars
                array.set(ofZoneInside4, i, 0)

            // Đếm nến 4H vọt ra hẳn ngoài vùng (đủ ngưỡng thì giữ vĩnh viễn, không reset) —
            // cùng logic với processOFZones, xem giải thích ở đó.
            if array.get(ofZoneOut4, i) < ofEscapeBars
                if touching
                    array.set(ofZoneOut4, i, 0)
                else if (isBull and ll > t) or (not isBull and hh < b)
                    if isDecisiveBar(oo, hh, ll, cc)
                        array.set(ofZoneOut4, i, array.get(ofZoneOut4, i) + 1)

            // QUY TẮC #1 — xác nhận OF bằng 1 nến 4H đóng cửa phá hẳn biên xa, trong cửa sổ
            // ofConfirmBars nến 4H đầu. Cùng logic với processOFZones, xem giải thích ở đó.
            if not array.get(ofZoneConf4, i) and h4barCnt - array.get(ofZoneBarIdx4, i) <= ofConfirmBars
                if ((isBull and cc > t) or (not isBull and cc < b)) and isDecisiveBar(oo, hh, ll, cc)
                    array.set(ofZoneConf4, i, true)

            if not active
                if (isBull and ll > t) or (not isBull and hh < b)
                    array.set(ofZoneActive4, i, true)
                if expired or (isBull and cc < b) or (not isBull and cc > t)
                    removeOFZone4(i)
            else
                // mitigated theo CHẠM của nến 4H (wick vào vùng là đủ) + cờ phá qua biên xa —
                // cùng logic với processOFZones, xem giải thích ở đó.
                bool isBroken = array.get(ofZoneBroken4, i)
                bool wasMit = array.get(ofZoneMit4, i)
                if not isBroken and ((not isBull and hh >= b and cc < t) or (isBull and ll <= t and cc > b))
                    array.set(ofZoneMit4, i, true)
                    // Đóng băng cạnh phải MỘT LẦN tại lần chạm đầu — cùng logic với
                    // processOFZones, xem giải thích ở đó.
                    if not wasMit
                        box.set_right(zone, time)
                        box.set_extend(zone, extend.none)
                        array.set(ofZoneTouchTime4, i, time)

                if array.get(ofZoneMit4, i) and not isBroken and ((not isBull and hh >= t) or (isBull and ll <= b))
                    array.set(ofZoneBroken4, i, true)

                if expired or (not isBull and cc > t) or (isBull and cc < b)
                    removeOFZone4(i)

visibilityOFZones4() =>
    if barstate.islast and array.size(ofZone4) > 0
        int zCnt = array.size(ofZone4)
        distArr = array.new_float(zCnt, 0.0)
        for i = 0 to zCnt - 1
            [t, b, l] = marginZone(array.get(ofZone4, i))
            array.set(distArr, i, close > t ? close - t : close < b ? b - close : 0.0)
        // chopArr — vùng OF 4H bị giá đi ngang bên trong quá lâu, cùng logic với processOFZones.
        chopArr = array.new_bool(zCnt, false)
        for i = 0 to zCnt - 1
            array.set(chopArr, i, hideChopOF and array.get(ofZoneInside4, i) >= chopOFBars)
        // validArr — QUY TẮC #1 BankTrap: OF chỉ hợp lệ sau khi giá đóng nến phá khỏi đáy/đỉnh
        // của chính nó, trong cửa sổ ofConfirmBars. Cùng logic với processOFZones, xem ở đó.
        validArr = array.new_bool(zCnt, false)
        for i = 0 to zCnt - 1
            array.set(validArr, i, array.get(ofZoneConf4, i))
        // containsArr — cùng logic với processOFZones, xem giải thích ở đó.
        containsArr = array.new_bool(zCnt, false)
        for i = 0 to zCnt - 1
            [ti, bi, li] = marginZone(array.get(ofZone4, i))
            for j = 0 to zCnt - 1
                if j != i and array.get(validArr, j) and not array.get(chopArr, j) and h4barCnt - array.get(ofZoneBarIdx4, j) >= minOFAge
                    [tj, bj, lj] = marginZone(array.get(ofZone4, j))
                    if ti >= tj and bi <= bj and not (ti == tj and bi == bj)
                        array.set(containsArr, i, true)
        // Extreme OF 4H — cùng logic với processOFZones, xem giải thích ở đó.
        int exBullIdx = -1
        int exBearIdx = -1
        float exBullBot = na
        float exBearTop = na
        for i = 0 to zCnt - 1
            if array.get(validArr, i) and not array.get(ofZoneMit4, i) and not array.get(ofZoneBroken4, i) and not array.get(chopArr, i)
                [ti, bi, li] = marginZone(array.get(ofZone4, i))
                if array.get(ofZoneIsBull4, i)
                    if na(exBullBot) or bi < exBullBot
                        exBullBot := bi
                        exBullIdx := i
                else
                    if na(exBearTop) or ti > exBearTop
                        exBearTop := ti
                        exBearIdx := i
        for i = zCnt - 1 to 0 by 1
            box zone = array.get(ofZone4, i)
            bool isBull = array.get(ofZoneIsBull4, i)
            bool isMit = array.get(ofZoneMit4, i)
            [zt, zb, zl] = marginZone(zone)
            // Vùng mitigated đang được giá khai thác (giá nằm trong vùng, chưa phá qua) vẫn
            // hiện màu gốc — cùng logic với processOFZones, xem giải thích ở đó.
            bool isBroken = array.get(ofZoneBroken4, i)
            bool ofExploit = isMit and not isBroken and close <= zt and close >= zb
            // Chỉ ưu tiên MÀU khai thác cho vùng được chạm gần đây nhất khi 2+ vùng cùng chiều đang
            // exploit tại đúng dải giao nhau — KHÔNG ép cạnh phải theo nhóm. Cùng logic với
            // processOFZones, xem giải thích ở đó.
            bool isPinkActive = ofExploit
            if ofExploit
                for j = 0 to zCnt - 1
                    if j != i and array.get(ofZoneIsBull4, j) == isBull
                        [tj, bj, lj] = marginZone(array.get(ofZone4, j))
                        bool jExploit = array.get(ofZoneMit4, j) and not array.get(ofZoneBroken4, j) and close <= tj and close >= bj
                        if jExploit and array.get(ofZoneTouchTime4, j) > array.get(ofZoneTouchTime4, i)
                            isPinkActive := false
            bool ofExploitFinal = ofExploit and isPinkActive
            // Kéo dài realtime khi đang khai thác / co về mốc chạm đầu — cùng logic với
            // processOFZones, xem giải thích ở đó.
            int firstTouch = array.get(ofZoneTouchTime4, i)
            if isMit and not na(firstTouch)
                box.set_right(zone, ofExploitFinal ? time : firstTouch)
                box.set_extend(zone, extend.none)
            // QUY TẮC #1 đứng trước mọi luật hiển thị khác — xem processOFZones.
            bool visible = array.get(validArr, i) and h4barCnt - array.get(ofZoneBarIdx4, i) >= minOFAge
            if visible and isMit
                if isBroken
                    // vùng đã bị giá phá qua toàn bộ chiều sâu: chỉ hiện khi bật showMitOF
                    visible := showMitOF
                else if ofExploitFinal
                    visible := true
                else if array.get(containsArr, i)
                    // vùng mitigated "thô" đang bao trùm vùng khác: nhường hiển thị cho vùng
                    // nhỏ/mới hơn bên trong, chỉ hiện khi bật showMitOF
                    visible := showMitOF
                else
                    // Giữ hiện maxMitOFShow vùng OF 4H mitigated GẦN GIÁ NHẤT mỗi phía, dù
                    // showMitOF tắt — cùng logic với processOFZones, vùng broken/bao trùm bị loại.
                    bool isBelow = zt < close
                    int nearerMit = 0
                    float diMit = array.get(distArr, i)
                    for j = 0 to zCnt - 1
                        if j != i and array.get(validArr, j) and array.get(ofZoneMit4, j) and not array.get(ofZoneBroken4, j) and not array.get(containsArr, j) and not array.get(chopArr, j) and h4barCnt - array.get(ofZoneBarIdx4, j) >= minOFAge
                            [tj, bj, lj] = marginZone(array.get(ofZone4, j))
                            bool jExploit = close <= tj and close >= bj
                            bool sameSide = isBelow ? tj < close : bj > close
                            if not jExploit and sameSide
                                float dj = array.get(distArr, j)
                                if dj < diMit or (dj == diMit and j > i)
                                    nearerMit += 1
                    visible := showMitOF or nearerMit < maxMitOFShow
            if visible and not isMit
                int nearer = 0
                float di = array.get(distArr, i)
                for j = 0 to zCnt - 1
                    if j != i and array.get(validArr, j) and array.get(ofZoneIsBull4, j) == isBull and not array.get(ofZoneMit4, j) and not array.get(chopArr, j) and h4barCnt - array.get(ofZoneBarIdx4, j) >= minOFAge
                        float dj = array.get(distArr, j)
                        if dj < di or (dj == di and j > i)
                            nearer += 1
                visible := nearer < maxOFShow
            // OF 4H vẫn tô màu "đang khai thác" (đỏ = OF bán, xanh lá = OF mua) như bình thường
            // — chỉ riêng OF khung hiện tại (native, xem processOFZones) mới chuyển xám khi
            // chart đang ở 15m.
            bool isExtreme = markExtremeOF and (i == exBullIdx or i == exBearIdx)
            if isExtreme
                visible := true
            // Bộ lọc phụ ẩn vùng giá kẹt bên trong (mặc định tắt) — cùng logic với processOFZones.
            if array.get(chopArr, i)
                visible := false
            color col = ofExploitFinal ? (isBull ? colorOFExploitBull : colorOFExploitBear) : isMit and not ofExploitFinal ? colorMitigated : isBull ? colorOF4Bull : colorOF4Bear
            color shownCol = visible ? col : color.new(col, 100)
            box.set_bgcolor(zone, shownCol)
            box.set_border_color(zone, isExtreme and visible ? colorExtremeOF : shownCol)
            box.set_border_width(zone, isExtreme and visible ? 2 : 1)
            label.set_textcolor(array.get(ofLabel4, i), isExtreme and visible ? colorExtremeOF : shownCol)
            label.set_text(array.get(ofLabel4, i), isExtreme and visible ? "Ex OF 4H" : "OF 4H")

addLastPullbackOF4(bool isBull) =>
    // Bản 4H của addLastPullbackOF — xem giải thích ở đó. Quét thô trên chuỗi 4H (use4h=true)
    // vì engine 4H có cùng điểm mù pivot; pivot 4H chỉ còn là dự phòng.
    float scanTop = na
    float scanBot = na
    int   scanBar = na
    if chochOFAnchor == "OB - cụm nến cực trị"
        [exT, exB, exBar] = scanExtremeOF(isBull, true)
        if not na(exT) and not na(exB) and exT > exB
            scanTop := exT
            scanBot := exB
            scanBar := exBar
    if na(scanTop)
        [pbA, pbABar, pbB, pbBBar] = scanLastPullback(isBull, true)
        scanTop := isBull ? pbB : pbA
        scanBot := isBull ? pbA : pbB
        scanBar := int(math.min(pbABar, pbBBar))
    if not na(scanTop) and not na(scanBot) and scanTop > scanBot
        addOFZone4(scanBar, scanTop, scanBot, isBull)
    else if isBull
        float ofT = getNLastValue(puHigh4, 1)
        int ofTBar = getNLastValue(puHBar4, 1)
        if not na(ofT)
            [ofB, ofBBar] = findExtremeSince(puLow4, puLBar4, ofTBar, true)
            if not na(ofB)
                addOFZone4(math.min(ofTBar, ofBBar), ofT, ofB, true)
    else
        float ofB = getNLastValue(puLow4, 1)
        int ofBBar = getNLastValue(puLBar4, 1)
        if not na(ofB)
            [ofT, ofTBar] = findExtremeSince(puHigh4, puHBar4, ofBBar, false)
            if not na(ofT)
                addOFZone4(math.min(ofTBar, ofBBar), ofT, ofB, false)
//#endregion

//#region OF Entry engine (HTF 4H = POI + trend SMC, LTF 15m = vùng OF vào lệnh). Chỉ đọc
// ofZone4/ofZone + trend 4H, KHÔNG đụng engine vẽ OF.

// Trend 4H = bias swing của SMC tính trên dữ liệu 4H. KHÔNG lệch [1] nên bám sát chart 4H thật
// (realtime có thể nhích nhẹ trong lúc nến 4H đang chạy — đúng như khi nhìn chart 4H bằng mắt).
[htfBias4, htfTrend4, htfSH4, htfSL4] = request.security(syminfo.tickerid, "240", f_smcSwingBias(entryTrendLeg), lookahead = barmerge.lookahead_off)

// Cờ xu hướng 4H dùng cho bộ lọc chiều lệnh (tính 1 lần mỗi nến, createOFEntry đọc lại).
// entryTrend4hConfirm quyết định mốc xác nhận: "CHoCH" (đảo chiều sớm, dùng hướng thô htfTrend4)
// hay "CHoCH + BOS" (chặt hơn, dùng htfBias4). Với chế độ "OF 4H engine", `isPrevBos4` là cờ
// "lần phá gần nhất là BOS" (engine đặt false tại CHoCH, true tại BOS).
// Chế độ "OF 4H engine" giữ lại để đối chiếu — nhưng nó TRỄ (xem giải thích ở input).
bool needBos4 = entryTrend4hConfirm == "CHoCH + BOS"
bool bos4OK   = not needBos4 or (not na(isPrevBos4) and isPrevBos4)   // isPrevBos4 khởi tạo = na
int  smcDir4  = needBos4 ? htfBias4 : htfTrend4
bool htfUp4 = entryTrendMode == "SMC swing 4H" ? smcDir4 ==  1 : (isCocUp4 and not isCocDn4 and bos4OK)
bool htfDn4 = entryTrendMode == "SMC swing 4H" ? smcDir4 == -1 : (isCocDn4 and not isCocUp4 and bos4OK)

// Mức swing SMC của KHUNG ĐANG XEM (leg = entryTPleg) — dùng làm TP: đỉnh cũ cho LONG, đáy cũ
// cho SHORT. Cùng thuật toán với nhãn HH/LL đang vẽ nên TP nằm đúng tại mốc bạn nhìn thấy.
// KHÔNG dùng H/L của engine Trading Hub nữa: (1) khác thuật toán nên lệch nhãn hiển thị,
// (2) tại nến CHoCH thì H/L đã bị khối update-IDM ghi đè thành đỉnh/đáy của chính nến đó.
// Đây là call site RIÊNG của f_smcSwingBias (chạy trên khung hiện tại, không qua request.security)
// nên state `var` bên trong độc lập hoàn toàn với call site 4H ở trên.
[tpBiasCur, tpTrendCur, tpSwingHigh, tpSwingLow] = f_smcSwingBias(entryTPleg)

// Cờ tín hiệu real-time (reset mỗi nến), set = true trong hook BOS khi tạo được lệnh mới.
bool ofBuySig  = false
bool ofSellSig = false

// [top,bot] có giao với 1 OF 4H CÙNG CHIỀU, chưa mitigated/broken hay không.
overlapsHtfOF(bool isBuy, float top, float bot) =>
    bool found = false
    if array.size(ofZone4) > 0
        for i = 0 to array.size(ofZone4) - 1
            if array.get(ofZoneIsBull4, i) == isBuy and not array.get(ofZoneMit4, i) and not array.get(ofZoneBroken4, i)
                [t, b, l] = marginZone(array.get(ofZone4, i))
                if math.min(top, t) >= math.max(bot, b)
                    found := true
    found

// POI đối diện gần nhất (OF 4H ngược chiều chưa khai thác) làm TP; na nếu không có.
opposingPOI(bool isBuy, float entry) =>
    float best = na
    if array.size(ofZone4) > 0
        for i = 0 to array.size(ofZone4) - 1
            if array.get(ofZoneIsBull4, i) != isBuy and not array.get(ofZoneMit4, i)
                [t, b, l] = marginZone(array.get(ofZone4, i))
                if isBuy and b > entry
                    best := na(best) or b < best ? b : best
                if not isBuy and t < entry
                    best := na(best) or t > best ? t : best
    best

removeTrade(int i) =>
    box.delete(array.get(tBox, i))
    box.delete(array.get(tBox2, i))
    label.delete(array.get(tLbl, i))
    array.remove(tIsBuy, i)
    array.remove(tEntry, i)
    array.remove(tSL, i)
    array.remove(tTP, i)
    array.remove(tZTop, i)
    array.remove(tZBot, i)
    array.remove(tState, i)
    array.remove(tBarIdx, i)
    array.remove(tBox, i)
    array.remove(tBox2, i)
    array.remove(tLbl, i)
    int(na)   // trả về kiểu cố định, tránh lệ thuộc kiểu trả về của array.remove

pushTrade(bool isBuy, float e, float sl, float tp, float zt, float zb) =>
    if array.size(tState) >= maxEntriesShown
        removeTrade(0)
    color dirCol = isBuy ? colorEntryBuy : colorEntrySell
    // Vị thế kiểu position tool: RISK (entry↔SL, đỏ) & REWARD (entry↔TP, xanh), dùng max/min
    // nên đúng cả long lẫn short.
    box riskBox   = box.new(bar_index, math.max(e, sl), bar_index, math.min(e, sl), xloc = xloc.bar_index, bgcolor = color.new(color.red, 85),   border_color = color.new(color.red, 55))
    box rewardBox = box.new(bar_index, math.max(e, tp), bar_index, math.min(e, tp), xloc = xloc.bar_index, bgcolor = color.new(color.green, 85), border_color = color.new(color.green, 55))
    string txt = (isBuy ? "LONG" : "SHORT") + "  E:" + str.tostring(e, format.mintick) + "  SL:" + str.tostring(sl, format.mintick) + "  TP:" + str.tostring(tp, format.mintick)
    label lb = label.new(bar_index, e, txt, xloc = xloc.bar_index, yloc = yloc.price, style = isBuy ? label.style_label_up : label.style_label_down, color = dirCol, textcolor = color.white, size = size.tiny)
    array.push(tIsBuy, isBuy)
    array.push(tEntry, e)
    array.push(tSL, sl)
    array.push(tTP, tp)
    array.push(tZTop, zt)
    array.push(tZBot, zb)
    array.push(tState, 0)
    array.push(tBarIdx, bar_index)
    array.push(tBox, riskBox)
    array.push(tBox2, rewardBox)
    array.push(tLbl, lb)

// Tạo lệnh OF NGAY tại nến CHoCH (gọi từ hook CHoCH của cấu trúc 15m native). Điều kiện:
//  - CHoCH cùng chiều xu hướng OF 4H (isBuy => isCocUp4; sell => isCocDn4).
//  - Vùng OF = chân hồi cuối trước nhịp phá CHoCH (scanLastPullback) — chính là OF 15m đảo chiều.
//  - Entry = đỉnh OF (long) / đáy OF (short) [lệnh LIMIT, giá còn phải hồi về].
//  - SL = ngay ngoài BIÊN XA của vùng OF (đáy OF cho long / đỉnh OF cho short) + đệm ATR.
//  - TP = đỉnh cũ (long) / đáy cũ (short) theo swing SMC khung hiện tại.
//  - Bỏ qua nếu R:R < entryMinRR.
// Trả về true nếu THỰC SỰ tạo lệnh (để phát alert).
// Còn lệnh CÙNG CHIỀU đang chờ khớp (state 0) hoặc đang chạy (state 1) hay không — dùng để
// KHÔNG lồng 2 lệnh long (hoặc 2 lệnh short) vào nhau. Lệnh đã kết thúc (thắng/thua/miss)
// không tính, nên sau khi lệnh cũ đóng thì lệnh mới được phép tạo bình thường.
hasOpenTrade(bool isBuy) =>
    bool found = false
    if array.size(tState) > 0
        for i = 0 to array.size(tState) - 1
            int st = array.get(tState, i)
            if array.get(tIsBuy, i) == isBuy and (st == 0 or st == 1)
                found := true
    found

createOFEntry(bool isBuy) =>
    bool created = false
    if enableOFEntry and is15m
        bool trendOK = (isBuy ? htfUp4 : htfDn4) and not hasOpenTrade(isBuy)
        if trendOK
            [pbA, pbABar, pbB, pbBBar] = scanLastPullback(isBuy, false)
            float ofTop = isBuy ? pbB : pbA
            float ofBot = isBuy ? pbA : pbB
            if not na(ofTop) and not na(ofBot) and ofTop > ofBot
                // BẮT BUỘC CÓ POI HTF: vùng OF 15m phải GIAO với một vùng OF 4H CÙNG CHIỀU còn
                // sống (chưa mitigated/broken). Tài liệu BankTrap phần 2: "CHOCH xảy ra khi giá
                // CHẠM VÀO POI CỦA HTF rồi sau đó quay đầu vượt qua đáy của PB1" — entry luôn
                // neo tại POI khung lớn, KHÔNG vào lệnh giữa trời.
                // LỖI CŨ: input entryRequireHtfPOI bật sẵn nhưng createOFEntry không đọc (chỉ
                // tryCreateEntry — hàm đã chết — mới đọc), nên bộ lọc POI mất tác dụng hoàn toàn
                // => sinh hàng loạt lệnh ngược chiều ở vùng không có POI nào (BTCUSDT 17-18/6/26).
                bool poiOK  = not entryRequireHtfPOI or overlapsHtfOF(isBuy, ofTop, ofBot)
                float entry = isBuy ? ofTop : ofBot
                float buf   = atr14 * entryBuffer
                // TP = ĐỈNH CŨ (long) / ĐÁY CŨ (short) theo cấu trúc SMC của khung hiện tại.
                // Tài liệu BankTrap: phần 10-2 tr.148 "TP đáy cũ vì đang trong xu hướng giảm";
                // phần 6 tr.53 "TP đỉnh trước".
                float tp    = isBuy ? tpSwingHigh : tpSwingLow
                // SL = NGAY NGOÀI BIÊN XA CỦA CHÍNH VÙNG OF VÀO LỆNH + đệm nhỏ.
                // Tài liệu BankTrap phần 6 tr.58: "Sell khi giá chạm vào OB, sl TRÊN OB" — kèm
                // ghi chú "với cách đặt sl này sẽ không bị sl dù sau đó giá có tăng lên rồi mới
                // giảm xuống". Tr.57: "sl đặt ở dưới nến A vì nó là nến thấp nhất của PB".
                // KHÔNG neo SL vào swing H/L nữa: vùng OF hẹp hơn nhiều nên SL cũ quá rộng,
                // bóp R:R xuống dưới ngưỡng và làm mất phần lớn lệnh hợp lệ.
                float sl    = isBuy ? ofBot - buf : ofTop + buf
                float risk  = math.abs(entry - sl)
                float rew   = math.abs(tp - entry)
                bool  ok    = not na(tp) and (isBuy ? (tp > entry and sl < entry) : (tp < entry and sl > entry))
                float rr    = risk > 0 ? rew / risk : 0
                if risk > 0 and ok and poiOK and rr >= entryMinRR
                    pushTrade(isBuy, entry, sl, tp, ofTop, ofBot)
                    created := true
    created

// Tạo setup từ vùng OF 15m [zTop,zBot]. Trả về true nếu THỰC SỰ tạo lệnh (để phát alert).
tryCreateEntry(bool isBuy, float zTop, float zBot) =>
    bool created = false
    if enableOFEntry and is15m and not na(zTop) and not na(zBot) and zTop > zBot
        bool poiOK = not entryRequireHtfPOI or overlapsHtfOF(isBuy, zTop, zBot)
        if poiOK
            float entry = isBuy ? zTop : zBot                    // biên GẦN giá của vùng OF
            float buf   = atr14 * entryBuffer
            float sl    = isBuy ? zBot - buf : zTop + buf         // SL ngoài biên XA của vùng OF
            float risk  = math.abs(entry - sl)
            float tp    = entryTPmode == "POI đối diện" ? opposingPOI(isBuy, entry) : na
            if na(tp)
                tp := isBuy ? entry + entryRR * risk : entry - entryRR * risk   // fallback R:R
            if risk > 0
                pushTrade(isBuy, entry, sl, tp, zTop, zBot)
                created := true
    created

// Lifecycle mỗi nến: khớp lệnh chờ / chốt thắng-thua / hủy lệnh miss / xoá lệnh quá 5000 nến.
processEntries() =>
    if array.size(tState) > 0
        for i = array.size(tState) - 1 to 0 by 1
            bool tooOld = bar_index - array.get(tBarIdx, i) > 5000
            if tooOld
                removeTrade(i)
            if not tooOld
                int   st    = array.get(tState, i)
                bool  isBuy = array.get(tIsBuy, i)
                float e     = array.get(tEntry, i)
                float sl    = array.get(tSL, i)
                float tp    = array.get(tTP, i)
                box   bxR   = array.get(tBox, i)
                box   bxP   = array.get(tBox2, i)
                if st == 0
                    box.set_right(bxR, bar_index)
                    box.set_right(bxP, bar_index)
                    bool fill = isBuy ? low <= e : high >= e
                    bool miss = isBuy ? high >= tp : low <= tp
                    if fill
                        array.set(tState, i, 1)
                    else if miss
                        array.set(tState, i, 4)
                        box.set_bgcolor(bxR, color.new(color.gray, 92))
                        box.set_border_color(bxR, color.new(color.gray, 75))
                        box.set_bgcolor(bxP, color.new(color.gray, 92))
                        box.set_border_color(bxP, color.new(color.gray, 75))
                else if st == 1
                    box.set_right(bxR, bar_index)
                    box.set_right(bxP, bar_index)
                    bool loss = isBuy ? low <= sl : high >= sl
                    bool win  = isBuy ? high >= tp : low <= tp
                    if loss
                        array.set(tState, i, 3)
                        box.set_bgcolor(bxR, color.new(color.red, 65))
                        box.set_border_color(bxR, color.red)
                    else if win
                        array.set(tState, i, 2)
                        box.set_bgcolor(bxP, color.new(color.green, 65))
                        box.set_border_color(bxP, color.green)
//#endregion

//#region Pullback
if high >= top and low <= bot //notrend
    if not na(mnStrc)
        prevMnStrc := mnStrc ? true : false
    top_ := prevMnStrc ? top : top_
    bot_ := prevMnStrc ? bot_ : bot
    bar_ := bar
    top  := high
    bot  := low
    bar  := time
    mnStrc := na

if high >= top and low > bot //uptrend
    if prevMnStrc and na(mnStrc)
        array.push(puHBar, bar_)
        array.push(puHigh, top_)
        array.push(puLBar, bar)
        array.push(puLow, bot)
        invalidateOFByPivot(true, top_)
        invalidateOFByPivot(false, bot)
        drawPullback(bar_, top_, true)
        drawPullback(bar, bot, false)
        addZigPoint(bar_, top_)
        addZigPoint(bar, bot)
        lastPivotHighIsHH := na(prevPivotHigh) or top_ >= prevPivotHigh
        lastPivotLowIsLL  := na(prevPivotLow) or bot <= prevPivotLow
        if showOF and (not lastPivotLowIsLL or isCocUp)
            addOFZone(bar_, top_, bot, true)
        prevPivotHigh := top_
        prevPivotLow  := bot
    else if (not prevMnStrc and na(mnStrc)) or not mnStrc
        array.push(puLBar, bar)
        array.push(puLow, bot)
        invalidateOFByPivot(false, bot)
        drawPullback(bar, bot, false)
        addZigPoint(bar, bot)
        lastPivotLowIsLL := na(prevPivotLow) or bot <= prevPivotLow
        if showOF and (not lastPivotLowIsLL or isCocUp)
            [ofTop, ofTopBar] = findPivotBefore(puHigh, puHBar, bar) //đỉnh phải có TRƯỚC đáy vừa xác nhận
            if na(ofTop)
                ofTop := top_
                ofTopBar := bar_
            addOFZone(math.min(ofTopBar, bar), ofTop, bot, true)
        prevPivotLow := bot

    top := high
    bot := low
    bar := time
    prevMnStrc := na
    mnStrc := true

if high < top and low <= bot //downtrend
    if not prevMnStrc and na(mnStrc)
        array.push(puHBar, bar)
        array.push(puHigh, top)
        array.push(puLBar, bar_)
        array.push(puLow, bot_)
        invalidateOFByPivot(true, top)
        invalidateOFByPivot(false, bot_)
        drawPullback(bar, top, true)
        drawPullback(bar_, bot_, false)
        addZigPoint(bar_, bot_)
        addZigPoint(bar, top)
        lastPivotHighIsHH := na(prevPivotHigh) or top >= prevPivotHigh
        lastPivotLowIsLL  := na(prevPivotLow) or bot_ <= prevPivotLow
        if showOF and (not lastPivotHighIsHH or isCocDn)
            addOFZone(bar_, top, bot_, false)
        prevPivotHigh := top
        prevPivotLow  := bot_
    else if (prevMnStrc and na(mnStrc)) or mnStrc
        array.push(puHBar, bar)
        array.push(puHigh, top)
        invalidateOFByPivot(true, top)
        drawPullback(bar, top, true)
        addZigPoint(bar, top)
        lastPivotHighIsHH := na(prevPivotHigh) or top >= prevPivotHigh
        if showOF and (not lastPivotHighIsHH or isCocDn)
            [ofBot, ofBotBar] = findPivotBefore(puLow, puLBar, bar) //đáy phải có TRƯỚC đỉnh vừa xác nhận
            if na(ofBot)
                ofBot := bot_
                ofBotBar := bar_
            addOFZone(math.min(ofBotBar, bar), top, ofBot, false)
        prevPivotHigh := top

    top := high
    bot := low
    bar := time
    prevMnStrc := na
    mnStrc := false

//#region update IDM
if high >= H
    H := high
    HBar := time
    L_lastHH := low
    idmLow := getNLastValue(puLow, 1)
    idmLBar := getNLastValue(puLBar, 1)

if low <= L
    L := low
    LBar := time
    H_lastLL := high
    idmHigh := getNLastValue(puHigh, 1)
    idmHBar := getNLastValue(puHBar, 1)

//#endregion

// #region structure mapping
// Check for ChoCh — đặt TRƯỚC khối IDM để tránh dùng lastH/lastL vừa bị
// khối IDM ghi đè trong cùng 1 bar (gây CHOCH bắn sai ngay sát IDM)
if not findIDM and isCocDn and high > lastH
    if structure_type == "Choch without IDM" and idmHigh == lastH and close > idmHigh
        removeIdm()
    if close > lastH
        drawStructure(CHOCH_TEXT, true) //Confirm CocUp
        addLastPullbackOF(true)
        if createOFEntry(true)   // CHoCH lên + xu hướng 4H tăng => đặt limit LONG ngay
            ofBuySig := true
        findIDM := true
        isBosUp := true
        isCocUp := true
        isBosDn := false
        isCocDn := false
        isPrevBos := false
        L_lastL := getNLastValue(arrLastL, 1)

if not findIDM and isCocUp and low < lastL
    if structure_type == "Choch without IDM" and idmLow == lastL and close < idmLow
        removeIdm()
    if close < lastL
        drawStructure(CHOCH_TEXT, false) //Confirm CocDn
        addLastPullbackOF(false)
        if createOFEntry(false)  // CHoCH xuống + xu hướng 4H giảm => đặt limit SHORT ngay
            ofSellSig := true
        findIDM := true
        isBosUp := false
        isCocUp := false
        isBosDn := true
        isCocDn := true
        isPrevBos := false
        H_lastH := getNLastValue(arrLastH, 1)

// Check for IDM
if findIDM and isCocUp
    if low < idmLow
        findIDM := false
        isBosUp := false
        L := low
        LBar := time
        if structure_type == "Choch with IDM" and idmLow == lastL
            if isPrevBos
                fixStrcAfterBos()
                lastL := getNLastValue(arrLastL, 1)
                lastLBar := getNLastValue(arrLastLBar, 1)
                lastH := H
                lastHBar := HBar
                drawIDM(true)
                lastHHmark := H   // mốc nhãn HH (dùng làm TP cho OF Entry long)
                updateLastH()
                updateLastL()
                H_lastH := getNLastValue(arrLastH, 1)
            else
                fixStrcAfterChoch()
                isCocUp := false
                isCocDn := true
        else
            lastH := H
            lastHBar := HBar
            drawIDM(true)
            lastHHmark := H   // mốc nhãn HH (dùng làm TP cho OF Entry long)
            updateLastH()
            updateLastL()
            H_lastH := getNLastValue(arrLastH, 1)


if findIDM and isCocDn and isBosDn
    if high > idmHigh
        findIDM := false
        isBosDn := false
        H := high
        HBar := time
        if structure_type == "Choch with IDM" and idmHigh == lastH
            if isPrevBos
                fixStrcAfterBos()
                lastH := getNLastValue(arrLastH, 1)
                lastHBar := getNLastValue(arrLastHBar, 1)
                lastL := L
                lastLBar := LBar
                drawIDM(false)
                lastLLmark := L   // mốc nhãn LL (dùng làm TP cho OF Entry short)
                updateLastH()
                updateLastL()
                L_lastL := getNLastValue(arrLastL, 1)
            else
                fixStrcAfterChoch()
                isCocUp := true
                isCocDn := false
        else
            lastL := L
            lastLBar := LBar
            drawIDM(false)
            lastLLmark := L   // mốc nhãn LL (dùng làm TP cho OF Entry short)
            updateLastH()
            updateLastL()
            L_lastL := getNLastValue(arrLastL, 1)


//Check for BoS
if not findIDM and not isBosUp and isCocUp
    if high > lastH
        if close > lastH
            drawStructure(BOS_TEXT, true) //Confirm BosUp
            findIDM := true
            isBosUp := true
            isCocUp := true
            isBosDn := false
            isCocDn := false
            isPrevBos := true
            // drawHL(false, 'HL')
            lastL := L
            lastLBar := LBar
            L_lastL := L

if not findIDM and not isBosDn and isCocDn
    if low < lastL
        if close < lastL
            drawStructure(BOS_TEXT, false)   //Confirm BosDn
            findIDM := true
            isBosUp := false
            isCocUp := false
            isBosDn := true
            isCocDn := true
            isPrevBos := true
            // drawHL(true, 'LH')
            lastH := H
            lastHBar := HBar
            H_lastH := H
//#endregion

//#trigger update High and Low
// Trong phase tìm IDM (findIDM=true): cả hai cập nhật để track HH/LL hiện tại
// Trong phase tìm BOS/CHOCH (findIDM=false): chỉ cập nhật chiều ngược xu hướng
//   - Bullish: lastH cố định (mức BOS), lastL bám theo swing pullback gần nhất (HL cho CHOCH)
//   - Bearish: lastL cố định (mức BOS), lastH bám theo swing pullback gần nhất (LH cho CHOCH)
// Dùng puHigh/puLow (đỉnh/đáy pullback đã xác nhận) thay vì running max/min của high/low,
// để lastH/lastL giữ cố định tại swing thực sự cho đến khi có pivot mới, tránh bị "ratchet"
// theo từng cây nến khiến CHOCH không bao giờ thoả close > lastH / close < lastL.
// Chỉ cho phép lastH dịch XUỐNG (Lower High mới thấp hơn) và lastL dịch LÊN (Higher Low mới
// cao hơn) — đúng chiều của xu hướng hiện tại — để tránh CHOCH bắn liên tục theo từng pullback
// nhỏ khi các đỉnh/đáy hồi chỉ nhích nhẹ ngược chiều xu hướng.
if findIDM
    if high > lastH
        lastH := high
        lastHBar := time
    if low < lastL
        lastL := low
        lastLBar := time
else
    if isCocUp
        float newLastL = getNLastValue(puLow, 1)
        if not na(newLastL) and newLastL > lastL
            lastL := newLastL
            lastLBar := getNLastValue(puLBar, 1)
    else if isCocDn
        float newLastH = getNLastValue(puHigh, 1)
        if not na(newLastH) and newLastH < lastH
            lastH := newLastH
            lastHBar := getNLastValue(puHBar, 1)

//#endregion

//#region OF 4H engine (bản sao độc lập, chạy trên dữ liệu 4H đã đóng nến qua request.security,
// chỉ để sinh vùng OF của khung 4H khi chart đang ở 15m — không vẽ BOS/CHoCH/IDM/zigzag)
// is15m và bộ dữ liệu 4H (f_htf/h4/l4/c4/t4/newH4bar) đã khai báo sớm ở đầu file (xem
// //Caculate) vì scanLastPullback — đứng trước engine này trong file — cần tham chiếu h4/l4/t4.

if show4hOF and is15m and newH4bar and not na(t4)
    h4barCnt += 1
    if not h4Started
        H4 := h4
        L4 := l4
        HBar4 := t4
        LBar4 := t4
        lastH4 := h4
        lastL4 := l4
        lastHBar4 := t4
        lastLBar4 := t4
        idmLow4 := l4
        idmHigh4 := h4
        idmLBar4 := t4
        idmHBar4 := t4
        top4 := h4
        bot4 := l4
        top4_ := h4
        bot4_ := l4
        bar4 := t4
        bar4_ := t4
        h4Started := true
    else
        //Pullback
        if h4 >= top4 and l4 <= bot4 //notrend
            if not na(mnStrc4)
                prevMnStrc4 := mnStrc4 ? true : false
            top4_ := prevMnStrc4 ? top4 : top4_
            bot4_ := prevMnStrc4 ? bot4_ : bot4
            bar4_ := bar4
            top4  := h4
            bot4  := l4
            bar4  := t4
            mnStrc4 := na

        if h4 >= top4 and l4 > bot4 //uptrend
            if prevMnStrc4 and na(mnStrc4)
                array.push(puHBar4, bar4_)
                array.push(puHigh4, top4_)
                array.push(puLBar4, bar4)
                array.push(puLow4, bot4)
                invalidateOFByPivot4(true, top4_)
                invalidateOFByPivot4(false, bot4)
                lastPivotHighIsHH4 := na(prevPivotHigh4) or top4_ >= prevPivotHigh4
                lastPivotLowIsLL4  := na(prevPivotLow4) or bot4 <= prevPivotLow4
                if not lastPivotLowIsLL4 or isCocUp4
                    addOFZone4(bar4_, top4_, bot4, true)
                prevPivotHigh4 := top4_
                prevPivotLow4  := bot4
            else if (not prevMnStrc4 and na(mnStrc4)) or not mnStrc4
                array.push(puLBar4, bar4)
                array.push(puLow4, bot4)
                invalidateOFByPivot4(false, bot4)
                lastPivotLowIsLL4 := na(prevPivotLow4) or bot4 <= prevPivotLow4
                if not lastPivotLowIsLL4 or isCocUp4
                    [ofTop, ofTopBar] = findPivotBefore(puHigh4, puHBar4, bar4)
                    if na(ofTop)
                        ofTop := top4_
                        ofTopBar := bar4_
                    addOFZone4(math.min(ofTopBar, bar4), ofTop, bot4, true)
                prevPivotLow4 := bot4

            top4 := h4
            bot4 := l4
            bar4 := t4
            prevMnStrc4 := na
            mnStrc4 := true

        if h4 < top4 and l4 <= bot4 //downtrend
            if not prevMnStrc4 and na(mnStrc4)
                array.push(puHBar4, bar4)
                array.push(puHigh4, top4)
                array.push(puLBar4, bar4_)
                array.push(puLow4, bot4_)
                invalidateOFByPivot4(true, top4)
                invalidateOFByPivot4(false, bot4_)
                lastPivotHighIsHH4 := na(prevPivotHigh4) or top4 >= prevPivotHigh4
                lastPivotLowIsLL4  := na(prevPivotLow4) or bot4_ <= prevPivotLow4
                if not lastPivotHighIsHH4 or isCocDn4
                    addOFZone4(bar4_, top4, bot4_, false)
                prevPivotHigh4 := top4
                prevPivotLow4  := bot4_
            else if (prevMnStrc4 and na(mnStrc4)) or mnStrc4
                array.push(puHBar4, bar4)
                array.push(puHigh4, top4)
                invalidateOFByPivot4(true, top4)
                lastPivotHighIsHH4 := na(prevPivotHigh4) or top4 >= prevPivotHigh4
                if not lastPivotHighIsHH4 or isCocDn4
                    [ofBot, ofBotBar] = findPivotBefore(puLow4, puLBar4, bar4)
                    if na(ofBot)
                        ofBot := bot4_
                        ofBotBar := bar4_
                    addOFZone4(math.min(ofBotBar, bar4), top4, ofBot, false)
                prevPivotHigh4 := top4

            top4 := h4
            bot4 := l4
            bar4 := t4
            prevMnStrc4 := na
            mnStrc4 := false

        //update IDM
        if h4 >= H4
            H4 := h4
            HBar4 := t4
            idmLow4 := getNLastValue(puLow4, 1)
            idmLBar4 := getNLastValue(puLBar4, 1)

        if l4 <= L4
            L4 := l4
            LBar4 := t4
            idmHigh4 := getNLastValue(puHigh4, 1)
            idmHBar4 := getNLastValue(puHBar4, 1)

        //structure mapping: CHoCH -> IDM -> BOS (chỉ side-effect phi-visual, không vẽ)
        if not findIDM4 and isCocDn4 and h4 > lastH4
            if c4 > lastH4 //Confirm CocUp
                addLastPullbackOF4(true)
                findIDM4 := true
                isBosUp4 := true
                isCocUp4 := true
                isBosDn4 := false
                isCocDn4 := false
                isPrevBos4 := false

        if not findIDM4 and isCocUp4 and l4 < lastL4
            if c4 < lastL4 //Confirm CocDn
                addLastPullbackOF4(false)
                findIDM4 := true
                isBosUp4 := false
                isCocUp4 := false
                isBosDn4 := true
                isCocDn4 := true
                isPrevBos4 := false

        if findIDM4 and isCocUp4
            if l4 < idmLow4
                findIDM4 := false
                isBosUp4 := false
                L4 := l4
                LBar4 := t4
                if structure_type == "Choch with IDM" and idmLow4 == lastL4
                    if isPrevBos4
                        lastL4 := getNLastValue(arrLastL4, 1)
                        lastLBar4 := getNLastValue(arrLastLBar4, 1)
                        lastH4 := H4
                        lastHBar4 := HBar4
                        array.clear(puLow4)
                        array.clear(puLBar4)
                        array.push(arrLastH4, lastH4)
                        array.push(arrLastHBar4, lastHBar4)
                        array.push(arrLastL4, lastL4)
                        array.push(arrLastLBar4, lastLBar4)
                    else
                        isCocUp4 := false
                        isCocDn4 := true
                else
                    lastH4 := H4
                    lastHBar4 := HBar4
                    array.clear(puLow4)
                    array.clear(puLBar4)
                    array.push(arrLastH4, lastH4)
                    array.push(arrLastHBar4, lastHBar4)
                    array.push(arrLastL4, lastL4)
                    array.push(arrLastLBar4, lastLBar4)

        if findIDM4 and isCocDn4 and isBosDn4
            if h4 > idmHigh4
                findIDM4 := false
                isBosDn4 := false
                H4 := h4
                HBar4 := t4
                if structure_type == "Choch with IDM" and idmHigh4 == lastH4
                    if isPrevBos4
                        lastH4 := getNLastValue(arrLastH4, 1)
                        lastHBar4 := getNLastValue(arrLastHBar4, 1)
                        lastL4 := L4
                        lastLBar4 := LBar4
                        array.clear(puHigh4)
                        array.clear(puHBar4)
                        array.push(arrLastH4, lastH4)
                        array.push(arrLastHBar4, lastHBar4)
                        array.push(arrLastL4, lastL4)
                        array.push(arrLastLBar4, lastLBar4)
                    else
                        isCocUp4 := true
                        isCocDn4 := false
                else
                    lastL4 := L4
                    lastLBar4 := LBar4
                    array.clear(puHigh4)
                    array.clear(puHBar4)
                    array.push(arrLastH4, lastH4)
                    array.push(arrLastHBar4, lastHBar4)
                    array.push(arrLastL4, lastL4)
                    array.push(arrLastLBar4, lastLBar4)

        //Check for BoS
        if not findIDM4 and not isBosUp4 and isCocUp4
            if h4 > lastH4
                if c4 > lastH4 //Confirm BosUp
                    findIDM4 := true
                    isBosUp4 := true
                    isCocUp4 := true
                    isBosDn4 := false
                    isCocDn4 := false
                    isPrevBos4 := true
                    lastL4 := L4
                    lastLBar4 := LBar4

        if not findIDM4 and not isBosDn4 and isCocDn4
            if l4 < lastL4
                if c4 < lastL4 //Confirm BosDn
                    findIDM4 := true
                    isBosUp4 := false
                    isCocUp4 := false
                    isBosDn4 := true
                    isCocDn4 := true
                    isPrevBos4 := true
                    lastH4 := H4
                    lastHBar4 := HBar4

        //trigger update High/Low
        if findIDM4
            if h4 > lastH4
                lastH4 := h4
                lastHBar4 := t4
            if l4 < lastL4
                lastL4 := l4
                lastLBar4 := t4
        else
            if isCocUp4
                float newLastL4 = getNLastValue(puLow4, 1)
                if not na(newLastL4) and newLastL4 > lastL4
                    lastL4 := newLastL4
                    lastLBar4 := getNLastValue(puLBar4, 1)
            else if isCocDn4
                float newLastH4 = getNLastValue(puHigh4, 1)
                if not na(newLastH4) and newLastH4 < lastH4
                    lastH4 := newLastH4
                    lastHBar4 := getNLastValue(puHBar4, 1)

        //lifecycle vùng OF 4H — xét theo chính nến 4H vừa đóng
        lifecycleOFZones4(o4, h4, l4, c4)
//#endregion


if showPOI
    if not isSweepOBS
        high_MOBS := high[3]
        low_MOBS := low[3]
