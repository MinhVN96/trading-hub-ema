// Tìm pivot CỰC TRỊ (thấp nhất/cao nhất) trong số các pivot hình thành TỪ mốc sinceBar trở đi
// (theo bar time). Dùng để neo đúng CHÂN HỒI cuối cùng trước khi CHOCH xác nhận: nếu giữa
// pivot đối diện (sinceBar) và lúc CHOCH xác nhận có nhiều pivot hồi phụ (các nhịp bật nhẹ),
// tất cả đều thuộc CÙNG một chân hồi — phải lấy đúng điểm cực trị của cả chân đó làm đáy/đỉnh
// vùng OF, không phải chỉ pivot được đẩy vào mảng SAU CÙNG (có thể là 1 nhịp bật nhỏ, không
// phải điểm đảo chiều thật). Mảng luôn tăng dần theo bar time nên có thể break sớm khi gặp
// pivot cũ hơn sinceBar.
findExtremeSince(arrVal, arrBar, int sinceBar, bool findMin) =>
    float v = na
    int b = na
    if array.size(arrVal) > 0
        for i = array.size(arrVal) - 1 to 0 by 1
            if array.get(arrBar, i) < sinceBar
                break
            float cur = array.get(arrVal, i)
            if na(v) or (findMin and cur < v) or (not findMin and cur > v)
                v := cur
                b := array.get(arrBar, i)
    [v, b]

// Quét NẾN THÔ lùi từ nến hiện tại (nến vừa xác nhận CHOCH) để tìm CHÂN HỒI CUỐI ngay trước
// nhịp đẩy phá cấu trúc — KHÔNG phụ thuộc pivot của engine pullback. Lý do phải quét thô:
// engine pullback (//#region Pullback) chỉ ghi pivot khi có nến phá high/low của nến đã xử lý
// trước đó trong leg; một cú hồi nằm GỌN TRONG BIÊN của một nến lớn trước nó (không thủng
// low, không vượt high nến đó) không rơi vào nhánh nào cả -> không sinh pivot, zigzag không
// có đỉnh/đáy tại đó, và mọi cách neo OF theo puHigh/puLow đều vô vọng (case BTCUSDT 4H đầu
// tháng 7: nến 2/7 biên độ ~58.9k-61k rất lớn, cú hồi 61k->59.9k ngay sau nằm gọn bên trong
// nên hoàn toàn vô hình với engine).
//   pha 0: lùi dần, gom CỰC TRỊ của chân đẩy phá cấu trúc (min low nếu bull / max high nếu
//     bear) = điểm NEO của vùng OF; chuyển pha khi gặp nến (cũ hơn) không còn mở rộng cực trị.
//   pha 1: tiếp tục lùi, gom cực trị ĐỐI DIỆN (đỉnh chân hồi nếu bull / đáy nếu bear); dừng
//     tại đỉnh/đáy cục bộ đầu tiên (nến cũ hơn không còn mở rộng) hoặc khi lùi tới nến thuộc
//     chân trước đó (vượt qua điểm neo). Nến vượt neo vẫn được lấy high/low nếu đang mở rộng
//     — xử lý nến engulfing lớn chứa cả đỉnh chân hồi lẫn phần chân cũ.
// use4h = true: quét trên chuỗi 4H (h4/l4/t4, khai báo ở //Caculate) — dùng cho engine OF 4H;
// giá trị 4H lặp lại trên nhiều nến chart nhưng logic so sánh >=/<= tự dung hoà các lần lặp.
// Trả về [neo, barNeo, đốiDiện, barĐốiDiện] (bull: neo = đáy vùng; bear: neo = đỉnh vùng).
scanLastPullback(bool isBull, bool use4h) =>
    float pbA = na
    int   pbABar = na
    float pbB = na
    int   pbBBar = na
    int   phase = 0
    // Bound 2000 (không phải 4500): chân hồi luôn ngắn hơn nhiều; hơn nữa truy cập offset lớn
    // trên chuỗi request.security (h4/l4/t4) dễ vượt buffer lịch sử -> RE10045.
    for j = 0 to 2000
        if j >= bar_index
            break
        // KHÔNG dùng toán tử ba ngôi cho h4[j]/high[j]: Pine đánh giá CẢ HAI nhánh (eager) nên
        // h4[j] bị truy chọc ngay cả khi use4h=false, gây RE10045 trên chart 4H (h4 là chuỗi
        // request.security, không đủ history ở offset lớn). Tách if/else để chỉ đụng chuỗi cần.
        float hi = na
        float lo = na
        int   tj = na
        if use4h
            hi := h4[j]
            lo := l4[j]
            tj := t4[j]
        else
            hi := high[j]
            lo := low[j]
            tj := time[j]
        if na(hi) or na(lo)
            break
        if phase == 0
            if na(pbA) or (isBull ? lo <= pbA : hi >= pbA)
                pbA := isBull ? lo : hi
                pbABar := tj
            else
                phase := 1
                pbB := isBull ? hi : lo
                pbBBar := tj
        else
            bool ext = isBull ? hi >= pbB : lo <= pbB
            if ext
                pbB := isBull ? hi : lo
                pbBBar := tj
            if (isBull ? lo < pbA : hi > pbA) or not ext
                break
    [pbA, pbABar, pbB, pbBBar]

// NEO "OB CỰC TRỊ" — dùng cho vùng OF sinh ra tại CHoCH (xem addLastPullbackOF).
// Vùng OF = CỤM NẾN NGƯỢC CHIỀU CUỐI CÙNG ngay tại đỉnh/đáy khởi phát nhịp đẩy phá cấu trúc:
// CHoCH giảm => cụm nến TĂNG cuối cùng trước khi giá đổ; CHoCH tăng => cụm nến GIẢM cuối cùng
// trước khi giá bật. Đây chính là chỗ tổ chức đảo hàng (order block kinh điển) — vùng NHỎ, nằm
// ngay cực trị của nhịp tạo CHoCH.
// LÝ DO KHÔNG DÙNG scanLastPullback Ở CHoCH NỮA: hàm đó lấy TRỌN chân hồi (từ cực trị nhịp đẩy
// xuống tới đáy/đỉnh của cả chân hồi trước đó). Khi thị trường ĐI NGANG, chân hồi trải đúng
// bằng biên độ sideway => vùng OF phình ra trùm cả cái range, vừa vô dụng để vào lệnh vừa nuốt
// hết các vùng nhỏ sát giá sinh ra sau nó.
// Trả về [top, bot, barTime]; na nếu không tìm được cụm nến ngược chiều (caller tự fallback).
scanExtremeOF(bool isBull, bool use4h) =>
    float ext  = na   // cực trị khởi phát nhịp đẩy: bear = high cao nhất, bull = low thấp nhất
    int   extJ = na
    // Pha 1: lùi từ nến vừa xác nhận CHoCH về GỐC nhịp đẩy — dừng ở nến (cũ hơn) đầu tiên không
    // còn mở rộng cực trị. Cùng cách với pha 0 của scanLastPullback.
    for j = 0 to 500
        if j >= bar_index
            break
        float hi = na
        float lo = na
        if use4h
            hi := h4[j]
            lo := l4[j]
        else
            hi := high[j]
            lo := low[j]
        if na(hi) or na(lo)
            break
        if na(ext) or (isBull ? lo <= ext : hi >= ext)
            ext  := isBull ? lo : hi
            extJ := j
        else
            break
    float zTop = na
    float zBot = na
    int   zBar = na
    if not na(extJ)
        // Pha 2: lùi dần từ nến cực trị, gom CỤM NẾN NGƯỢC CHIỀU liền kề (tối đa 5) làm vùng OB.
        // Nến cực trị thường chính là nến đảo chiều (nến giảm tạo đỉnh) nên cho phép lùi tối đa
        // 3 nến để gặp nến ngược chiều đầu tiên; quá đó coi như không có OB rõ ràng => trả na.
        // LỌC NẾN TRÙNG (prevT): khi use4h, một nến 4H lặp lại trên ~16 nến chart (giá trị
        // request.security giữ nguyên) — không lọc thì "cụm 5 nến" thực chất chỉ là 1 nến 4H.
        int   nBar  = 0    // số nến THẬT đã xét kể từ nến cực trị
        int   nOpp  = 0    // số nến ngược chiều đã gom
        int   prevT = na
        float cTop  = na
        float cBot  = na
        int   cBar  = na
        for m = 0 to 500
            int k = extJ + m
            if k >= bar_index or nBar > 7 or nOpp >= 5
                break
            float hi = na
            float lo = na
            float op = na
            float cl = na
            int   tj = na
            if use4h
                hi := h4[k]
                lo := l4[k]
                op := o4[k]
                cl := c4[k]
                tj := t4[k]
            else
                hi := high[k]
                lo := low[k]
                op := open[k]
                cl := close[k]
                tj := time[k]
            if na(hi) or na(lo) or na(op) or na(cl) or na(tj)
                break
            if not na(prevT) and tj == prevT
                continue                      // vẫn là nến cũ lặp lại (chỉ xảy ra khi use4h)
            prevT := tj
            nBar += 1
            if isBull ? cl < op : cl > op
                nOpp += 1
                cTop := na(cTop) ? hi : math.max(cTop, hi)
                cBot := na(cBot) ? lo : math.min(cBot, lo)
                cBar := tj
            else if nOpp > 0
                break                         // đã gom xong cụm, gặp nến cùng chiều => dừng
            else if nBar > 3
                break                         // lùi quá xa vẫn chưa có nến ngược chiều => bỏ
        if not na(cTop) and not na(cBot)
            // Biên XA của vùng neo tại CHÍNH CỰC TRỊ (đỉnh/đáy vừa bị từ chối) — kể cả khi cực
            // trị nằm ở cây nến đảo chiều không thuộc cụm OB — để SL luôn nằm ngoài cây nến quét
            // thanh khoản. Biên GẦN giá lấy theo cụm OB.
            zTop := isBull ? cTop : math.max(ext, cTop)
            zBot := isBull ? math.min(ext, cBot) : cBot
            zBar := cBar
    [zTop, zBot, zBar]

// Bias cấu trúc theo THUẬT TOÁN SWING CỦA SMC (leg dựa ta.highest/ta.lowest N nến, crossover/
// crossunder xác nhận CHoCH/BOS) — self-contained để gọi qua request.security trên 4H.
// +1 = tăng, -1 = giảm, 0 = chưa xác định. Dùng làm bộ lọc chiều 4H cho OF Entry.
//
// Trả về [biasV, trendV, shLevel, slLevel] — 2 mốc xác nhận + 2 MỨC swing 4H hiện hành (để vẽ
// lên chart 15m, xem đúng cái mà bộ lọc đang nhìn thay vì phải đoán).
// Hai mốc xác nhận khác nhau, người dùng chọn bằng entryTrend4hConfirm:
//   trendV = hướng cấu trúc THÔ, lật ở MỌI lần phá (kể cả CHoCH) — đảo chiều SỚM.
//   biasV  = chỉ đổi khi có **BOS** (phá CÙNG chiều trendV) — chặt hơn, loại CHoCH fake.
//     * phá ngược trendV  => CHoCH  => chỉ lật trendV, GIỮ NGUYÊN biasV.
//     * phá cùng trendV   => BOS    => xác nhận => set biasV.
f_smcSwingBias(int legLen) =>
    var int   biasV     = 0   // xu hướng ĐÃ XÁC NHẬN (CHoCH + BOS)
    var int   trendV    = 0   // hướng cấu trúc thô, lật ở mỗi lần phá
    var float shLevel   = na
    var float slLevel   = na
    var bool  shCrossed = na
    var bool  slCrossed = na
    var int   legV      = 0
    bool nlh = high[legLen] > ta.highest(legLen)
    bool nll = low[legLen]  < ta.lowest(legLen)
    legV := nlh ? 0 : nll ? 1 : legV
    int chg = ta.change(legV)
    if chg == -1
        shLevel   := high[legLen]
        shCrossed := false
    if chg == 1
        slLevel   := low[legLen]
        slCrossed := false
    if not na(shLevel) and not na(shCrossed) and not shCrossed and ta.crossover(close, shLevel)
        shCrossed := true
        bool isBosUpV = trendV == 1   // đang tăng sẵn => lần phá này là BOS lên (xác nhận)
        trendV := 1
        if isBosUpV
            biasV := 1
    if not na(slLevel) and not na(slCrossed) and not slCrossed and ta.crossunder(close, slLevel)
        slCrossed := true
        bool isBosDnV = trendV == -1  // đang giảm sẵn => lần phá này là BOS xuống (xác nhận)
        trendV := -1
        if isBosDnV
            biasV := -1
    [biasV, trendV, shLevel, slLevel]

