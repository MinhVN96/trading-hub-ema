//@version=5
// Trading Hub 3 v1.1 — BIẾN THỂ LUXALGO
// Engine cấu trúc (CHoCH / BOS) thay hoàn toàn bằng
// "Market Structure with Inducements & Sweeps [LuxAlgo]" (CC BY-NC-SA 4.0).
// IDM KHÔNG lấy của LuxAlgo mà theo BankTrap (pullback đầu tiên sau BOS).
// Các module POI / Order Block / SCOB / Inside Bar / Pullback giữ nguyên của Trading Hub 3.
// Xem Yeu_cau_bo_sung_SMC_LuxAlgo.md — mục #L1, #L2.
indicator("Trading_Hub_3_v1.1_LuxAlgo", "Trading_Hub_3_v1.1_LuxAlgo", true, max_bars_back = 5000, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

//drawing options
showPOI = input.bool(true, "Show POI", group="POI settings")
poi_type = input.string ("---",title='POI type', group="POI settings", options=["---", "Mother Bar"])
mergeRatio = input.float(defval=0, minval=0, maxval=0.5, step=0.02, title="Merge Ratio", group="POI settings" )
maxBarHistory = input.int(2000, title="Max IPA age", group="POI settings")
maxPOIShow = input.int(5, "So POI CON SONG toi da moi chieu", minval = 1, maxval = 50, group = "POI settings",
     tooltip = "Vung chua bi cham (con keo dai sang phai). Dem RIENG voi vung xam. Vuot nguong thi xoa vung CU NHAT cua chinh nhom do.")
maxPOIMit  = input.int(5, "So POI XAM toi da moi chieu", minval = 0, maxval = 50, group = "POI settings",
     tooltip = "Vung da mitigated (gia da cham vao). De 0 = don sach vung xam ngay khi vua bi cham.")

// #L2 — hai tham số này là bản chất của engine fractal LuxAlgo, không phải lựa chọn thiết kế.
// Mốc CHoCH chỉ được xác nhận SAU chochLen nến.
//
// Giá trị lấy theo kết luận đã có trong "Trading Hub 3 - EMA_v1" (dòng 80-84, 2542):
//   50 là mặc định LuxAlgo cho CHÍNH khung đang xem. Trên 15m, 50 nến ~ 12,5h => hợp lý.
//   Ép nguyên 50 lên 4H thì thành ~8,3 NGÀY — thô gấp 16 lần, cấu trúc gần như không đổi
//   chiều (đo thực tế BTCUSDT: cả tháng chỉ 1 sự kiện). 4H nên ~1,5-2,5 ngày => leg 10-15.
chochLen15 = input.int(50, "CHoCH Period (khung ≠ 4H)", minval = 5, group = "Structure",
     tooltip = "Mặc định LuxAlgo cho khung đang xem. Trên 15m ~ 12,5 giờ.")
chochLen4h = input.int(15, "CHoCH Period (khung 4H)"  , minval = 5, group = "Structure",
     tooltip = "Riêng 4H phải nhỏ hơn, nếu không cấu trúc gần như không đổi chiều. 15 nến 4H ~ 2,5 ngày.")
// KHÔNG còn tham số riêng cho BOS: BOS dùng chung mốc swing với CHoCH (công thức SMC chuẩn),
// nên chochLen điều khiển cả hai. IDM cũng không có tham số — nó lấy từ engine pullback.

// tự chọn theo khung đang xem — cùng cơ chế với smcSwingLenUsed của bản EMA_v1
int chochLen = timeframe.period == "240" ? chochLen4h : chochLen15

showChoCh = input.bool(true, "Show CHoCH", group = "Structure")
showBOS = input.bool(true, "Show B O S", group = "Structure")
showIDM = input.bool(true,"Show IDM", group = "Structure")
showSwings = input.bool(true, "Mark Swing points", inline = "sw", group = "Structure")
swingSize  = input.string(size.small, "Cỡ", inline = "sw", group = "Structure",
     options = [size.tiny, size.small, size.normal, size.large],
     tooltip = "Một cỡ duy nhất: hộp tự co giãn vừa khít chữ nên không còn lo chữ tràn viền.")
swingTransp = input.int(60, "Mờ", inline = "sw", minval = 0, maxval = 100, group = "Structure",
     tooltip = "Độ mờ của hình: 0 = đặc, 100 = trong suốt hẳn.")
swingShowTx = input.bool(true, "Hiện chữ HH/HL/LH/LL", inline = "sw2", group = "Structure")
swingShowBg = input.bool(true, "Hiện hình", inline = "sw2", group = "Structure",
     tooltip = "Tắt hình -> chỉ còn chữ trơn. Tắt chữ -> chỉ còn ô vuông đánh dấu.")
swingOfs   = input.float(0.8, "Đẩy chấm swing xa nến (x ATR14)", minval = 0, step = 0.1, group = "Structure",
     tooltip = "0 = nằm đúng tại đỉnh/đáy. Tăng lên để chấm lùi ra xa nến, dễ nhìn hơn.")
showLive = input.bool(true, "Show live levels", inline = "live", group = "Structure")
liveLen = input.int(15, title="Dài", inline = "live", group = "Structure")

showMn = input.bool(false, "Show pullback", group = "Structure")
maxPbHistory = input.int(500, "Max pullback history", minval = 50, group = "Structure")
showSCOB = input.bool(true, "Show SCOB", group = "Structure")

// ===== ORDER FLOW — BankTrap Phan 4, trang 26-36 =====
// "Order flow la chuyen dong hoi CUOI CUNG truoc khi tiep dien xu huong."
// Ghi chu cua tai lieu: "IMB KHONG tham gia vao viec hinh thanh OF"  -> khac han OB/POI.
// Vung OF = TRON CHAN HOI (2 pivot lien tiep cua engine pullback), khong phai 1 cay nen.
//
// TRIET LY: TAO THOANG, XOA CHAT. Khong co gang doan chieu dung luc tao vung — mot OF-S
// van co the moc trong nhip tang va van dung, chung nao gia CHUA dong nen vuot qua DINH
// vung. Ba tang tu loc:
//   1) xac nhan  : phai dong nen vuot bien XA (dinh voi OF-D, day voi OF-S)
//   2) huy       : neu pha NHAM bien truoc thi ung vien bi bo (luat "OF khong hop le")
//   3) xoa       : dong nen vuot bien GIU thi vung het hieu luc — ke ca vung da xam
showOF        = input.bool(true, "Show OF", group = "Order Flow")
ofConfirmBars = input.int(30, "OF phai xac nhan trong vong (nen)", minval = 1, group = "Order Flow",
     tooltip = "DIEU KIEN #1 cua tai lieu: gia phai PHA KHOI dinh OF (bullish) / day OF (bearish). "
             + "Chua pha thi CHUA phai OF -> khong ve. Qua so nen nay ma chua pha => huy ung vien. "
             + "Vung OF o day = TRON chan hoi, nen gia phai chay het ca mot nhip moi cham duoc bien xa "
             + "=> cua so phai rong. GIAM xuong neu muon it OF va chat hon; TANG len neu OF ra qua thua.")
maxOFShow     = input.int(5, "So OF CON SONG hien thi moi chieu", minval = 1, maxval = 50, group = "Order Flow",
     tooltip = "So vung chua bi khai thac duoc HIEN THI moi chieu = 5 vung GAN GIA HIEN TAI NHAT. Dem RIENG voi nhom xam. Vung qua nguong chi bi AN, KHONG bi xoa — khi cac vung gan hon chet di thi no tu dong hien lai.")
maxOFMit      = input.int(10, "So OF XAM hien thi moi chieu", minval = 0, maxval = 50, group = "Order Flow",
     tooltip = "Nhu tren nhung cho vung DA bi khai thac (mau xam). Cung chi AN chu khong xoa. "
             + "DE 0 = dung DUNG chu tai lieu: BankTrap trang 35 noi 'khi gia da ve day roi cac OF o ben tren "
             + "khong can phai de y nua vi da bi khai thac het' — vung xam la vung da tieu, het gia tri giao dich. "
             + "De 10 (mac dinh) la giu chung lai lam BOI CANH doc chart chu khong phai de vao lenh. "
             + "Truoc day mac dinh 5 va do la so qua chat: chi can 6 vung xam cung chieu la vung thu sau bi "
             + "day ra khoi chart ma khong co dau vet nao ngoai dau `!` tren nhan.")
ofInvalidPivot = input.bool(false, "Xoa OF khi pivot moi vuot qua vung", group = "Order Flow",
     tooltip = "KHONG co trong tai lieu BankTrap — bo loc them, muon cua EMA_v1: khi mot pivot moi "
             + "xac nhan vuot qua bien giu cua vung thi coi nhu cau truc da phu nhan vung do. "
             + "Engine pullback chay o do phan giai 1 NEN nen pivot sinh ra rat day => bat cai nay "
             + "se don sach gan het vung OF. Mac dinh TAT. Bat len neu thay OF cu ton tai qua lau.")
ofOnlyRetrace = input.bool(false, "Chi tao OF tai chan HOI (loc HL/LH)", group = "Order Flow",
     tooltip = "TAT (mac dinh): tao OF o moi chan pullback, khong quan tam chieu. OF sai chieu se tu bi loai — hoac bi huy luc xac nhan (pha nham bien truoc), hoac bi XOA khi gia dong nen vuot qua bien giu. BAT: chi tao OF-D tai day HL va OF-S tai dinh LH, tuc chi tai chan hoi that su. It vung hon nhung co the bo sot OF hop le trong nhung nhip quet day/dinh.")
ofMinLeg      = input.float(0.0, "Do cao toi thieu cua chan hoi (x ATR14)", minval = 0, step = 0.1, group = "Order Flow",
     tooltip = "Chan hoi phai cao it nhat bang ngan nay lan ATR14 thi moi duoc coi la mot NHIP. "
             + "Engine pullback chay o do phan giai 1 NEN nen no coi moi cai ngoay 2-3 nen la mot chan hoi: "
             + "do thuc te tren BTCUSDT 4H la 778 ung vien cho ~1100 nen, gan mot ung vien moi nen. "
             + "Voi mat do do thi vung OF chi con la nhieu — vung nao cung ti hon, song vai nen roi bi rau nen "
             + "quet mat, va con NUOT ca nhung vung to hop le qua luat long nhau. "
             + "Tai lieu dinh nghia OF la 'nhip hoi CUOI CUNG truoc khi tiep dien' => phai co kich thuoc cua mot NHIP. "
             + "MAC DINH 0 = TAT, chi chay dung luat cua tai lieu. Luat tuoi (long nhau -> vung gia chet) "
             + "da tu don phan lon vung vun roi. Bat len neu van thay OF qua day.")
ofShrinkEdge  = input.float(0.35, "Thu hep: ban hep phai nam trong X phan cuc tri cua ban rong", minval = 0, maxval = 1, step = 0.05, group = "Order Flow",
     tooltip = "LUAT THU HEP (BankTrap trang 26 hinh c->b, trang 27 muc 2, trang 29). "
             + "Trang 27: 'OF nam o PULLBACK NHO CUOI CUNG cua pullback lon — mot chuyen dong hoi co the "
             + "lien tuc tao nhieu dinh moi => nhieu pullback hoi nho cho den khi gia pha qua day cu hoi "
             + "cuoi cung thi OF hop le moi duoc hinh thanh'. "
             + "Trong mot nhip hoi XUONG (OF-D), chan hoi nho CUOI CUNG la chan nam DUOI CUNG. Doi xung: "
             + "trong nhip hoi LEN (OF-S) thi la chan TREN CUNG. "
             + "So o day = ban hep phai nam trong bao nhieu phan chieu cao cua ban rong, tinh tu bien CUC TRI. "
             + "0.35 = day ban hep phai nam trong 35% duoi cung cua vung rong (voi OF-D). "
             + "Thoa thi ban hep duoc ve VA ban rong bi don di, de lai bia mo do  D!W . "
             + "DE 0 = TAT luat nay: ban hep se bi coi la 'nam trong OF truoc' va bi loai nhu cu. "
             + "TANG len 1 = moi ung vien nam trong deu duoc coi la ban thu hep => vung rong gan nhu "
             + "khong bao gio song sot.")
ofSweepClose  = input.bool(false, "Quet bien giu: doi DONG NEN (thay vi rau)", group = "Order Flow",
     tooltip = "BIEN GIU = day vung voi OF-D, dinh vung voi OF-S. Vuot qua no la vung het hieu luc. "
             + "Cau hoi o day: vuot bang gi moi tinh. "
             + "TAT (mac dinh): chi can mot cai RAU xuyen qua la xoa. Luat nay copy nguyen tu module POI "
             + "cua Trading Hub 3 va no rat nghiem — trong vung di ngang hoac leo doc, OF chet gan het "
             + "vi rau, de lai mot bai bia mo do  S!Q . "
             + "BAT: phai co gia DONG CUA vuot qua bien giu moi xoa. Rau quet qua thi vung van song. "
             + "Doi xung voi dieu kien #1 (xac nhan cung doi dong nen), va la cach de giu lai nhung vung "
             + "chi bi quet thanh khoan roi gia tra ve ngay. "
             + "O nay dieu khien CA BA cho mot luc, neu khong chung se mau thuan nhau: "
             + "(1) xoa vung da ve · (2) huy UNG VIEN pha nham (ma P) · (3) ca hai thu do ben engine khung lon. "
             + "Khong the de mot cay nen vua du suc giet vung cu vua cho phep sinh vung moi.")
ofLabelOn     = input.bool(true, "Nhan OF", inline = "oflbl", group = "Order Flow")
ofLblSize     = input.string(size.tiny, "Co chu", inline = "oflbl", group = "Order Flow",
     options = [size.auto, size.tiny, size.small, size.normal],
     tooltip = "Co chu cua nhan OF-D / OF-S kem tuoi. "
             + "size.auto = de TradingView tu chon co theo be rong khung nhin — day la lua chon DUY NHAT "
             + "co phan ung khi phong to / thu nho chart. Ba co con lai co DINH tinh bang PIXEL: chu giu "
             + "nguyen kich thuoc man hinh du zoom the nao. "
             + "Pine khong cho neo chu theo don vi GIA/THOI GIAN nhu cai hop OF, nen chu khong the co gian "
             + "dong bo voi vung duoc.")
colorOFBull   = input.color(color.rgb(41, 98, 255, 78),  "OF Demand", group = "Order Flow")
colorOFBear   = input.color(color.rgb(233, 30, 99, 78),  "OF Supply", group = "Order Flow")

// ===== OF KHUNG LON VE LEN KHUNG DANG XEM =================================
htfOFOn  = input.bool(true, "Ve OF cua khung LON len khung dang xem", group = "OF khung lon",
     tooltip = "Ve cac vung OF cua mot khung lon hon (mac dinh 4H) de len chart dang xem (vi du 15m), "
             + "dung lam POI khung lon khi vao lenh o khung nho. "
             + "CHI VE VUNG CHUA BI KHAI THAC — vung nao da co mot cay nen khung lon DONG CUA hoac "
             + "MO CUA nam trong no thi bi xoa khoi chart luon, khong hien xam. "
             + "Tu dong TAT khi khung dang xem bang hoac lon hon khung da chon (tranh ve trung len chinh no). "
             + "LUU Y KY THUAT: Pine khong cho mang / hop ve di qua request.security, nen o day chay "
             + "MOT ENGINE OF THU HAI ngay trong script, nuoi bang nen cua khung lon lay ve. Do la ban "
             + "SAO cua engine chinh, khong phai chinh no — neu sau nay sua luat OF thi phai sua ca hai cho. "
             + "Tim chu HTF trong code la ra het.")
htfOFTf  = input.timeframe("240", "  Khung lon lay OF", group = "OF khung lon")
htfOFTr  = input.int(88, "  Do mo cua vung khung lon", minval = 0, maxval = 100, group = "OF khung lon",
     tooltip = "0 = dac · 100 = trong suot. De cao hon vung cua khung dang xem cho de phan biet. "
             + "Vien cua vung khung lon la net DUT, cung de phan biet.")
htfColD  = input.color(#00C853, "  Mau OF-D khung lon", inline = "htfc", group = "OF khung lon")
htfColS  = input.color(#FFD600, "  Mau OF-S khung lon", inline = "htfc", group = "OF khung lon",
     tooltip = "Mau RIENG cho vung khung lon, khong dung chung voi mau OF cua khung dang xem — "
             + "de nhin mot cai la biet ngay vung nao thuoc khung nao. Xanh la = Demand, vang = Supply.")
htfOFMax = input.int(3, "  So vung khung lon hien thi moi chieu", minval = 1, maxval = 20, group = "OF khung lon",
     tooltip = "HAN NGACH HIEN THI, giong `So OF CON SONG hien thi moi chieu` cua engine chinh. "
             + "Thieu no chinh la cho engine khung lon ve NHIEU vung hon han so voi khi ban mo "
             + "thang chart 4H: ben 4H chi hien top 5 gan gia nhat, con ben nay truoc day ve HET, "
             + "ke ca nhung vung rat cu con sot lai tu dau chart. "
             + "POI khung lon von chi can vai cai gan gia nhat nen mac dinh de 3. "
             + "Vung qua nguong chi bi AN chu KHONG xoa — vung gan hon chet di thi no hien lai.")

bull = input.color(color.green, "Bullish", group = "Structure | Color")
bear = input.color(color.red , "Bearish", group = "Structure | Color")
scobUp = input.color(#0b3ff9   , "Bullish SCOB", group = "Structure | Color")
scobDn = input.color(#da781d, "Bearish SCOB", group = "Structure | Color")
colorIDM = input.color(color.gray, "IDM", group = "Structure | Color")
colorSwingTx = input.color(color.white, "Chữ HH/HL/LH/LL", group = "Structure | Color")
colorDemand = input.color(color.rgb(47, 130, 96, 80), 'Demand', group = "Structure | Color")
colorSupply = input.color(color.rgb(205, 92, 72, 80), 'Supply', group = "Structure | Color")
colorMitigated = input.color(color.rgb(192, 192, 192, 80), 'Mitigated', group = "Structure | Color")

// ===== DEBUG — mac dinh TAT het. Chi bat khi can truy vet vung OF bi thieu. =====
ofDbgCand     = input.bool(false, "DEBUG - Bia mo vung OF bi loai / bi xoa", group = "Debug",
     tooltip = "Moi ung vien KHONG duoc ve se de lai mot nhan cam ngay tai MEP TRAI dang le cua no "
             + "— dat tai BIEN GIU cua no (OF-D: day vung, OF-S: dinh vung). "
             + "Dang nhan:  D P2 >61130  =  chieu Demand, chet vi ly do P o nen thu 2, bien XA la 61130. "
             + "PHAI doc chieu D/S thi moi luan duoc: cung mot muc gia co the la DAY cua mot OF-D "
             + "hoac DINH cua mot OF-S. Ly do:  "
             + "P = rau xuyen bien giu truoc khi kip xac nhan (dem nguoc tung ay nen tu mui ten se thay cay nen thu pham). "
             + "H = het han qua so nen cho phep. "
             + "N = nam TRON trong mot OF cung chieu da hoan tat nhip tiep dien tu truoc (dieu kien #2). "
             + "T = chinh no la BAN VE RONG cua mot nhip hoi da co ban hep hon (luat thu hep c->b, trang 26/27/29). "
             + "Con bia mo DO  D!W  la vung RONG vua bi mot ban HEP tai cuc tri thay the — do chinh la "
             + "luat thu hep chay theo chieu nguoc, va la cho de tra loi 'vi sao vung rong bien mat'. "
             + "Ngoai ra co bia mo MAU DO cho vung DA VE roi moi bi xoa, dang  D!Q :  "
             + "Q = bi quet (rau xuyen bien giu) · K = bi han ngach cung · V = pivot moi phu nhan. "
             + "Sau khi bo khoi (A2b), MOI ca vung bien mat deu de lai bia mo — khong con thu gi "
             + "am tham giau vung di nua. Bat cai nay roi zoom vao cho hop bi thieu la biet ngay "
             + "no chet o khau nao.")
ofDbgSide     = input.string("D + S", "  Chi hien chieu", inline = "dbgf", group = "Debug",
     options = ["D + S", "Chi D", "Chi S"])
ofDbgWhy      = input.string("Tat ca", "  ly do", inline = "dbgf", group = "Debug",
     options = ["Tat ca", "P - pha nham", "N - trong OF truoc", "T - ban rong", "W - nhuong ban hep", "H - het han", "Q - bi quet", "K - han ngach", "V - pivot"],
     tooltip = "TradingView chi cho toi da 500 NHAN cho ca indicator, va do la kho DUNG CHUNG: "
             + "cham swing HH/HL/LH/LL, nhan CHoCH/BOS, nhan IDM, mui ten pullback (2 nhan moi pullback "
             + "— ngon nhat), nhan OF, va bia mo debug. Vuot 500 thi TradingView giu 500 nhan MOI NHAT "
             + "va bo cac nhan cu => bia mo o qua khu xa bien mat truoc. "
             + "500 la TRAN CUNG cua nen tang, khong the tang. "
             + "Hai o nay de LOC BOT bia mo, chi ve dung loai dang can truy vet => nhan tiet kiem duoc "
             + "se danh cho vung xa hon trong qua khu. "
             + "Muon them nua thi tat tam 'Show pullback', 'Mark Swing points', 'Show CHoCH/BOS/IDM' "
             + "va 'Nhan OF' — rieng 'Show pullback' co the giai phong hang tram nhan.")
showDbg       = input.bool(false, "DEBUG - Bang dem vung", group = "Debug",
     tooltip = "Dem so vung dang co theo tung nhom. Dung de biet vung bi thieu o KHAU NAO: cot cho = 0 nghia la khong sinh ung vien; cot cho > 0 ma song = 0 nghia la ung vien khong bao gio xac nhan duoc.")
ofDbgGhost    = input.bool(false, "DEBUG - Ve UNG VIEN OF dang cho", group = "Debug",
     tooltip = "Ung vien = chan hoi da chot nhung gia CHUA dong nen vuot bien xa nen CHUA duoc ve. "
             + "Day la khoang mu lon nhat cua he thong debug cu: bang dem noi 'dang co 3 ung vien' "
             + "nhung khong noi chung nam O DAU va con cach dich bao xa. "
             + "Bat len se ve ung vien bang HOP VIEN DUT mo, kem nhan  ?D#12 con 7  = ung vien Demand "
             + "so hieu 12, con 7 nen nua la het han. Nhan dat tai BIEN XA — dung cai muc gia ma "
             + "gia phai dong nen vuot qua thi ung vien moi thanh OF that. "
             + "Hop ma TU BIEN MAT khi ung vien duoc giai quyet: thanh OF that (hop dac hien ra dung "
             + "cho do) hoac bi huy (bat kem 'Bia mo' thi cho do con lai mot nhan cam). "
             + "LUU Y QUOTA: hop ma dung chung tran 500 BOX voi vung OF va POI, va nhan cua no dung "
             + "chung tran 500 NHAN. Ung vien chi song toi da bang so nen cua o 'OF phai xac nhan "
             + "trong vong' nen binh thuong khong dang ke — nhung neu ban de con so do rat lon thi "
             + "tat bot cac lop ve khac truoc khi bat cai nay.")
ofDbgTip      = input.bool(false, "DEBUG - Tooltip chi tiet tren nhan OF", group = "Debug",
     tooltip = "Di chuot len nhan OF-D / OF-S de xem ho so day du cua vung: so hieu, dinh/day, tuoi, "
             + "khoang cach toi gia, thu hang trong han ngach, va LY DO no dang hien hay dang bi an. "
             + "KHONG ton them mot nhan nao — chi gan tooltip vao nhan san co, nen bat thoai mai "
             + "ke ca khi dang gan cham tran 500 nhan.")
ofDbgList     = input.bool(false, "DEBUG - Bang soi tung vung OF", inline = "dbgl", group = "Debug",
     tooltip = "Liet ke tung vung OF dang nam trong bo nho, XEP THEO KHOANG CACH toi gia (gan nhat len dau). "
             + "Bang dem chi cho biet TONG SO; bang nay cho biet TUNG vung: no o dau, tuoi bao nhieu, "
             + "thu hang may, va neu khong thay tren chart thi vi luat nao. Cot 'trang thai': "
             + "HIEN = dang ve mau · XAM = da bi cham, nam cho · AN-ngach = bi day khoi top N. "
             + "AN-ngach chinh la cau tra loi cho cau hoi 'vung van con trong bo nho ma sao mat tren chart' — "
             + "va sau khi bo khoi (A2b) thi no la duong AN DUY NHAT con lai.")
ofDbgListN    = input.int(10, "dong", inline = "dbgl", minval = 1, maxval = 30, group = "Debug")
ofDbgLog      = input.bool(false, "DEBUG - Nhat ky su kien OF", inline = "dbgg", group = "Debug",
     tooltip = "Bang dem cong don tu dau chart, bang soi chup trang thai NGAY BAY GIO — ca hai deu mat "
             + "chieu THOI GIAN. Nhat ky ghi N su kien gan nhat theo dung thu tu xay ra: "
             + "sinh / ve box / huy P / huy H / xoa Q / xoa K / xoa V, kem so hieu vung va muc gia. "
             + "Tra loi duoc 'vung do chet luc nao, vi cai gi' ma khong phai zoom di tim bia mo. "
             + "Ve bang table nen KHONG ton quota 500 nhan.")
ofDbgLogN     = input.int(12, "dong", inline = "dbgg", minval = 1, maxval = 40, group = "Debug")

// CHE DO SOI = bat BAT KY mot cong tac debug nao o tren.
// Khi do khoi (A3) VE RA HET moi vung OF con trong bo nho, khong loc top N. Ly do phai gop
// chu khong lam mot cong tac rieng: dang soi mot vung bi mat ma he thong van con giau bot
// vung khac thi ban dang do mot thu da bi che mot phan — ket luan rut ra khong dang tin.
// Vao che do soi thi phai thay HET.
//
// Vung nao o che do THAT dang bi an se mang dau  !  o dau nhan (bi day khoi top N).
// Nhan tron = vung van hien binh thuong khi tat het debug.
//
// Quan trong: che do nay KHONG doi mot quyet dinh nao ben trong. Thu hang, co an, trang thai
// van duoc tinh theo dung luat cua che do that, va bang soi / tooltip van bao cao dung su that
// do. No chi go lop loc HIEN THI cuoi cung ra.
bool ofDbgOn = ofDbgCand or showDbg or ofDbgGhost or ofDbgTip or ofDbgList or ofDbgLog

//#region variable declaration
//Constant
const string IDM_TEXT = "I D M"
const string CHOCH_TEXT = "CHoCH"
const string BOS_TEXT = "B O S"
const string OFD_TEXT = "OF-D"    // Demand — chan hoi XUONG truoc khi gia di tiep LEN
const string OFS_TEXT = "OF-S"    // Supply — chan hoi LEN truoc khi gia di tiep XUONG
// Nap cung so vung OF giu trong bo nho moi chieu. KHONG phai han ngach hien thi
// (maxOFShow / maxOFMit) — cai do chi AN vung. Nap nay moi thuc su XOA, va dat rat rong
// de gan nhu khong bao gio cham toi.
const int OF_HARD_CAP = 30

//pullback leg state (thay cho bool + na: Pine không cho gán 'na' vào biến 'const bool')
const int MN_UP = 1
const int MN_DN = -1
const int MN_NA = 0

//inside bar
var motherHigh = high[1]
var motherLow = low[1]
var int motherBar = time[1]

//pullback
var int mnStrc = MN_NA
var int prevMnStrc = MN_NA
var float top = high
var float bot = low
var float top_ = high
var float bot_ = low
var int bar = time
var int bar_ = time

//poi
var bool isSweepOBS = false
var int current_OBS = na
var float high_MOBS = na
var float low_MOBS = na

var   bool isSweepOBD = false
var   int current_OBD = na
var   float low_MOBD = na
var   float high_MOBD = na

//Array
var puHigh = array.new_float(0)
var puHBar = array.new_int(0)
var puLow = array.new_float(0)
var puLBar = array.new_int(0)
var demandZone = array.new_box(0)
var supplyZone = array.new_box(0)
// Co mitigated cua POI. Pine KHONG co box.get_extend() / box.get_bgcolor() nen khong the
// doc nguoc trang thai tu chinh cai box => bat buoc phai luu song song.
var demandMit  = array.new_bool(0)
var supplyMit  = array.new_bool(0)

// ===== OF =====
// UNG VIEN: chan hoi vua xac nhan nhung gia CHUA pha qua bien xa => chua ve box.
var ofCTop  = array.new_float(0)
var ofCBot  = array.new_float(0)
var ofCBar  = array.new_int(0)
var ofCBull = array.new_bool(0)
var ofCAge  = array.new_int(0)
// MOC PHA cua ung vien (tai lieu trang 7, "Cach thuc xac dinh BOS hop le", Ghi chu):
//   neu gia CHUA dong than nen qua bien xa ma chi QUET RAU qua do, thi diem can pha KHONG con
//   la bien xa nua ma la DIEM CAO NHAT (OF-D) / THAP NHAT (OF-S) cua cay nen quet rau; chi khi
//   co nen DONG THAN qua diem do moi tinh la pha. Co nhieu nen quet rau lien tiep thi moc doi
//   theo diem cuc tri hien tai.
// `na` = chua co rau nao vuot bien xa => moc van la bien xa.
// Vung ve ra VAN la [bien giu ; bien xa] — moc nay chi quyet dinh LUC NAO vung duoc xac nhan.
var ofCRef  = array.new_float(0)
// DA XAC NHAN: co box, chay vong doi giong het vung POI.
var ofZone  = array.new_box(0)
var ofLbl   = array.new_label(0)
var ofBull  = array.new_bool(0)
var ofMit   = array.new_bool(0)   // da tung bi cham chua
var ofTouch = array.new_int(0)    // bar cua LAN CHAM CUOI — mep phai khi vung nghi
// Bo dem PHEU (debug). Pine KHONG cho ham ghi vao bien global thuong, nhung mang thi
// mutate duoc => dung mang lam bien dem de dem ca tu ben trong addOFCand/resolveNestOF.
//  0 sinh ung vien | 1 xac nhan | 3 huy pha nham | 4 het han | 5 box xoa vi quet
//  2 xoa vi pivot phu nhan (V) | 6 xoa vi cham nap cung OF_HARD_CAP (K)
//  7 huy UNG VIEN vi nam trong mot OF co chan hoi SOM hon (dieu kien #2, chieu xuoi)
//  8 huy UNG VIEN vi no la BAN RONG cua mot nhip hoi da co ban hep (luat thu hep c->b)
//  9 xoa VUNG RONG vi mot ban HEP tai cuc tri vua ra doi va thay the no (luat thu hep, chieu nguoc)
//  Du ca 10 khau roi thi bang dem moi co dong "kiem tra" va no phai bang 0.
// Tach RIENG 2 chieu: 0-9 = Demand, 10-19 = Supply. Gop chung thi khong tra loi duoc
// cau hoi "vi sao OF-S bien mat sach ma OF-D thi khong".
var ofStat = array.new_int(20, 0)
bumpStat(int k, bool isBull) =>
    idx = isBull ? k : k + 10
    array.set(ofStat, idx, array.get(ofStat, idx) + 1)

// ===== HA TANG DEBUG CHO OF ================================================
// TOAN BO phan duoi day chi QUAN SAT. Khong mot dong nao tham gia vao quyet dinh
// ve / an / xoa mot vung OF — tat het cong tac debug thi hanh vi y het truoc day.
// Ngoai le duy nhat va co y: khi BAT KY cong tac debug nao dang bat thi khoi (A3) ve ra het
// moi vung thay vi loc top N (xem `ofDbgOn`). Do la lop HIEN THI cuoi cung, khong phai quyet
// dinh — khong vung nao duoc sinh them hay bi xoa di vi no.

// So hieu duy nhat cho tung vung, cap NGAY TU LUC CON LA UNG VIEN va di theo no den luc chet.
// Nho no ma nhat ky moi noi duoc "vung #12 sinh o day, chet o kia": chi so mang thi doi lien
// tuc moi lan co vung bi rut ra, khong dung lam ten goi duoc.
// Pine khong cho ham ghi vao bien global thuong => dung mang 1 phan tu lam bien dem,
// dung thu thuat da dung cho ofStat.
var ofSeq = array.new_int(1, 0)
nextOFId() =>
    int v = array.get(ofSeq, 0) + 1
    array.set(ofSeq, 0, v)
    v

var ofCId  = array.new_int(0)     // id ung vien   — song song ofCTop / ofCBot / ofCBar / ofCBull / ofCAge
var ofId   = array.new_int(0)     // id vung da ve — song song ofZone / ofLbl / ofBull / ofMit / ofTouch
// Nen ma vung duoc XAC NHAN (khac han mep trai = nen cua chan hoi). Hai moc nay cach nhau
// toi `ofConfirmBars` nen, va chinh khoang cach do la thu phan biet "thu hep" voi "hai OF
// rieng biet" — xem `ofNestVerdict`.
var ofConfBar = array.new_int(0)
// BUOC 1 cua phep thu khai thac: gia DA ROI khoi vung chua.
//
// LUAT CUA BAN (chat hon tai lieu): "roi vung" = co CAY NEN DAU TIEN NAM TRON BEN NGOAI vung
//   OF-D: low  > dinh vung   ·   OF-S: high < day vung
// Chi tu sau cay nen do, gia quay lai cham vung moi tinh la KHAI THAC.
//
// Vi sao khong lay cay nen XAC NHAN (dong cua vuot bien xa) lam moc roi vung nhu tai lieu:
// cay nen xac nhan thuong van con RAU nam trong vung, va cay nen ngay sau no rut rau lai vao
// vung la chuyen binh thuong cua mot cu pha — tinh do la khai thac thi mat luon mot OF tiem
// nang ngay khi no vua ra doi (vi du OF-S-395 tren ETHUSDT 15m, 02-10).
//
// Cai gia phai tra, CO Y CHAP NHAN: cu retest ngay sau nen pha ma rau van cham vung se KHONG
// duoc tinh (vi du vung #1485 [1565.19 ; 1604.00] tren ETHUSDT 4H, nen co L = 1597.25).
//
// Khoi tao luc xac nhan: `true` neu CHINH cay nen xac nhan da nam tron ngoai vung (vd nhay gap),
// nguoc lai `false`. Sau do khoi (A) bat co nay o cay nen nam tron ngoai dau tien.
var ofLeft = array.new_bool(0)
// Da co cay nen nao co THAN (gia dong cua HOAC mo cua) nam trong vung chua.
// Khac han co cham o tren: cham thi rau cung tinh, con than nen thi khong.
// Co nay chi dieu khien MEP PHAI — xem khoi (A3).
var ofBody = array.new_bool(0)
// CUC TRI ma gia da VE TOI ke tu luc vung bi coi la DA ROI (`ofLeft` bat).
//   OF-D: LOW thap nhat da cham toi   ·   OF-S: HIGH cao nhat da cham toi
// Day la con so chot ha cho ca mot lop cau hoi dang "gia quay lai cham roi ma sao chua xam".
// Khong co no thi cau tra loi duy nhat la "engine bao chua cham", va do la loi noi chu khong
// phai bang chung. Co no roi thi chi can so sanh voi BIEN GAN cua vung la xong:
//   OF-D: cuc tri >  dinh vung => dung la gia chua he ve toi noi
//   OF-D: cuc tri <= dinh vung => gia DA cham ma vung khong xam => BUG that
var ofExtr = array.new_float(0)
var ofCBox = array.new_box(0)     // hop MA cua ung vien — chi khac na khi bat ofDbgGhost
var ofCLbl = array.new_label(0)

// ===== TRANG THAI CUA ENGINE OF KHUNG LON (HTF) ===========================
// Ban sao doc lap cua engine OF, chay tren nen cua khung lon. Khong dung chung mot bien
// nao voi engine chinh — hai ben phai song song tuyet doi, neu khong se giam nhau.
// Dat tien to h* cho moi thu thuoc ve no.
var hcTop  = array.new_float(0)   // ung vien khung lon
var hcBot  = array.new_float(0)
var hcBar  = array.new_int(0)
var hcBull = array.new_bool(0)
var hcAge  = array.new_int(0)
var hcRef  = array.new_float(0)   // moc pha khung lon — xem chu thich `ofCRef`
// HO SO vung khung lon. HINH HOC (hzTop/hzBot) tach HAN khoi HINH VE (hzBox/hzLbl):
// mot vung da bi khai thac thi XOA HINH VE (hzBox/hzLbl := na) nhung HO SO VAN NAM LAI.
//
// Phai lam the vi cac luat long nhau (N / T / thu hep) can doc LICH SU, khong chi cac vung
// dang hien. Engine chinh tren chart 4H giu vung da khai thac lai trong `ofZone` duoi dang
// XAM, nen mot ung vien nam tron trong mot vung xam cu van bi loai bang ma N. Ban dau engine
// nay XOA thang vung da khai thac khoi mang => ung vien do mat doi thu va duoc ve, sinh ra
// nhung vung 4H chi co tren 15m ma mo chart 4H thi khong thay. Do chinh la bug "mot so OF 4h
// ve khong dung". Gio ho so o lai, hai engine doc cung mot lich su.
var hzTop  = array.new_float(0)   // dinh — NGUON SU THAT, doc duoc ca khi hop da bi xoa
var hzBot  = array.new_float(0)   // day
var hzBox  = array.new_box(0)     // hop dang ve, hoac na neu da khai thac
var hzLbl  = array.new_label(0)   // nhan dang ve, hoac na neu da khai thac
var hzMit  = array.new_bool(0)    // da bi khai thac (than nen vao trong) => khong ve nua
// BUOC 1 cua phep thu khai thac ben engine khung lon. Ban sao cua `ofLeft`, cung luat:
// phai co mot cay nen KHUNG LON nam TRON ben ngoai vung thi moi tinh la da roi vung.
var hzAway = array.new_bool(0)
// Ket qua CUOI CUNG cua phep thu hien thi, tinh lai MOI NEN o khoi (D5). Khong phai trang
// thai luu tru: mot vung da khai thac co the song lai neu ben trong no xuat hien mot OF
// khung nho con nguyen, nen cau tra loi phai duoc hoi lai lien tuc chu khong chot mot lan.
var hzLive = array.new_bool(0)
// CHOT CHET VINH VIEN. Khi mot vung khung lon da bi khai thac VA khong con OF khung nho nao
// con nguyen ben trong thi no chet HAN — ve sau co OF khung nho moi sinh ra trong do cung
// khong lam no song lai.
// Khong co co nay thi mot vung da tieu se cu chop tat theo nhip ra doi / bi an cua cac OF
// khung nho ben trong no, va cai hien ra se khong con la "vung khung lon con hang" nua.
var hzDead = array.new_bool(0)
// DA TUNG CO HANG chua — vung nay da co luc nao mot OF khung nho CUNG CHIEU con nguyen nam
// ben trong no chua.
//
// Khong co co nay thi `hzDead` doc nham mot tap RONG thanh "da tieu het". Hai thu khac han:
//   tap rong  = chua tung co gi de tieu          -> chua duoc phep ket luan gi
//   tung co, gio het = dung nghia "khai thac het" -> moi duoc chot chet
// Luat ban dat ra la "cac OF 15m ben trong CUNG BI KHAI THAC HET", ma chu "het" chi co
// nghia khi truoc do co mot cai gi do. Xem khoi (D5).
var hzSeen = array.new_bool(0)
// Anh chup THU HANG trong han ngach ma khoi (D5) vua tinh. Bang soi DOC LAI cai nay chu
// khong tinh lai — cung ly do nhu ofRankA ben engine chinh: hai noi cung dien giai mot bo
// luat thi som muon gi cung lech, va luc do chinh cai debug tro thanh nguon nghi ngo.
var hzRank = array.new_int(0)
// THOI DIEM vung khung lon BI KHAI THAC — lay mep TRAI cua cay nen khung lon da khai thac no.
// Day la cai moc chia doi lich su cua vung: OF khung nho sinh ra TRUOC moc nay la hang con
// sot lai cua chinh chan hoi do; sinh ra SAU moc nay la cau truc moi do chinh nhip khai thac
// de ra, khong phai cua no. Xem `htfHasLiveInner`.
var hzMitBar = array.new_int(0)
var hzBull = array.new_bool(0)
var hzLeft = array.new_int(0)     // mep trai = nen chan hoi
var hzConf = array.new_int(0)     // nen xac nhan
var hpHigh = array.new_float(0)   // lich su pivot cua engine pullback khung lon
var hpHBar = array.new_int(0)
var hpLow  = array.new_float(0)
var hpLBar = array.new_int(0)
var float hTop  = na
var float hBot  = na
var float hTop_ = na
var float hBot_ = na
var int   hBar  = na
var int   hBar_ = na
var int   hMn     = MN_NA
var int   hPrevMn = MN_NA

// PHEU CUA ENGINE KHUNG LON. Cho den gio engine nay chay HOAN TOAN MU: engine chinh co bia
// mo, pheu, nhat ky, bang soi — engine khung lon khong co gi, nen khi mot vung 4H khong duoc
// ve thi ca hai ta deu chi ngoi doan. Bo dem nay cham dut viec do.
// Danh so y HET ofStat de doc hai bang canh nhau khong phai doi dau:
//   0 sinh ung vien · 1 ve box · 2 xoa qua tuoi · 3 huy P · 4 huy H
//   5 xoa Q (quet) · 6 xoa K (nap cung) · 7 huy N · 8 huy T · 9 AN vi da khai thac
// 0-9 = Demand, 10-19 = Supply.
var hStat = array.new_int(20, 0)
bumpH(int k, bool isBull) =>
    idx = isBull ? k : k + 10
    array.set(hStat, idx, array.get(hStat, idx) + 1)

// Anh chup trang thai HIEN THI ma khoi (A3) vua quyet dinh. Bang soi DOC LAI cai nay chu
// KHONG tinh lai: tinh lai la co hai noi cung dien giai mot bo luat, som muon gi cung lech,
// va luc do chinh cai debug tro thanh nguon nghi ngo.
var ofVisA  = array.new_bool(0)
var ofRankA = array.new_int(0)
var usedL   = array.new_bool(0)   // co "da in roi" cua bang soi, dung lai moi nen

// NHAT KY: giu LOG_KEEP su kien gan nhat, theo dung thu tu xay ra.
var logBar = array.new_int(0)
var logEv  = array.new_string(0)
var logBl  = array.new_bool(0)
var logId  = array.new_int(0)
var logLvl = array.new_float(0)
const int LOG_KEEP = 60
logOF(string ev, bool isBull, int id, float lvl) =>
    if ofDbgLog
        array.push(logBar, time)
        array.push(logEv , ev)
        array.push(logBl , isBull)
        array.push(logId , id)
        array.push(logLvl, lvl)
        if array.size(logEv) > LOG_KEEP
            array.shift(logBar)
            array.shift(logEv)
            array.shift(logBl)
            array.shift(logId)
            array.shift(logLvl)

// So pivot moi voi pivot CUNG LOAI lien truoc — bo loc chieu (muon cua EMA_v1).
var float prevPivotHigh = na
var float prevPivotLow  = na

// bias cau truc: 1 = bullish, 0 = bearish. Chi duoc gan trong region cau truc.
// KHONG dung de loc chieu OF: no qua tre (phai cho chochLen nen xac nhan swing) nen suot
// ca mot nhip hoi phuc no van con bao "giam". Chieu OF khong duoc quyet dinh luc TAO ma
// luc XAC NHAN (pha bien nao truoc) va luc XOA (pha bien giu thi het hieu luc).
var int os = 0

// IDM đang CHỜ bị quét. Giữ lại cả khi đã có BOS mới — giá có thể quay về quét sau.
// Mỗi phần tử = 1 mốc IDM: đường vẽ, nhãn, mức giá, chiều (true = mốc là đáy pullback).
var idmLnArr  = array.new_line(0)
var idmLbArr  = array.new_label(0)
var idmLvlArr = array.new_float(0)
var idmUpArr  = array.new_bool(0)

//color
color transp = color.new(color.gray,100)

//Caculate
curTf = timeframe.in_seconds(timeframe.period)
len = curTf*1000

// ===== NGUONG 1H: RAU CO DU DE CHOT DO DAI OF HAY KHONG ===================
// Khai thac van luon la "roi han khoi vung roi quay lai cham" o moi khung. Cai KHAC nhau
// theo khung la buoc THU HAI — cai gi dung do dai cua vung lai:
//
//   khung <= 1H : RAU cham la du. Vung chuyen xam VA chot mep phai ngay tai nen do.
//   khung >  1H : phai co THAN NEN (dong cua HOAC mo cua) nam trong vung moi chot mep phai.
//                 Rau quet qua thi vung van xam nhung mep phai van chay tiep.
//
// Ly do: mot cay nen 4H la 16 cay 15m. Cai rau cua no co the la ca mot nhip giao dich tron
// ven ma o khung nho ta thay ro tung buoc, nen o khung lon phai doi than nen moi chac la gia
// that su da giao dich ben trong vung. O khung 15m tro xuong thi mot cai rau da la mot nhip
// ngan, khong con gi de doi them.
//
// RANH GIOI: 1H nam o NHOM DUOI (rau la du). 3600 giay = 1H.
bool ofWickEnds = curTf <= 3600
// dùng để đẩy chấm swing ra xa nến — theo ATR nên tự co giãn theo từng mã/khung
atrSw = ta.atr(14)

//#endregion

//#region Inside Bar
isb = motherHigh > high and motherLow < low
if isb
    motherHigh := motherHigh
    motherLow := motherLow
    motherBar := motherBar
else
    motherHigh := high
    motherLow := low
    motherBar := time

//#endregion

//#region drawing function
textCenter(int left, int right) => int(math.avg(left,right))

getStyleLabel(bool style) => style ? label.style_label_down : label.style_label_up
getStyleArrow(bool style) => style ? label.style_arrowdown : label.style_arrowup

getYloc(bool style) =>   style ? yloc.abovebar : yloc.belowbar

getNLastValue(arr, n) =>
    if array.size(arr) > n - 1
        array.get(arr, array.size(arr) - n)

// #L5 (một phần) — pullback không còn khách hàng nào tiêu thụ & xoá mảng như IDM cũ,
// nên phải tự chặn mảng phình vô hạn.
trimArr(arr) =>
    if array.size(arr) > maxPbHistory
        array.shift(arr)

drawPullback(int x, float y, bool trend) =>
    color = trend ? bear : bull
    if showMn
        label.new(x, y, "", xloc.bar_time, getYloc(trend), color, getStyleArrow(trend), size = size.tiny )

// Vẽ CHoCH / BOS. Theo quy ước LuxAlgo: CHoCH nét đứt, BOS nét liền.
drawStrc(string txt, int xBar, float y, bool trend) =>
    col = trend ? bull : bear
    line.new(xBar, y, time, y, xloc.bar_time, color = col, style = txt == BOS_TEXT ? line.style_solid : line.style_dashed)
    label.new(textCenter(time, xBar), y, txt, xloc.bar_time, color = transp, style = getStyleLabel(trend), textcolor = col, size = size.small)

// Mốc IDM được xác định MỘT LẦN tại nến đóng BOS rồi KHÔNG BAO GIỜ dời nữa.
// isUp = true : mốc là ĐÁY pullback (xu hướng tăng), giá sẽ đi xuống để quét.
// isUp = false: mốc là ĐỈNH pullback (xu hướng giảm), giá sẽ đi lên để quét.
addIdm(int xBar, float y, bool isUp) =>
    ln = line.new(xBar, y, time, y, xloc.bar_time, color = colorIDM, style = line.style_dotted)
    lb = label.new(textCenter(time, xBar), y, IDM_TEXT, xloc.bar_time, color = transp, textcolor = colorIDM, style = getStyleLabel(not isUp), size = size.small)
    array.push(idmLnArr , ln)
    array.push(idmLbArr , lb)
    array.push(idmLvlArr, y)
    array.push(idmUpArr , isUp)
    // chặn tràn quota line: thôi theo dõi mốc cũ nhất, nét vẽ vẫn ở lại chart
    if array.size(idmLvlArr) > 20
        array.shift(idmLnArr), array.shift(idmLbArr)
        array.shift(idmLvlArr), array.shift(idmUpArr)

// Đánh dấu swing kèm chữ HH / HL / LH / LL. Ba tổ hợp theo 2 toggle, mỗi tổ hợp cần một
// style khác nhau — chỉ 1 label duy nhất, không xếp chồng:
//   hình + chữ -> style_label_center : hộp bo góc, chữ nằm giữa, hộp TỰ co giãn vừa chữ
//   chỉ hình   -> style_square       : ô vuông rỗng (label_center không chữ sẽ co gần như mất)
//   chỉ chữ    -> style_none         : chữ trơn, không nền
// isTop = true -> đỉnh swing, đánh dấu PHÍA TRÊN nến; false -> đáy swing, phía dưới.
addSwingDot(int xBar, float lvl, string tag, bool isTop) =>
    if swingShowTx or swingShowBg
        y   = isTop ? lvl + swingOfs * atrSw : lvl - swingOfs * atrSw
        col = color.new(isTop ? bear : bull, swingTransp)
        stl = swingShowBg ? (swingShowTx ? label.style_label_center : label.style_square) : label.style_none
        label.new(xBar, y, swingShowTx ? tag : "", xloc.bar_time,
             color = swingShowBg ? col : transp, textcolor = colorSwingTx,
             style = stl, size = swingSize)

createBox(left, right, top, bottom, color) =>
    box.new(left=left, right=right, top=top, bottom=bottom, xloc = xloc.bar_time, bgcolor=color, border_color=color, extend = extend.right)

removeZone(zoneArray, mitArray, box zone) =>
    index = array.indexof(zoneArray, zone)
    box.delete(zone)
    array.remove(zoneArray, index)
    array.remove(mitArray , index)

marginZone(zone) => [box.get_top(zone), box.get_bottom(zone), box.get_left(zone)]

// Gioi han so vung POI moi chieu, DEM RIENG 2 nhom: con song vs da xam.
// supplyZone/demandZone la 2 mang RIENG nen khong can loc chieu; mang day theo thu tu
// thoi gian => phan tu dau tien khop nhom chinh la vung CU NHAT cua nhom do.
trimZoneArr(zoneArray, mitArray, int maxLive, int maxMit) =>
    int nLive = 0
    int nMit  = 0
    if array.size(zoneArray) > 0
        for i = 0 to array.size(zoneArray) - 1
            if array.get(mitArray, i)
                nMit  += 1
            else
                nLive += 1
    int i2 = 0
    while (nLive > maxLive or nMit > maxMit) and i2 < array.size(zoneArray)
        bool m = array.get(mitArray, i2)
        if (m and nMit > maxMit) or (not m and nLive > maxLive)
            box.delete(array.get(zoneArray, i2))
            array.remove(zoneArray, i2)
            array.remove(mitArray , i2)
            if m
                nMit  -= 1
            else
                nLive -= 1
        else
            i2 += 1

handleZone(zoneArray, mitArray, left, top, bot, color) =>
    _top = top
    _bot = bot
    _left = left

    zone = getNLastValue(zoneArray, 1)

    [topZone, botZone, leftZone] = marginZone(zone)
    rangeTop = math.abs(_top-topZone)/(topZone-botZone) < mergeRatio
    rangeBot = math.abs(_bot-botZone)/(topZone-botZone) < mergeRatio

    //Merge zone
    if _top >= topZone and _bot <= botZone or rangeTop or rangeBot
        _top := math.max(_top,topZone)
        _bot := math.min(_bot,botZone)
        _left := leftZone
        removeZone(zoneArray, mitArray, zone)

    if not (_top <= topZone and _bot >= botZone)
        array.push(zoneArray, createBox(_left, time, _top, _bot, color))
        array.push(mitArray , false)

processZones(zones, mitArr, isSupply) =>
    if array.size(zones) > 0
        for i = array.size(zones) - 1 to 0 by 1
            zone = array.get(zones, i)
            [topZone, botZone, leftZone] = marginZone(zone)

            //Breaker block zones
            if isSupply and low < botZone and close > topZone
                array.push(demandZone, createBox(leftZone, time, topZone, botZone, colorDemand))
                array.push(demandMit , false)
            else if not isSupply and high > topZone and close < botZone
                array.push(supplyZone, createBox(leftZone, time, topZone, botZone, colorSupply))
                array.push(supplyMit , false)
            //Mitigated zones
            else if (isSupply and high >= botZone and high < topZone) or (not isSupply and low <= topZone and low > botZone)
                box.set_right(zone, time)
                box.set_extend(zone,extend.none)
                box.set_bgcolor(zone, colorMitigated)
                box.set_border_color(zone, colorMitigated)
                array.set(mitArr, i, true)

            //Delete sweep zones
            if (time - leftZone > len*maxBarHistory) or (isSupply and high >= topZone) or (not isSupply and low <= botZone)
                removeZone(zones, mitArr, zone)

scob(zones, isSupply) =>
    [topZone, botZone, leftZone] = marginZone(getNLastValue(zones, 1))

    if not isb[1]
        if not isSupply and low[1] < low[2] and low[1] < low and close > high[1] and low[1] < topZone and low[1] > botZone
            scobUp
        else if isSupply and high[1] > high[2] and high[1] > high and close < low[1] and high[1] < topZone and high[1] > botZone
            scobDn
        else
            na

// ===== HAM ORDER FLOW ======================================================
// Pivot CUNG LOAI gan nhat hinh thanh TRUOC refBar (muon cua EMA_v1).
findPivotBefore(arrVal, arrBar, int refBar) =>
    float v = na
    int   b = na
    if array.size(arrVal) > 0
        for i = array.size(arrVal) - 1 to 0
            if array.get(arrBar, i) < refBar
                v := array.get(arrVal, i)
                b := array.get(arrBar, i)
                break
    [v, b]

// Bia mo co duoc ve khong? Loc theo chieu va theo ly do de tiet kiem quota 500 nhan.
dbgOk(bool isBull, string why) =>
    bool sideOk = ofDbgSide == "D + S" or (isBull ? ofDbgSide == "Chi D" : ofDbgSide == "Chi S")
    bool whyOk  = ofDbgWhy  == "Tat ca" or str.startswith(ofDbgWhy, why)
    ofDbgCand and sideOk and whyOk

// `why` = ly do xoa, chi dung cho bia mo debug:
//   Q = bi QUET (rau xuyen bien giu)   K = bi han ngach duoi   V = pivot moi phu nhan
//   W = vung RONG bi mot ban HEP tai cuc tri thay the (luat thu hep, trang 26/27/29)
// Bia mo nay danh cho vung DA VE roi moi bi xoa — khac han bia mo cua UNG VIEN (mau cam).
removeOF(int i, string why) =>
    if dbgOk(array.get(ofBull, i), why)
        [t, b, l] = marginZone(array.get(ofZone, i))
        bool bl = array.get(ofBull, i)
        label.new(l, bl ? b : t, (bl ? "D!" : "S!") + why, xloc.bar_time,
             color = transp, textcolor = color.red,
             style = bl ? label.style_label_up : label.style_label_down, size = size.tiny)
    // Ghi nhat ky TRUOC khi rut khoi mang — rut xong thi khong con doc lai duoc gi.
    // ofId la mang DEBUG: neu mot ban sua sau nay quen day vao thi no se ngan hon ofZone.
    // Phai kiem tra kich thuoc, tuyet doi khong de mot loi debug lam sap ca indicator.
    [tL, bL, lL] = marginZone(array.get(ofZone, i))
    bool blL = array.get(ofBull, i)
    int  idL = 0
    if i < array.size(ofId)
        idL := array.get(ofId, i)
    logOF("xoa " + why, blL, idL, blL ? bL : tL)
    box.delete(array.get(ofZone, i))
    label.delete(array.get(ofLbl, i))
    array.remove(ofZone , i)
    array.remove(ofLbl  , i)
    array.remove(ofBull , i)
    array.remove(ofMit  , i)
    array.remove(ofTouch, i)
    if i < array.size(ofId)
        array.remove(ofId, i)
    if i < array.size(ofConfBar)
        array.remove(ofConfBar, i)
    if i < array.size(ofLeft)
        array.remove(ofLeft, i)
    if i < array.size(ofBody)
        array.remove(ofBody, i)
    if i < array.size(ofExtr)
        array.remove(ofExtr, i)
    // Anh chup hien thi cua (A3) phai bam theo DUNG chi so cua ofZone. Khoi (C) trimOF chay
    // SAU khi chup, nen neu no rut mot vung ra ma anh chup khong rut theo thi tu vung do tro di
    // moi thu lech mot nac — bang soi se bao "vung nay bi an" trong khi thu phu la vung khac.
    if i < array.size(ofVisA)
        array.remove(ofVisA , i)
    if i < array.size(ofRankA)
        array.remove(ofRankA, i)

// Khoang cach tu GIA HIEN TAI toi mep gan nhat cua vung. Gia dang nam trong vung => 0.
ofDist(box z) =>
    [t, b, l] = marginZone(z)
    close > t ? close - t : close < b ? b - close : 0.0

// NAP CUNG chong tran: chi de mang khong phinh vo han va khong dot het quota 500 box cua
// TradingView. DAY KHONG PHAI han ngach hien thi — han ngach hien thi nam o khoi (A3) va
// chi AN vung chu KHONG xoa.
// Nguong dat rat rong so voi maxOFShow/maxOFMit nen gan nhu khong bao gio cham toi.
trimOF(bool isBull, int maxKeep) =>
    int n = 0
    if array.size(ofZone) > 0
        for i = 0 to array.size(ofZone) - 1
            if array.get(ofBull, i) == isBull
                n += 1
    while n > maxKeep and array.size(ofZone) > 0
        int   worst = -1
        float far   = -1.0
        for i = 0 to array.size(ofZone) - 1
            if array.get(ofBull, i) == isBull
                float d = ofDist(array.get(ofZone, i))
                if d > far
                    far   := d
                    worst := i
        if worst == -1
            break
        // Khau nay truoc day KHONG duoc dem => vung bien mat vi nap cung khong de lai dau vet
        // nao trong pheu, chi con moi cai bia mo D!K neu tinh co dang bat dung bo loc.
        bumpStat(6, isBull)
        removeOF(worst, "K")
        n -= 1

// ===== DIEU KIEN #2 CUA TAI LIEU ==========================================
// BankTrap trang 26: "Mot OF hop le phai thoa 2 dieu kien: Gia phai pha khoi day cua OF
// & KHONG DUOC NAM TRONG OF TRUOC DO", minh hoa bang "OF2 khong phai la OF hop le du gia
// pha qua day B nhung OF nay nam trong OF1".
//
// Doc ky CHU NGU: cai bi loai la OF MOI (OF2), cai duoc giu la OF CU bao ngoai (OF1).
// Ban truoc khoi (A2b) lam NGUOC: no AN vung CU bao ngoai va giu vung MOI ben trong —
// tuc giu cai ngoay nho va vut ca nhip hoi that. Da bo khoi do, thay bang ham nay.
//
// HAI THAY DOI KEM THEO, deu co can cu:
//  1) Day la DIEU KIEN HOP LE, khong phai bo loc hien thi. Tai lieu xep no ngang hang voi
//     dieu kien #1 (phai pha dinh/day) => OF vi pham thi KHONG DUOC SINH RA, chu khong phai
//     sinh ra roi giau di. Nen cho kiem tra la khoi (B), ngay tai luc xac nhan.
//     Gia phai tra: ung vien bi loai la mat han, khong "song lai" khi vung bao ngoai chet.
//     Nhung do dung la y tai lieu — no CHUA BAO GIO la OF hop le.
//  2) KHONG loc theo co "da bi khai thac". Tung co mot ban lam nguoc lai: chi so voi vung
//     chua bi khai thac, lay can cu tu trang 35 ("khi gia da ve day roi cac OF o ben tren
//     khong can phai de y nua vi da bi khai thac het"). DA GO BO, vi doc ky lai thi thay
//     trang 35 dang noi ve vung NAO DANG DE VAO LENH, chu khong noi vung da tieu thi mat
//     quyen phu nhan mot OF moi. Trang 26 con noi thang dieu nguoc lai: "OF2 CUNG DUOC XEM
//     LA MOT OF va OF2 DA KHAI THAC OF1" — mot OF hinh thanh TRONG LUC dang khai thac OF
//     truoc van hop le. Thu duy nhat giet no la NAM TRON ben trong OF truoc.
//     => O day moi vung deu co quyen phu nhan nhu nhau, xam hay khong khong quan trong.
//
// Hinh hoc giu nguyen — phan nay khoi (A2b) cu lam dung: chi xet KHOANG GIA (chieu doc),
// va phai nam TRON ben trong. Trang 27 + trang 35: nho ra khoi bien tren HOAC thoi xuong
// duoi, du chi mot chut, la hop le ("gioi han tren cua OF nay chi cao hon OF truoc mot it
// nhung da vuot qua => OF hop le"). Be ngang cua hop khong tham gia.
// TAI LIEU CO HAI LUAT VE VUNG LONG NHAU, VA CHUNG CHI TRAI NGUOC KHI DOC AU.
//
//  (1) Dieu kien #2, trang 26: "OF2 khong phai la OF hop le ... vi nam trong OF1"
//      => vung TRONG bi loai, vung NGOAI song.
//  (2) Luat thu hep, trang 26 ("c nen thu hep lai thanh truong hop b"), trang 27 ("OF nam o
//      pullback NHO CUOI CUNG cua pullback lon"), trang 29 ("co the thu hep lai OF")
//      => vung TRONG song, vung NGOAI chi la ban ve rong tay.
//
// Khac biet nam o CHO NAY: giua hai chan hoi da co mot nhip TIEP DIEN tron ven chua?
//   OF1/OF2 : gia roi OF1, di tiep theo xu huong, roi MOI quay lai tao OF2 => co nhip o giua
//   thu hep : hai chan cung thuoc MOT nhip hoi, cung duoc giai quyet boi CUNG mot cu pha
//
// Ma "di tiep theo xu huong" chinh la dieu kien #1 — cu pha bien xa. Nen phep thu la:
//     vung ngoai da XAC NHAN XONG truoc khi chan hoi cua vung trong hinh thanh chua?
//        roi  -> co nhip tiep dien o giua -> hai OF rieng biet -> loai vung TRONG   (ma N)
//        chua -> cung mot nhip hoi        -> thu hep            -> loai ban RONG    (ma T)
// Mot tieu chi, khop ca hai cho trong tai lieu. Day la ly do phai co mang `ofConfBar`.
//
// NHANH THU BA — THU HEP (y cua ban, va no trung khop nguyen van trang 27 muc 2):
//   Neu ung vien nam tron trong mot vung rong VA no nam o phia CUC TRI cua vung do
//   (OF-D: sat DAY · OF-S: sat DINH) thi day chinh la "pullback nho CUOI CUNG cua pullback lon".
//   Khi do KHONG loai ung vien — nguoc lai: VE no, va DON vung rong di (xem `shrinkWideOF`).
//   Nguong "sat" lay tu o nhap `ofShrinkEdge`.
//   Nhanh nay duoc uu tien hon nhanh N: mot ung vien dung ngay cuc tri cua vung bao ngoai la
//   ban tinh chinh cua chinh vung do, khong phai mot OF khac tinh co roi vao trong.
//
// Tra ve: 0 = ve binh thuong · 1 = loai vi nam trong OF truoc (N) · 2 = loai vi la ban rong (T)
//         3 = VE, va don cac vung rong ma no vua thu hep lai (W)
//
// Luu y ve thu tu tu nhien: neu C nam trong Z thi dinh cua Z cao hon, nen Z bao gio cung
// xac nhan SAU C. Vi vay nhanh (1) chi bat duoc khi Z la OF cua mot chu ky TRUOC do han —
// dung y tai lieu. Con ca khung vang tren BTCUSDT (ban hep ve truoc, ban rong xac nhan sau)
// roi vao nhanh (2).
atShrinkEdge(float top, float bot, bool isBull, float t, float b) =>
    float h = t - b
    bool res = false
    if h > 0
        res := isBull ? (bot - b) <= h * ofShrinkEdge : (t - top) <= h * ofShrinkEdge
    res

ofNestVerdict(float top, float bot, bool isBull, int leftBar) =>
    bool killN  = false
    bool killT  = false
    bool shrink = false
    if array.size(ofZone) > 0
        for i = 0 to array.size(ofZone) - 1
            if array.get(ofBull, i) == isBull
                [t, b, l] = marginZone(array.get(ofZone, i))
                int cf = l
                if i < array.size(ofConfBar)
                    cf := array.get(ofConfBar, i)
                // ung vien nam TRON trong mot vung co chan hoi som hon
                if l < leftBar and top <= t and bot >= b
                    if atShrinkEdge(top, bot, isBull, t, b)
                        shrink := true      // dung o cuc tri => la ban THU HEP cua vung do
                    else if cf < leftBar
                        killN := true       // nam giua => hai OF rieng biet, dieu kien #2
                // ung vien NUOT mot vung co chan hoi muon hon => ung vien la ban rong
                if l > leftBar and t <= top and b >= bot
                    killT := true
    shrink ? 3 : killN ? 1 : killT ? 2 : 0

// Don cac vung RONG ma ung vien vua thu hep lai. Goi NGAY SAU khi ung vien da duoc ve,
// nen vung moi dang nam o chi so cuoi cung => bat dau duyet tu size-2.
// Duyet NGUOC: removeOF chi lam xe dich cac chi so LON hon i, nen phan chua duyet van dung.
shrinkWideOF(float top, float bot, bool isBull, int leftBar) =>
    if array.size(ofZone) > 1
        for i = array.size(ofZone) - 2 to 0
            if array.get(ofBull, i) == isBull
                [t, b, l] = marginZone(array.get(ofZone, i))
                if l < leftBar and top <= t and bot >= b and atShrinkEdge(top, bot, isBull, t, b)
                    bumpStat(9, isBull)
                    removeOF(i, "W")

// ===== HAM CUA ENGINE OF KHUNG LON ========================================
// Khong co bia mo / nhat ky / han ngach o day: vung khung lon chi co hai trang thai —
// dang ve, hoac da bi xoa. Don gian duoc vi da khai thac la xoa luon chu khong chuyen xam.
// XOA HAN mot ho so — dung cho dung hai truong hop ma engine chinh cung xoa han khoi
// `ofZone`: gia QUET qua bien giu, va vung qua han tuoi. Sau do vung khong con quyen phu
// nhan ung vien nao nua, dung nhu ben 4H.
htfRemoveZone(int i) =>
    box.delete(array.get(hzBox, i))
    label.delete(array.get(hzLbl, i))
    array.remove(hzTop , i)
    array.remove(hzBot , i)
    array.remove(hzBox , i)
    array.remove(hzLbl , i)
    array.remove(hzMit , i)
    array.remove(hzAway, i)
    array.remove(hzDead, i)
    array.remove(hzSeen, i)
    array.remove(hzMitBar, i)
    array.remove(hzBull, i)
    array.remove(hzLeft, i)
    array.remove(hzConf, i)

// LUAT CUU VUNG — ben trong vung khung lon nay con OF khung nho nao CHUA bi khai thac khong?
//
// Mot vung khung lon da bi khai thac khong nhat thiet la da het hang. Neu ben trong no van
// con mot OF cua khung dang xem chua ai dung toi thi khu vuc do van la noi de vao lenh, chi
// la phai vao bang cau truc khung nho. Chi khi khong con mot OF con nguyen nao thi vung
// khung lon moi thuc su het viec va bi an.
//
// THE NAO LA "NAM BEN TRONG" — hai truong hop, va truong hop thu hai CO HUONG:
//   (a) nam TRON ben trong                      -> tinh
//   (b) nam MOT PHAN, nho ra khoi bien ma GIA SE GAP TRUOC TIEN -> tinh
//         vung MUA (Demand): bien do la bien TREN  -> nho len tren dinh thi van tinh
//         vung BAN (Supply): bien do la bien DUOI  -> nho xuong duoi day thi van tinh
//   (c) nho ra khoi bien CON LAI (duoi day vung mua / tren dinh vung ban) -> KHONG tinh
//
// CHIEU: chi xet OF khung nho CUNG CHIEU voi vung khung lon. Mot vung ban nam trong mot vung
// mua khong phai la ly do de giu vung mua lai — hai ben dinh vao lenh nguoc nhau.
//
// THOI DIEM — bo loc thu ba, va la cho de sua mot lo hong that:
//   OF khung nho phai DA TON TAI TRUOC khi vung khung lon bi khai thac (`cf < mitBar`).
//
// Khong co dieu kien nay thi chinh NHIP KHAI THAC lai tu cuu lay vung. Gia di vao vung, bo
// ra vai chuc OF khung nho moi ngay trong dai gia do, va may cai do giu vung song mai mai.
// Do la cau truc MOI do nhip khai thac de ra, khong phai hang con sot lai cua chan hoi khung
// lon — ma "con hang" moi la cai luat nay di hoi.
// Doi chieu thuc te tren ETHUSDT: vung 4H 2703.78/2635.71 bi khai thac tu lau, roi cac OF-D
// 15m so hieu 4 / 69 / 75 / 139 moc len trong luc gia bo tro lai — ca bon deu sinh SAU, va
// chung dang mot minh giu cho vung 4H do khong chet.
//
// Ly do (c) bi loai: gia phai di XUYEN HET vung khung lon roi moi cham toi cho nho ra do.
// Cai OF nam o day khong con dai dien cho vung khung lon nua, no la mot muc gia khac han
// o ben kia. Vung nao to hon vung khung lon va trum ca hai dau cung roi vao (c) — no nho ra
// ca bien sai — nen cung khong cuu duoc.
htfHasLiveInner(float zt, float zb, bool zbl, int mitBar) =>
    bool found = false
    if array.size(ofZone) > 0
        for i = 0 to array.size(ofZone) - 1
            if not found and not array.get(ofMit, i) and array.get(ofBull, i) == zbl
                // BO LOC THOI DIEM — OF khung nho phai DA TON TAI TRUOC khi vung khung lon
                // bi khai thac. Doc `ofConfBar` (nen XAC NHAN) chu khong doc mep trai: mep
                // trai la nen chan hoi, con vung chi thuc su ton tai tu luc xac nhan.
                int cf = 0
                if i < array.size(ofConfBar)
                    cf := array.get(ofConfBar, i)
                if cf < mitBar
                    [ot, ob, ol] = marginZone(array.get(ofZone, i))
                    bool inside = ot <= zt and ob >= zb
                    bool edgeOk = zbl ? (ot > zt and ob < zt and ob >= zb) : (ob < zb and ot > zb and ot <= zt)
                    if inside or edgeOk
                        found := true
    found

// Ban sao cua `ofNestVerdict`, doc mang cua khung lon. Dung chung `atShrinkEdge` nen it nhat
// phan hinh hoc cua luat thu hep khong the lech giua hai engine.
// 0 = ve · 1 = loai (nam trong OF truoc) · 2 = loai (ban rong) · 3 = ve va don vung rong
htfNestVerdict(float top, float bot, bool isBull, int leftBar) =>
    bool killN  = false
    bool killT  = false
    bool shrink = false
    // Duyet TOAN BO ho so, ke ca vung da bi khai thac (hinh ve da xoa nhung ho so con) —
    // y het engine chinh duyet ca vung xam trong `ofZone`.
    if array.size(hzTop) > 0
        for i = 0 to array.size(hzTop) - 1
            if array.get(hzBull, i) == isBull
                float zt = array.get(hzTop, i)
                float zb = array.get(hzBot, i)
                int   zl = array.get(hzLeft, i)
                int   zc = array.get(hzConf, i)
                if zl < leftBar and top <= zt and bot >= zb
                    if atShrinkEdge(top, bot, isBull, zt, zb)
                        shrink := true
                    else if zc < leftBar
                        killN := true
                if zl > leftBar and zt <= top and zb >= bot
                    killT := true
    shrink ? 3 : killN ? 1 : killT ? 2 : 0

htfShrinkWide(float top, float bot, bool isBull, int leftBar) =>
    if array.size(hzTop) > 1
        for i = array.size(hzTop) - 2 to 0
            if array.get(hzBull, i) == isBull
                float zt = array.get(hzTop, i)
                float zb = array.get(hzBot, i)
                if array.get(hzLeft, i) < leftBar and top <= zt and bot >= zb and atShrinkEdge(top, bot, isBull, zt, zb)
                    htfRemoveZone(i)

// `hAtr` phai la ATR cua CHINH khung lon, khong phai atrSw cua chart — neu khong thi bo loc
// kich thuoc se do chan hoi 4H bang thuoc cua nen 15m.
htfAddCand(int left, float top, float bot, bool isBull, float hAtr) =>
    if not na(top) and not na(bot) and not na(left) and top > bot and top - bot >= ofMinLeg * hAtr
        bumpH(0, isBull)
        array.push(hcTop , top)
        array.push(hcBot , bot)
        array.push(hcBar , left)
        array.push(hcBull, isBull)
        array.push(hcAge , 0)
        array.push(hcRef , na)

// Sau thay doi nay, trong ca file chi con DUNG HAI thu thuc su xoa mot vung DA VE:
//   1) gia quet qua BIEN GIU  (khoi A)
//   2) nap cung OF_HARD_CAP   (trimOF)
// Con lai duy nhat mot quyet dinh HIEN THI la han ngach top N o khoi (A3) — no chi AN,
// tinh lai moi nen, va go ra duoc.

// Day 1 UNG VIEN. Chua ve gi — cho gia pha bien xa moi thanh OF that (dieu kien #1).
addOFCand(int left, float top, float bot, bool isBull) =>
    // Bo loc KICH THUOC: chan hoi phai la mot NHIP, khong phai mot cai ngoay 2-3 nen.
    // Day la goc re cua nghich ly 've rat nhieu vung ma cuoi cung khong con vung nao':
    // mat do 778 ung vien / ~1100 nen khien vung nao cung ti hon => bi rau quet ngay sau
    // vai nen, va con nuot ca nhung vung TO hop le qua luat long nhau.
    if showOF and not na(top) and not na(bot) and not na(left) and top > bot and top - bot >= ofMinLeg * atrSw
        bumpStat(0, isBull)
        int cid = nextOFId()
        array.push(ofCId  , cid)
        array.push(ofCTop , top)
        array.push(ofCBot , bot)
        array.push(ofCBar , left)
        array.push(ofCBull, isBull)
        array.push(ofCAge , 0)
        array.push(ofCRef , na)
        // HOP MA (debug): ung vien chua phai OF nen ve vien DUT va mo hon vung that.
        // Khong bat debug thi van PHAI push `na` de hai mang nay chay song song voi ofCTop —
        // lech mot phan tu la moi thu ben duoi tro chi nham ung vien.
        box   gb = na
        label gl = na
        if ofDbgGhost
            color gcBorder = color.new(isBull ? colorOFBull : colorOFBear, 40)
            gb := box.new(left = left, top = top, right = time, bottom = bot, xloc = xloc.bar_time,
                 bgcolor = color.new(isBull ? colorOFBull : colorOFBear, 92),
                 border_color = gcBorder, border_style = line.style_dashed)
            // Nhan neo tai BIEN XA — dung cai muc gia ma gia phai DONG NEN vuot qua
            // thi ung vien moi thanh OF (dieu kien #1). Nhin la biet no con cach dich bao xa.
            gl := label.new(left, isBull ? top : bot, "", xloc.bar_time, color = transp,
                 textcolor = color.new(color.white, 25),
                 style = isBull ? label.style_label_down : label.style_label_up, size = size.tiny)
        array.push(ofCBox, gb)
        array.push(ofCLbl, gl)
        logOF("sinh", isBull, cid, isBull ? top : bot)

// Pivot MOI xac nhan vuot qua bien GIU cua vung => cau truc da phu nhan vung, xoa.
// (Rau nen choc qua thi khong giet vung — viec do de vong doi ben duoi lo.)
invalidateOFByPivot(bool isHighPivot, float p) =>
    if ofInvalidPivot and array.size(ofZone) > 0
        for i = array.size(ofZone) - 1 to 0
            if not array.get(ofMit, i)
                [t, b, l] = marginZone(array.get(ofZone, i))
                bool isBull = array.get(ofBull, i)
                if (isHighPivot and not isBull and t < p) or (not isHighPivot and isBull and b > p)
                    bumpStat(2, isBull)
                    removeOF(i, "V")
//#endregion

//#region Pullback  — GIỮ NGUYÊN của Trading Hub 3
// Sau khi thay engine, pullback không còn nuôi IDM nữa. Giữ lại làm nguồn dữ liệu
// cho #9 (Order Flow) và #16 (SCOB tại pullback). Xem mục #1 trong tài liệu biến thể.
if high >= top and low <= bot //notrend
    if mnStrc != MN_NA
        prevMnStrc := mnStrc

    if prevMnStrc == MN_UP
        top_ := top
        bar_ := bar
    else
        bot_ := bot
        bar_ := bar

    top :=   high
    bot :=   low
    bar :=   time
    mnStrc   := MN_NA

if high >= top and low > bot //uptrend
    if prevMnStrc == MN_UP and mnStrc == MN_NA
        array.push(puHBar, bar_)
        array.push(puHigh, top_)
        array.push(puLBar, bar)
        array.push(puLow, bot)
        drawPullback(bar_, top_, true)
        drawPullback(bar, bot, false)
        invalidateOFByPivot(true , top_)
        invalidateOFByPivot(false, bot)
        // OF DEMAND = tron chan hoi vua ket thuc: [day hoi, dinh ngay truoc no]
        if not ofOnlyRetrace or (not na(prevPivotLow) and bot > prevPivotLow)
            addOFCand(bar_, top_, bot, true)
        prevPivotHigh := top_
        prevPivotLow  := bot
    else if (prevMnStrc == MN_DN and mnStrc == MN_NA) or mnStrc == MN_DN
        array.push(puLBar, bar)
        array.push(puLow, bot)
        drawPullback(bar, bot, false)
        invalidateOFByPivot(false, bot)
        if not ofOnlyRetrace or (not na(prevPivotLow) and bot > prevPivotLow)
            [ofT, ofTBar] = findPivotBefore(puHigh, puHBar, bar)   // dinh phai co TRUOC day vua chot
            if not na(ofT)
                addOFCand(math.min(ofTBar, bar), ofT, bot, true)
        prevPivotLow := bot

    top := high
    bot := low
    bar := time
    prevMnStrc := MN_NA
    mnStrc := MN_UP

if high < top and low <= bot //downtrend
    if prevMnStrc == MN_DN and mnStrc == MN_NA
        array.push(puHBar, bar)
        array.push(puHigh, top)
        array.push(puLBar, bar_)
        array.push(puLow, bot_)
        drawPullback(bar, top, true)
        drawPullback(bar_, bot_, false)
        invalidateOFByPivot(true , top)
        invalidateOFByPivot(false, bot_)
        // OF SUPPLY = tron chan hoi vua ket thuc: [day ngay truoc, dinh hoi]
        if not ofOnlyRetrace or (not na(prevPivotHigh) and top < prevPivotHigh)
            addOFCand(bar_, top, bot_, false)
        prevPivotHigh := top
        prevPivotLow  := bot_
    else if (prevMnStrc == MN_UP and mnStrc == MN_NA) or mnStrc == MN_UP
        array.push(puHBar, bar)
        array.push(puHigh, top)
        drawPullback(bar, top, true)
        invalidateOFByPivot(true, top)
        if not ofOnlyRetrace or (not na(prevPivotHigh) and top < prevPivotHigh)
            [ofB, ofBBar] = findPivotBefore(puLow, puLBar, bar)    // day phai co TRUOC dinh vua chot
            if not na(ofB)
                addOFCand(math.min(ofBBar, bar), top, ofB, false)
        prevPivotHigh := top

    top := high
    bot := low
    bar := time
    prevMnStrc := MN_NA
    mnStrc := MN_DN

trimArr(puHigh)
trimArr(puHBar)
trimArr(puLow)
trimArr(puLBar)
//#endregion

//#region ===== ENGINE CẤU TRÚC — LUXALGO =====================================
// Nguồn: Document/smc_structure_luxalgo dòng 33-165.
// Khác bản gốc LuxAlgo: dùng xloc.bar_time thay cho bar_index để đồng bộ với POI/OB
// và để chiếu được đường "live" ra tương lai.

swings(int length) =>
    var int os = 0
    var int topx = na
    var int btmx = na

    upper = ta.highest(length)
    lower = ta.lowest(length)

    os := high[length] > upper ? 0 : low[length] < lower ? 1 : os[1]

    top = os == 0 and os[1] != 0 ? high[length] : na
    topx := os == 0 and os[1] != 0 ? time[length] : topx

    btm = os == 1 and os[1] != 1 ? low[length] : na
    btmx := os == 1 and os[1] != 1 ? time[length] : btmx

    [top, topx, btm, btmx]

[swTop, swTopBar, swBtm, swBtmBar] = swings(chochLen)

// mốc CHoCH (swing thô, chochLen nến)
var float chTop = na
var float chBtm = na
var int   chTopBar = na
var int   chBtmBar = na
var bool  topCrossed = false
var bool  btmCrossed = false

// bar của mốc IDM gần nhất mỗi chiều — chỉ để chặn vẽ 2 nhãn trùng chỗ
var int lastIdmUpBar = na
var int lastIdmDnBar = na

// ===== IDM theo ĐỊNH NGHĨA BANKTRAP (không phải fractal của LuxAlgo) =========
// Trang 3 : "IDM xảy ra khi giá vượt qua PULLBACK ĐẦU TIÊN — H là đỉnh cao nhất, từ đó
//            gióng sang trái sẽ gặp 1 PB đầu tiên". Xác nhận bằng RÂU, không cần đóng nến.
// Trang 4 : "vị trí IDM vẫn KHÔNG thay đổi cho đến khi: (1) BOS, (2) tạo đỉnh mới cao hơn,
//            (3) CHoCH"  => chỉ neo lại khi có đỉnh/đáy MỚI.
// Trang 9 : "Pullback đầu tiên SAU khi có BOS".
//
// QUY TRÌNH: CHỈ tại nến ĐÓNG tạo BOS mới quay lại tìm pullback đầu tiên. Xác định một lần,
// KHÔNG dời theo đỉnh/đáy mới nữa — nếu dời thì mốc bị kéo dần về các pullback vi mô sát đáy
// và mốc đúng ban đầu biến mất. Mốc đã đặt sẽ nằm lại trên chart tới khi giá quay về quét.

// pullback gần nhất trong hàng đợi — nguồn duy nhất để neo IDM
lastPbLo    = getNLastValue(puLow , 1)
lastPbLoBar = getNLastValue(puLBar, 1)
lastPbHi    = getNLastValue(puHigh, 1)
lastPbHiBar = getNLastValue(puHBar, 1)

//--- Cập nhật mốc CHoCH khi có swing mới ------------------------------------
// Tên nhãn theo LuxAlgo SMC (getCurrentStructure): so với swing CÙNG LOẠI liền trước.
// chTop/chBtm lúc này vẫn đang giữ giá trị swing trước đó => so xong mới ghi đè.
if not na(swTop)
    if showSwings
        addSwingDot(swTopBar, swTop, na(chTop) or swTop > chTop ? 'HH' : 'LH', true)
    chTop := swTop
    chTopBar := swTopBar
    topCrossed := false

if not na(swBtm)
    if showSwings
        addSwingDot(swBtmBar, swBtm, na(chBtm) or swBtm < chBtm ? 'LL' : 'HL', false)
    chBtm := swBtm
    chBtmBar := swBtmBar
    btmCrossed := false

//--- Bảo trì các mốc IDM đang chờ bị quét -----------------------------------
// Chưa quét  -> kéo dài đường sang nến hiện tại (mốc vẫn còn hiệu lực).
// Đã quét    -> ngừng theo dõi, nét vẽ đứng lại tại nến quét. Xác nhận bằng RÂU (trang 3).
if array.size(idmLvlArr) > 0
    for i = array.size(idmLvlArr) - 1 to 0
        lvl  = array.get(idmLvlArr, i)
        isUp = array.get(idmUpArr , i)
        ln   = array.get(idmLnArr , i)
        lb   = array.get(idmLbArr , i)
        if (isUp ? low < lvl : high > lvl)
            array.remove(idmLnArr , i)
            array.remove(idmLbArr , i)
            array.remove(idmLvlArr, i)
            array.remove(idmUpArr , i)
        else
            line.set_x2(ln, time)
            label.set_x(lb, textCenter(time, line.get_x1(ln)))

//--- CHoCH / BOS — MỘT sự kiện duy nhất, bias quyết định tên -----------------
// Công thức SMC chuẩn (Smart Money Concepts [LuxAlgo] dòng 568-569):
//     tag = t_rend.bias == BEARISH ? CHOCH : BOS
// Mốc LUÔN là điểm swing có nhãn: phá lên = chTop (HH/LH), phá xuống = chBtm (LL/HL).
// `topCrossed`/`btmCrossed` lo việc chống lặp — mỗi mốc swing chỉ bắn ĐÚNG MỘT LẦN,
// nên không cần chốt arm fractal như bản "Market Structure w/ Inducements" nữa.
if not na(chTop) and close > chTop and not topCrossed
    txt = os == 0 ? CHOCH_TEXT : BOS_TEXT     // phải tính TRƯỚC khi đổi os
    if txt == CHOCH_TEXT ? showChoCh : showBOS
        drawStrc(txt, chTopBar, chTop, true)
    topCrossed := true
    os := 1
    // Chỉ BOS mới sinh IDM (CHoCH thì không) — nến đóng BOS mới quay lại tìm PB đầu tiên.
    // Chỉ tạo nếu neo vào pullback KHÁC lần trước, nếu không sẽ có 2 chữ IDM chồng chỗ.
    if txt == BOS_TEXT and showIDM and not na(lastPbLoBar) and (na(lastIdmUpBar) or lastPbLoBar != lastIdmUpBar)
        addIdm(lastPbLoBar, lastPbLo, true)
        lastIdmUpBar := lastPbLoBar

if not na(chBtm) and close < chBtm and not btmCrossed
    txt = os == 1 ? CHOCH_TEXT : BOS_TEXT
    if txt == CHOCH_TEXT ? showChoCh : showBOS
        drawStrc(txt, chBtmBar, chBtm, false)
    btmCrossed := true
    os := 0
    if txt == BOS_TEXT and showIDM and not na(lastPbHiBar) and (na(lastIdmDnBar) or lastPbHiBar != lastIdmDnBar)
        addIdm(lastPbHiBar, lastPbHi, false)
        lastIdmDnBar := lastPbHiBar

//--- Đường "live": hai mốc swing đang chờ bị phá ----------------------------
// Chỉ còn ĐÚNG 2 mốc: chTop phía trên và chBtm phía dưới. Tên nhãn đổi theo bias — cùng
// một mốc sẽ là BOS nếu phá thuận chiều, CHoCH nếu phá ngược chiều.
// Không có live-IDM: mỗi mốc IDM chưa bị quét đã tự kéo dài tới nến hiện tại ở khối bảo trì.
var line  liveUpLn  = na
var line  liveDnLn  = na
var label liveUpLbl = na
var label liveDnLbl = na

if barstate.islast
    line.delete(liveUpLn), line.delete(liveDnLn)
    label.delete(liveUpLbl), label.delete(liveDnLbl)

    if showLive
        // đường live dùng xloc.bar_index để chiếu thẳng ra tương lai — không phụ thuộc
        // khoảng cách thời gian giữa các nến (an toàn với phiên nghỉ / cuối tuần)
        x2 = bar_index + liveLen

        upTxt = os == 1 ? BOS_TEXT : CHOCH_TEXT
        dnTxt = os == 1 ? CHOCH_TEXT : BOS_TEXT

        // `not topCrossed` : mốc đã bị tiêu thụ thì không còn là mốc đang chờ nữa
        if not na(chTop) and not topCrossed and (upTxt == CHOCH_TEXT ? showChoCh : showBOS)
            liveUpLn  := line.new(bar_index, chTop, x2, chTop, xloc.bar_index, color = bull,
                 style = upTxt == BOS_TEXT ? line.style_solid : line.style_dashed)
            liveUpLbl := label.new(x2, chTop, upTxt, xloc.bar_index, color = transp,
                 textcolor = bull, style = label.style_label_down, size = size.small)

        if not na(chBtm) and not btmCrossed and (dnTxt == CHOCH_TEXT ? showChoCh : showBOS)
            liveDnLn  := line.new(bar_index, chBtm, x2, chBtm, xloc.bar_index, color = bear,
                 style = dnTxt == BOS_TEXT ? line.style_solid : line.style_dashed)
            liveDnLbl := label.new(x2, chBtm, dnTxt, xloc.bar_index, color = transp,
                 textcolor = bear, style = label.style_label_up, size = size.small)
//#endregion

//#region POI  — GIỮ NGUYÊN của Trading Hub 3
if showPOI
    if not isSweepOBS
        high_MOBS := high[3]
        low_MOBS := low[3]
        current_OBS := time[3]
        if high_MOBS > high[4] and high_MOBS > high[2]
            isSweepOBS := true
    else
        if low_MOBS > high[1]
            handleZone(supplyZone, supplyMit, current_OBS, high_MOBS, low_MOBS, colorSupply)
            isSweepOBS := false
        else
            if poi_type == "Mother Bar" and isb[2]
                high_MOBS := math.max(high_MOBS,motherHigh[2])
                low_MOBS := math.min(low_MOBS,motherLow[2])
                current_OBS := math.min(current_OBS,motherBar)
            else
                high_MOBS := high[2]
                low_MOBS := low[2]
                current_OBS := time[2]

    if not isSweepOBD
        low_MOBD := low[3]
        high_MOBD := high[3]
        current_OBD := time[3]
        if low_MOBD < low[4] and low_MOBD < low[2]
            isSweepOBD := true
    else
        if high_MOBD < low[1]
            handleZone(demandZone, demandMit, current_OBD, high_MOBD, low_MOBD, colorDemand)
            isSweepOBD := false
        else
            if poi_type == "Mother Bar" and isb[2]
                high_MOBD := math.max(high_MOBD,motherHigh[2])
                low_MOBD := math.min(low_MOBD,motherLow[2])
                current_OBD := math.min(current_OBD,motherBar)
            else
                high_MOBD := high[2]
                low_MOBD := low[2]
                current_OBD := time[2]
//#endregion

//#region run function
barcolor(showSCOB ? scob(supplyZone, true) : na, -1)
barcolor(showSCOB ? scob(demandZone, false) : na, -1)
processZones(supplyZone, supplyMit, true)
processZones(demandZone, demandMit, false)
// Cat bot SAU khi processZones da cap nhat co mitigated cua nen nay.
trimZoneArr(supplyZone, supplyMit, maxPOIShow, maxPOIMit)
trimZoneArr(demandZone, demandMit, maxPOIShow, maxPOIMit)

// ===== ORDER FLOW =========================================================
// (A) VONG DOI — chay TRUOC khoi xac nhan de vung vua sinh khong bi cham mitigated
//     ngay tren chinh nen xac nhan no. Cach xu ly copy nguyen tu processZones cua POI:
//     xuyen han bien giu -> XOA; gia quay lai cham vao trong -> XAM + ngung keo dai.
if array.size(ofZone) > 0
    for i = array.size(ofZone) - 1 to 0
        [t, b, l] = marginZone(array.get(ofZone, i))
        bool bl = array.get(ofBull, i)
        // `ofSweepClose` doi RAU thanh GIA DONG CUA o ca ba cho dung chung luat nay.
        float swDn = ofSweepClose ? close : low
        float swUp = ofSweepClose ? close : high
        if (time - l > len * maxBarHistory) or (bl and swDn < b) or (not bl and swUp > t)
            // QUET qua bien giu => vung chet han, xoa. Dung RAU nen chu khong doi dong nen,
            // giong het luat "Delete sweep zones" cua POI.
            // OF-D: rau thung DAY vung.  OF-S: rau vuot DINH vung.
            bumpStat(5, bl)
            removeOF(i, "Q")
        else
            // KHAI THAC = ROI HAN KHOI VUNG ROI QUAY LAI. Tai lieu trang 26 noi dung trinh tu:
            // "sau khi gia giam xuong KHOI OF1 VA DI LEN KHAI THAC OF1 roi lai tiep tuc xu huong".
            // Ban truoc chi can MOT cay nen co bien do cham vao vung la danh dau da khai thac —
            // ke ca nhung nen ngay sau khi ve, luc gia con dang roi di. Hau qua: vung nao cung
            // thanh xam gan nhu ngay lap tuc, va co song/xam mat sach y nghia.
            // Gio phai qua HAI buoc: (1) co mot cay nen nam TRON ben ngoai vung  (2) sau do quay lai cham.
            bool away = bl ? low > t : high < b
            bool leftYet = false
            if i < array.size(ofLeft)
                leftYet := array.get(ofLeft, i)
            // Ghi cuc tri ngay tu nen `away` DAU TIEN. Phai dat TRUOC chuoi if/else ben duoi
            // vi hai nhanh do loai tru nhau, nhet vao trong thi se bo sot mot nua so nen.
            if (away or leftYet) and i < array.size(ofExtr)
                float exOld = array.get(ofExtr, i)
                float exNow = bl ? low : high
                array.set(ofExtr, i, na(exOld) ? exNow : (bl ? math.min(exOld, exNow) : math.max(exOld, exNow)))
            if away
                if i < array.size(ofLeft)
                    array.set(ofLeft, i, true)
            else if leftYet and high >= b and low <= t
                // HAI MUC DO KHAI THAC, CO Y TACH RIENG — moi thu nuoi mot thu khac:
                //
                //  (1) CHAM  — rau cham vao la du. Dieu khien MAU: vung chuyen XAM ngay.
                //      Gia da mo duong vao vung roi, no khong con "nguyen ven" nua.
                //
                //  (2) THAN NEN trong vung — gia DONG CUA hoac MO CUA nam trong [day, dinh].
                //      Dieu khien MEP PHAI: hop dung lai tai day, va dung o LAN DAU TIEN.
                //      Ly do tach ra: rau chi QUET qua vung trong giay lat, con than nen moi
                //      la gia that su da giao dich BEN TRONG vung. Chi bi rau quet thi vung
                //      van con dang cho, nen mep phai phai di tiep toi nen hien tai.
                //
                //      CHI AP DUNG TU TREN 1H. O khung <= 1H thi `ofWickEnds` cho buoc (2)
                //      trung voi buoc (1): rau cham la xam va chot mep phai cung mot luc.
                //      Xem chu thich o cho khai bao `ofWickEnds`.
                array.set(ofMit, i, true)
                // `ofWickEnds` lam tat buoc cho than nen o khung <= 1H: vua cham la chot.
                bool bodyIn = ofWickEnds or (close <= t and close >= b) or (open <= t and open >= b)
                bool bodyYet = false
                if i < array.size(ofBody)
                    bodyYet := array.get(ofBody, i)
                if bodyIn and not bodyYet
                    if i < array.size(ofBody)
                        array.set(ofBody, i, true)
                    // Chot MOT LAN roi thoi — day la moc "lan khai thac dau tien", khong phai
                    // lan cham gan nhat. Dieu kien `not bodyYet` o tren lo viec do.
                    array.set(ofTouch, i, time)

// (A2) DA BI XOA. No tung tim "vung TUYEN DAU" moi chieu — vung co dinh cao nhat (OF-D) /
//      day thap nhat (OF-S) — roi cho rieng vung do GIU MAU du da bi khai thac, voi ly do
//      "day la vung gia se gap truoc tien neu quay dau lai".
//
//      Bo di vi no hoi sai cau hoi: no hoi vung nao GAN gia nhat, khong hoi vung do CON GI
//      DE GAP hay khong. Tai lieu trang 42 noi thang: "OB2 da bi OB3 khai thac. Khi gia quay
//      ve khai thac OB2 KHONG NEN SELL vi o tren con co OB1 CHUA BI KHAI THAC" — vung da tieu
//      khong phai la dich, ke ca khi no nam gan gia nhat. Luat cu dang to mau dam nhat cho
//      dung cai vung ma tai lieu bao dung de y.
//
//      Gio chi con mot cau hoi duy nhat: DA BI KHAI THAC CHUA. Xem `armed` o khoi (A3).

// (A2b) DA BI XOA. No tung AN vung CU bao ngoai khi co vung MOI nam gon ben trong — tuc
//       lam NGUOC chieu dieu kien #2 cua tai lieu (trang 26: cai bi loai la OF MOI ben trong).
//       Luat do gio nam o `ofNestVerdict`, chay tai khoi (B) va LOAI ung vien sai thay vi AN
//       vung dung. Nho vay khong con thu gi lam vung bien mat ma khong de lai bia mo.

// (A3) TO MAU. Vung CHUA BI KHAI THAC thi sang mau va keo dai toi nen hien tai.
//      Vung DA BI KHAI THAC thi xam, mep phai dung lai o LAN CHAM CUOI CUNG — khong con
//      ngoai le "tuyen dau" nua (xem khoi A2 da bi xoa).
//      Ket qua thi truc quan hon han: mau = con hieu luc, xam = da tieu. Khong con canh
//      mot vung xam van do ruc chi vi no tinh co nam gan gia nhat.
//
//      DEBUG: khoi nay cung la noi DUY NHAT biet mot vung dang hien hay dang bi an va vi sao.
//      Ket luan do duoc chup lai vao ofVisA / ofRankA de bang soi doc, thay vi de bang soi
//      tu dien giai lai bo luat mot lan nua.
array.clear(ofVisA)
array.clear(ofRankA)
if array.size(ofZone) > 0
    for i = 0 to array.size(ofZone) - 1
        box   zOF  = array.get(ofZone, i)
        bool  bl2  = array.get(ofBull, i)
        bool  mit2 = array.get(ofMit , i)
        float di   = ofDist(zOF)
        // HAN NGACH = BO LOC HIEN THI, KHONG PHAI XOA.
        // Dem xem co bao nhieu vung CUNG CHIEU, CUNG TRANG THAI dang GAN gia hon no.
        // Duoi nguong thi hien; qua nguong thi AN di nhung VAN GIU trong mang => khi cac
        // vung gan hon chet di, no tu dong hien lai.
        // Ban truoc XOA HAN o trimOF: mot vung bi day khoi top 5 la mat VINH VIEN, du sau do
        // chi con 2 vung. Dung cai da lam bay OF 2 va OF 3 tren BTCUSDT 4H — bia mo D!K.
        // Sau khi bo (A2b), day la BO LOC HIEN THI DUY NHAT con lai, va phep dem cung don
        // gian han han: khong con phai loai tru vung bi long ra khoi phep dem nua.
        int rank = 0
        for j = 0 to array.size(ofZone) - 1
            if j != i and array.get(ofBull, j) == bl2 and array.get(ofMit, j) == mit2
                float dj = ofDist(array.get(ofZone, j))
                if dj < di or (dj == di and j < i)
                    rank += 1
        bool  overQ = rank >= (mit2 ? maxOFMit : maxOFShow)
        // HAI KHAI NIEM, TACH BACH:
        //   vis     = vung nay CO duoc ve khong khi TAT SACH debug. SU THAT. Chi mot minh no
        //             duoc ghi vao anh chup, nen bang soi va tooltip luon bao cao su that
        //             ke ca khi dang bat che do hien tat ca.
        //   visDraw = co dang ve that tren chart NGAY LUC NAY, sau khi cong cac cong tac debug.
        bool  vis     = not overQ
        bool  visDraw = ofDbgOn or vis
        array.push(ofRankA, rank)
        array.push(ofVisA , vis)
        // MAU va MEP PHAI do HAI dieu kien KHAC NHAU quyet dinh — dung gop lam mot:
        //    MAU      <- da bi CHAM chua (rau cung tinh)        -> `armed`
        //    MEP PHAI <- da co THAN NEN nam trong vung chua     -> `frozen`
        // Vung moi bi rau quet: XAM nhung VAN KEO DAI, vi gia chua thuc su vao trong vung.
        // Vung da co than nen ben trong: xam va mep phai dung han tai LAN DAU co than nen.
        bool  armed  = not mit2
        bool  frozen = false
        if i < array.size(ofBody)
            frozen := array.get(ofBody, i)
        color colOF = not visDraw ? transp : armed ? (bl2 ? colorOFBull : colorOFBear) : colorMitigated
        int   rgtOF = frozen ? array.get(ofTouch, i) : time
        box.set_right(zOF, rgtOF)
        box.set_extend(zOF, extend.none)
        box.set_bgcolor(zOF, colOF)
        box.set_border_color(zOF, colOF)
        // TUOI = so nen tu MEP TRAI (nen mui ten pullback da sinh ra vung) den nen hien tai.
        // Phai cap nhat moi nen vi tuoi tang dan. len = do dai 1 nen tinh bang ms.
        int   ageOF = int((time - box.get_left(zOF)) / len)
        label lbOF  = array.get(ofLbl, i)
        // Doc mang PHAI di kem kiem tra kich thuoc bang `if` chu khong bang bieu thuc ba ngoi:
        // toan tu ba ngoi cua Pine khong dam bao bo qua nhanh khong duoc chon, va mot lan
        // array.get vuot chi so la ca indicator dung lai.
        int   zid   = 0
        if i < array.size(ofId)
            zid := array.get(ofId, i)
        // DAU HIEU  !  = "vung nay dang duoc ve, nhung o che do THAT thi no bi day khoi top N".
        // Nhan tron = vung van hien binh thuong khi tat het debug.
        // Dau  *  cua (A2b) da bo cung voi chinh khoi do.
        string mkOF = overQ ? "! " : ""
        // CHE DO SOI — in THANG len nhan: da ROI han khoi vung chua, va DINH/DAY that.
        //   R   = da co it nhat mot cay nen nam TRON ben ngoai vung  (buoc 1 da chay)
        //   --  = CHUA  => buoc 2 (quay lai cham) khong duoc xet, vung khong the chuyen xam
        // Ba con so nay quyet dinh toan bo phep thu khai thac va KHONG doan duoc bang mat.
        // Khong de chung trong tooltip: tooltip doi chuot trung dung cai nhan ti hon o mep
        // trai vung, con bang soi thi chi liet ke top N gan gia nhat — vung cu o xa hang tram
        // diem khong bao gio lot vao ca hai duong do.
        bool leftOF = false
        if i < array.size(ofLeft)
            leftOF := array.get(ofLeft, i)
        float extOF = na
        if i < array.size(ofExtr)
            extOF := array.get(ofExtr, i)
        string txOF = mkOF + (bl2 ? OFD_TEXT : OFS_TEXT) + "-" + str.tostring(ageOF)
        if ofDbgTip
            txOF := txOF + "  "
                 + str.tostring(box.get_top(zOF), format.mintick) + "/"
                 + str.tostring(box.get_bottom(zOF), format.mintick)
        label.set_text(lbOF, visDraw ? txOF : "")
        label.set_textcolor(lbOF, ofLabelOn and visDraw ? color.white : na)
        // HO SO VUNG — gan vao chinh cai nhan san co nen khong ton them nhan nao.
        // Doc duoc ca nhung con so KHONG the in ra chart: thu hang trong han ngach va
        // ly do chinh xac khien vung bi an.
        if ofDbgTip
            label.set_tooltip(lbOF,
                 "#" + str.tostring(zid) + "  "
                 + (bl2 ? OFD_TEXT : OFS_TEXT)
                 + "\ndinh " + str.tostring(box.get_top(zOF), format.mintick)
                 + "  /  day " + str.tostring(box.get_bottom(zOF), format.mintick)
                 + "\ntuoi " + str.tostring(ageOF) + " nen   ·   cach gia "
                 + str.tostring(di, format.mintick)
                 + "\nthu hang " + str.tostring(rank) + "  (nguong "
                 + str.tostring(mit2 ? maxOFMit : maxOFShow) + ")"
                 + "\ntrang thai THAT (khi tat het debug): "
                 + (overQ ? "AN — bi day khoi top " + str.tostring(mit2 ? maxOFMit : maxOFShow)
                   : mit2 ? "XAM — da bi cham it nhat mot lan"
                   : "HIEN — chua bi cham")
                 + (visDraw and not vis ? "\n(ban dang thay no chi vi mot cong tac debug)" : "")
                 + (armed ? "\nmau: con hieu luc, chua bi cham"
                          : "\nmau: XAM, da bi cham it nhat mot lan")
                 + (leftOF ? "\nbuoc 1 (roi vung): XONG — da co nen nam TRON ngoai vung"
                           : "\nbuoc 1 (roi vung): CHUA co nen nao nam TRON ngoai vung => cham vao chua tinh khai thac")
                 + (leftOF and not na(extOF)
                      ? "\nke tu luc roi vung, gia ve gan nhat toi " + str.tostring(extOF, format.mintick)
                           + "  (phai cham " + str.tostring(bl2 ? box.get_top(zOF) : box.get_bottom(zOF), format.mintick)
                           + " moi tinh)"
                      : "")
                 + (frozen ? (ofWickEnds ? "\nmep phai: dung tai lan CHAM dau tien (khung <= 1H, rau la du)"
                                         : "\nmep phai: dung tai LAN DAU co than nen trong vung")
                   : mit2 ? "\nmep phai: van keo dai, moi bi rau quet, chua co than nen"
                       : "\nmep phai: van keo dai, vung CHUA bi cham lan nao"))

// (B) UNG VIEN -> OF THAT. Dieu kien #1: DONG NEN vuot bien xa. Qua han thi huy.
if showOF and array.size(ofCTop) > 0
    for i = array.size(ofCTop) - 1 to 0
        float ct = array.get(ofCTop, i)
        float cb = array.get(ofCBot, i)
        bool  cl = array.get(ofCBull, i)
        int   ag = array.get(ofCAge, i) + 1
        int   cid = 0
        if i < array.size(ofCId)
            cid := array.get(ofCId, i)
        array.set(ofCAge, i, ag)
        // Tai lieu, muc "OF khong hop le": trong xu huong giam, neu TRUOC khi pha day ma
        // gia lai pha dinh truoc thi day KHONG phai OF. Doi xung cho chieu tang.
        //
        // KHONG DOI XUNG - CO Y:
        //   confirmed dung CLOSE : tai lieu doi DONG NEN vuot qua moi tinh la pha (dieu kien #1).
        //   wrongWay  dung RAU   : phai giong het luat XOA cua vung da ve (khoi A). Chi can mot
        //     cai rau xuyen qua bien GIU la chan hoi do da bi phu nhan, khong doi dong nen.
        // Moc pha = bien xa, HOAC cuc tri cua cac nen da quet rau qua bien xa ma chua dong
        // than qua (trang 7). Doc moc CU truoc roi moi cap nhat bang nen nay — rau cua chinh
        // cay nen dang xet khong duoc tu nang moc cua no.
        float swRef = na
        if i < array.size(ofCRef)
            swRef := array.get(ofCRef, i)
        float brkLv = cl ? (na(swRef) ? ct : math.max(ct, swRef)) : (na(swRef) ? cb : math.min(cb, swRef))
        bool  confirmed = cl ? close > brkLv : close < brkLv
        bool  wrongWay  = cl ? (ofSweepClose ? close : low) < cb : (ofSweepClose ? close : high) > ct
        if not confirmed and i < array.size(ofCRef)
            if cl and high > brkLv
                array.set(ofCRef, i, high)
            else if not cl and low < brkLv
                array.set(ofCRef, i, low)
        if confirmed or wrongWay or ag > ofConfirmBars
            // RAU THANG DONG NEN khi ca hai xay ra TREN CUNG MOT CAY NEN.
            // Truoc day `confirmed` thang => mot cay nen do lon vua rau vuot DINH nhip hoi
            // vua dong cua duoi DAY van sinh ra OF-S. Sai o hai diem:
            //  1) Trai luat tai lieu ("OF khong hop le"): dinh cua nhip hoi da bi vuot thi
            //     no khong con la nhip hoi nua, chan do khong phai OF.
            //  2) Mau thuan noi bo: DUNG cay nen do se XOA mot vung da ve (khoi A dung
            //     `high > t`). Khong the vua du suc giet vung cu vua duoc phep sinh vung moi.
            //     Nang hon: khoi A chi soi tu nen SAU nen tao vung, nen cai rau vi pham do
            //     KHONG BAO GIO duoc kiem tra lai — vung sinh ra da sai san va song mai.
            // Doi xung cho OF-D: rau thung DAY pullback + dong nen tren DINH.
            bool ok = confirmed and not wrongWay
            // DIEU KIEN #2 + LUAT THU HEP — kiem tra DUNG O DAY, khong phai luc to mau.
            // Chi hoi khi ung vien da qua duoc dieu kien #1: chua xac nhan thi no chua phai
            // mot OF, khong co gi de dem ra so voi OF truoc ca.
            // Xem chu thich day du o cho khai bao `ofNestVerdict`.
            int nestV = 0
            if ok
                nestV := ofNestVerdict(ct, cb, cl, array.get(ofCBar, i))
            // Verdict 3 KHONG loai ung vien — no la ban thu hep, van duoc ve, va sau khi ve
            // xong thi don cac vung rong di. Chi 1 va 2 moi giet ung vien.
            if nestV == 1 or nestV == 2
                ok := false
            // Thu tu uu tien phai giu dung the nay: pha nham (P) la vi pham dieu kien #1 nen
            // xet truoc; het han (H) la truong hop chua bao gio xac nhan nen xet sau cung.
            bumpStat(wrongWay ? 3 : nestV == 1 ? 7 : nestV == 2 ? 8 : confirmed ? 1 : 4, cl)
            if ok
                color colOF = cl ? colorOFBull : colorOFBear
                array.push(ofZone, createBox(array.get(ofCBar, i), time, ct, cb, colOF))
                array.push(ofLbl , label.new(array.get(ofCBar, i), cl ? cb : ct, cl ? OFD_TEXT : OFS_TEXT, xloc.bar_time,
                     color = transp, textcolor = ofLabelOn ? color.white : na,
                     style = cl ? label.style_label_up : label.style_label_down, size = ofLblSize))
                array.push(ofBull , cl)
                array.push(ofMit  , false)
                array.push(ofTouch, na)
                // Vung KE THUA so hieu cua chinh ung vien da sinh ra no => nhat ky noi duoc
                // "#12 sinh o nen X, ve box o nen Y, chet o nen Z" nhu mot doi tuong lien mach.
                array.push(ofId   , cid)
                // Nen xac nhan — moc thoi gian de lan sau phan biet "thu hep" voi "OF rieng biet".
                array.push(ofConfBar, time)
                // Roi vung = nen NAM TRON ngoai vung. Xem chu thich o cho khai bao `ofLeft`.
                array.push(ofLeft   , cl ? low > ct : high < cb)
                array.push(ofBody   , false)
                array.push(ofExtr   , na)
                logOF("ve box", cl, cid, cl ? ct : cb)
                // THU HEP: ung vien nay dung o cuc tri cua mot/nhieu vung rong bao ngoai
                // => no la ban (b) cua chung. Ve xong roi moi don, de vung rong kip de lai bia mo.
                if nestV == 3
                    shrinkWideOF(ct, cb, cl, array.get(ofCBar, i))
            else
                // Bia mo cho ung vien: dat tai MEP TRAI dang le cua hop bi thieu, o BIEN GIU
                // (OF-D -> day vung, OF-S -> dinh vung) tuc dung cai bien da giet no.
                // Nhan PHAI ghi ro CHIEU: cung mot muc gia co the la DAY cua mot OF-D hoac
                // DINH cua mot OF-S — hai vung khac han nhau, khong doc duoc chieu thi khong
                // ket luan duoc gi.  Dang:  D P2 >61130  =  Demand, chet vi P o nen thu 2,
                // bien XA (dich xac nhan) la 61130.
                string whyC = wrongWay ? "P" : nestV == 1 ? "N" : nestV == 2 ? "T" : "H"
                if dbgOk(cl, whyC)
                    label.new(array.get(ofCBar, i), cl ? cb : ct,
                         (cl ? "D " : "S ") + whyC
                         + str.tostring(ag) + " >" + str.tostring(cl ? ct : cb, format.mintick),
                         xloc.bar_time, color = transp, textcolor = color.orange,
                         style = cl ? label.style_label_up : label.style_label_down, size = size.tiny)
                logOF(wrongWay ? "huy P" : "huy H", cl, cid, cl ? cb : ct)
            // Hop MA da het viec: hoac vua thanh vung that (hop dac ve de len dung cho do),
            // hoac vua bi huy. box.delete / label.delete voi `na` la lenh rong nen khong
            // can biet luc tao co bat debug hay khong.
            box.delete(array.get(ofCBox, i))
            label.delete(array.get(ofCLbl, i))
            array.remove(ofCBox , i)
            array.remove(ofCLbl , i)
            array.remove(ofCId  , i)
            array.remove(ofCTop , i)
            array.remove(ofCBot , i)
            array.remove(ofCBar , i)
            array.remove(ofCBull, i)
            array.remove(ofCAge , i)
            if i < array.size(ofCRef)
                array.remove(ofCRef , i)

// (B2) HOP MA cua ung vien — keo dai mep phai va dem nguoc so nen con lai.
//      Chay SAU (B) nen cac ung vien vua chet da bi don di, va so nen con lai la so DUNG
//      cua nen nay. THUAN QUAN SAT: khong dong nao cham vao ofCTop/ofCBot/ofCAge, nen bat
//      hay tat cong tac nay deu khong lam doi mot ung vien nao.
if ofDbgGhost and array.size(ofCBox) > 0
    for i = 0 to array.size(ofCBox) - 1
        box gb = array.get(ofCBox, i)
        if not na(gb)
            box.set_right(gb, time)
            label gl = array.get(ofCLbl, i)
            if not na(gl)
                bool cbl = array.get(ofCBull, i)
                int  rem = ofConfirmBars - array.get(ofCAge, i)
                label.set_text(gl, "?" + (cbl ? "D" : "S") + "#"
                     + str.tostring(array.get(ofCId, i)) + " con " + str.tostring(rem))

// (C) Cat bot — dat CUOI CUNG de bat duoc ca vung vua mitigated o (A) lan vua sinh o (B).
if showOF
    trimOF(true , OF_HARD_CAP)
    trimOF(false, OF_HARD_CAP)

// ===== (D) OF CUA KHUNG LON ===============================================
// Chay mot engine OF THU HAI, nuoi bang nen cua khung lon lay ve qua request.security.
// Pine khong cho mang / hop ve di qua request.security nen khong the lay vung OF co san tu
// khung lon mang sang — bat buoc phai dung lai tu OHLC.
//
// `expr[1]` + lookahead_on la cap chuan de lay nen khung lon DA DONG, khong ve lai.
// Lay ca ATR14 cua khung lon trong cung mot tuple: bo loc kich thuoc chan hoi phai do bang
// thuoc cua chinh khung do, khong phai atrSw cua chart.
// request.security PHAI goi o pham vi toan cuc, khong duoc dat trong if — nen no luon chay,
// con `htfActive` moi la cai quyet dinh co dung ket qua hay khong.
bool htfActive = htfOFOn and showOF and timeframe.in_seconds(timeframe.period) < timeframe.in_seconds(htfOFTf)
int  hLen      = timeframe.in_seconds(htfOFTf) * 1000
bool htfWickEnds = timeframe.in_seconds(htfOFTf) <= 3600
[hO, hH, hL, hC, hT, hA] = request.security(syminfo.tickerid, htfOFTf,
     [open[1], high[1], low[1], close[1], time[1], ta.atr(14)[1]], lookahead = barmerge.lookahead_on)
// Mot nen khung lon vua dong => chay dung MOT nhip engine. Cac nen chart o giua khong lam gi.
bool newH = htfActive and not na(hT) and (na(hT[1]) or hT != hT[1])

if newH
    // (D1) VONG DOI. Ba cua ra, va chung KHONG giong nhau:
    //        QUET (rau xuyen bien giu) / HET HAN  -> XOA HAN ho so, giong engine chinh.
    //        KHAI THAC (than nen vao trong)       -> chi AN hinh ve, HO SO O LAI.
    //      Phan biet nay la cho sua bug: ho so cua vung da khai thac phai o lai de con loai
    //      duoc ung vien nam trong no (ma N), dung nhu vung XAM lam viec ben chart 4H.
    //      KHAI THAC = co THAN NEN (dong cua HOAC mo cua) nam trong vung. Rau quet qua thi
    //      chua tinh la khai thac — nhung neu rau xuyen qua BIEN GIU thi vung chet han.
    if array.size(hzTop) > 0
        for i = array.size(hzTop) - 1 to 0
            float zt  = array.get(hzTop, i)
            float zb  = array.get(hzBot, i)
            bool  zbl = array.get(hzBull, i)
            bool sweep  = zbl ? (ofSweepClose ? hC : hL) < zb : (ofSweepClose ? hC : hH) > zt
            bool tooOld = hT - array.get(hzLeft, i) > hLen * maxBarHistory
            if sweep or tooOld
                bumpH(sweep ? 5 : 2, zbl)
                htfRemoveZone(i)
            else if not array.get(hzMit, i)
                // KHAI THAC = ROI HAN KHOI VUNG ROI QUAY LAI — y nguyen luat (A) cua engine
                // chinh, truoc day thieu han o day. BankTrap trang 26: "sau khi gia giam xuong
                // KHOI OF1 VA DI LEN KHAI THAC OF1". Thieu buoc "roi han" thi nhung cay nen
                // ngay sau luc vung ra doi, luc gia con dang roi di va con dinh vao vung, da
                // du giet vung => vung 4H gan nhu khong bao gio song duoc toi luc ban nhin.
                bool away = zbl ? hL > zt : hH < zb
                if away
                    array.set(hzAway, i, true)
                else if array.get(hzAway, i)
                    // Nguong 1H ap theo KHUNG LON chu khong theo khung dang xem — vung
                    // nay la vung cua khung do, phai do bang thuoc cua chinh no.
                    bool bodyIn = htfWickEnds or (hC <= zt and hC >= zb) or (hO <= zt and hO >= zb)
                    if bodyIn
                        // CHI DANH DAU, khong xoa hinh ve. Bi khai thac khong con dong nghia
                        // voi bien mat: khoi (D5) se hoi them luat CUU VUNG moi nen truoc khi
                        // quyet dinh an hay hien. Xoa hinh o day la chot mot lan va vinh vien,
                        // vung se khong bao gio song lai duoc nua.
                        bumpH(9, zbl)
                        array.set(hzMit, i, true)
                        // `hT` = mep TRAI cua chinh cay nen khung lon vua khai thac vung.
                        // Moi OF khung nho XAC NHAN tu moc nay tro di khong con tu cach cuu
                        // vung nua — xem `htfHasLiveInner`.
                        array.set(hzMitBar, i, hT)

    // (D2) ENGINE PULLBACK tren nen khung lon — ban sao cua khoi Pullback chinh, chi thay
    //      high/low/time bang hH/hL/hT va cac bien trang thai bang ban h*.
    if na(hTop)
        hTop  := hH
        hBot  := hL
        hTop_ := hH
        hBot_ := hL
        hBar  := hT
        hBar_ := hT
    else
        if hH >= hTop and hL <= hBot
            if hMn != MN_NA
                hPrevMn := hMn
            if hPrevMn == MN_UP
                hTop_ := hTop
                hBar_ := hBar
            else
                hBot_ := hBot
                hBar_ := hBar
            hTop := hH
            hBot := hL
            hBar := hT
            hMn  := MN_NA
        if hH >= hTop and hL > hBot
            if hPrevMn == MN_UP and hMn == MN_NA
                array.push(hpHBar, hBar_)
                array.push(hpHigh, hTop_)
                array.push(hpLBar, hBar)
                array.push(hpLow , hBot)
                htfAddCand(hBar_, hTop_, hBot, true, hA)
            else if (hPrevMn == MN_DN and hMn == MN_NA) or hMn == MN_DN
                array.push(hpLBar, hBar)
                array.push(hpLow , hBot)
                [pT, pTBar] = findPivotBefore(hpHigh, hpHBar, hBar)
                if not na(pT)
                    htfAddCand(math.min(pTBar, hBar), pT, hBot, true, hA)
            hTop := hH
            hBot := hL
            hBar := hT
            hPrevMn := MN_NA
            hMn := MN_UP
        if hH < hTop and hL <= hBot
            if hPrevMn == MN_DN and hMn == MN_NA
                array.push(hpHBar, hBar)
                array.push(hpHigh, hTop)
                array.push(hpLBar, hBar_)
                array.push(hpLow , hBot_)
                htfAddCand(hBar_, hTop, hBot_, false, hA)
            else if (hPrevMn == MN_UP and hMn == MN_NA) or hMn == MN_UP
                array.push(hpHBar, hBar)
                array.push(hpHigh, hTop)
                [pB, pBBar] = findPivotBefore(hpLow, hpLBar, hBar)
                if not na(pB)
                    htfAddCand(math.min(pBBar, hBar), hTop, pB, false, hA)
            hTop := hH
            hBot := hL
            hBar := hT
            hPrevMn := MN_NA
            hMn := MN_DN
        trimArr(hpHigh)
        trimArr(hpHBar)
        trimArr(hpLow)
        trimArr(hpLBar)

    // (D3) UNG VIEN -> VUNG. Dieu kien #1 + luat "OF khong hop le" + bo luat long nhau,
    //      y het engine chinh, chi khac la khong co bia mo va khong co pheu.
    if array.size(hcTop) > 0
        for i = array.size(hcTop) - 1 to 0
            float ct  = array.get(hcTop, i)
            float cb  = array.get(hcBot, i)
            bool  cl  = array.get(hcBull, i)
            int   cLf = array.get(hcBar, i)
            int   ag  = array.get(hcAge, i) + 1
            array.set(hcAge, i, ag)
            // Moc pha — y het khoi (B), xem chu thich `ofCRef`.
            float swRef = na
            if i < array.size(hcRef)
                swRef := array.get(hcRef, i)
            float brkLv = cl ? (na(swRef) ? ct : math.max(ct, swRef)) : (na(swRef) ? cb : math.min(cb, swRef))
            bool confirmed = cl ? hC > brkLv : hC < brkLv
            bool wrongWay  = cl ? (ofSweepClose ? hC : hL) < cb : (ofSweepClose ? hC : hH) > ct
            if not confirmed and i < array.size(hcRef)
                if cl and hH > brkLv
                    array.set(hcRef, i, hH)
                else if not cl and hL < brkLv
                    array.set(hcRef, i, hL)
            if confirmed or wrongWay or ag > ofConfirmBars
                bool ok = confirmed and not wrongWay
                int  nv = 0
                if ok
                    nv := htfNestVerdict(ct, cb, cl, cLf)
                if nv == 1 or nv == 2
                    ok := false
                // Thu tu uu tien giong het khoi (B) cua engine chinh.
                bumpH(wrongWay ? 3 : nv == 1 ? 7 : nv == 2 ? 8 : confirmed ? 1 : 4, cl)
                if ok
                    // Mau o day chi la mau khoi tao — khoi (D5) to lai MOI NEN nen doi o nhap
                    // mau la thay ngay, khong phai cho vung moi sinh ra.
                    color cBase = cl ? htfColD : htfColS
                    array.push(hzBox, box.new(cLf, ct, time, cb, xloc = xloc.bar_time,
                         bgcolor = color.new(cBase, htfOFTr), border_color = color.new(cBase, 35),
                         border_style = line.style_dashed))
                    array.push(hzLbl, label.new(cLf, cl ? cb : ct,
                         ofLabelOn ? htfOFTf + " " + (cl ? OFD_TEXT : OFS_TEXT) : "", xloc.bar_time,
                         color = transp, textcolor = ofLabelOn ? cBase : na,
                         style = cl ? label.style_label_up : label.style_label_down, size = size.tiny))
                    array.push(hzTop , ct)
                    array.push(hzBot , cb)
                    array.push(hzMit , false)
                    array.push(hzAway, cl ? hL > ct : hH < cb)
                    array.push(hzDead, false)
                    array.push(hzSeen, false)
                    array.push(hzMitBar, 0)
                    array.push(hzBull, cl)
                    array.push(hzLeft, cLf)
                    array.push(hzConf, hT)
                    if nv == 3
                        htfShrinkWide(ct, cb, cl, cLf)
                else
                    // BIA MO CUA KHUNG LON. Dung bo loc `dbgOk` chung voi engine chinh nen hai
                    // o `Chi hien chieu` / `ly do` dieu khien ca hai. Tien to `4H` de khong lan
                    // voi bia mo cua khung dang xem — hai vung co the trung muc gia.
                    string whyH = wrongWay ? "P" : nv == 1 ? "N" : nv == 2 ? "T" : "H"
                    if dbgOk(cl, whyH)
                        label.new(cLf, cl ? cb : ct,
                             "4H " + (cl ? "D " : "S ") + whyH
                             + str.tostring(ag) + " >" + str.tostring(cl ? ct : cb, format.mintick),
                             xloc.bar_time, color = transp, textcolor = color.orange,
                             style = cl ? label.style_label_up : label.style_label_down, size = size.tiny)
                array.remove(hcTop , i)
                array.remove(hcBot , i)
                array.remove(hcBar , i)
                array.remove(hcBull, i)
                array.remove(hcAge , i)
                if i < array.size(hcRef)
                    array.remove(hcRef , i)

    // (D4) Nap cung chong tran. Dem theo HO SO chu khong theo hop dang ve, vi ho so cua vung
    //      da khai thac van nam lai de phuc vu luat long nhau — chinh no moi la thu phinh ra.
    while array.size(hzTop) > OF_HARD_CAP
        bumpH(6, array.get(hzBull, 0))
        htfRemoveZone(0)

// (D5) PHEP THU HIEN THI + TO MAU + keo dai mep phai. Chay MOI NEN CHART.
//
//      MOT VUNG KHUNG LON DUOC HIEN KHI THOA CA HAI:
//        (1) CON HANG — hoac chinh no chua bi khai thac, HOAC no da bi khai thac nhung ben
//            trong con mot OF khung nho chua bi khai thac (xem `htfHasLiveInner`).
//            Hai nhanh nay loai tru nhau nen thuc chat la mot cau hoi: khu vuc nay con cho
//            nao chua ai dung toi khong.
//            Luu y nhanh dau: vung khung lon chua bi khai thac thi hien, BAT KE cac OF khung
//            nho ben trong da bi an het hay chua — chung la chuyen cua khung nho.
//        (2) QUA DUOC HAN NGACH — nam trong top N gan gia nhat cua chieu do.
//
//      Phai hoi LAI MOI NEN chu khong chot ngay luc bi khai thac — vi the (D1) chi danh dau
//      `hzMit`, con viec an/hien nam het o day. NHUNG phep thu la MOT CHIEU: lan dau tien no
//      tra loi KHONG thi vung chet han (`hzDead`), ve sau co OF khung nho moi sinh ra ben
//      trong cung khong cuu lai duoc. Khong co cho do thi vung da tieu se chop tat theo nhip
//      ra doi / bi an cua cac OF khung nho ben trong no.
//
//      Han ngach dem TRONG SO VUNG DANG SONG: vung da tat khong duoc chiem suat cua vung con
//      hang. Thieu han ngach chinh la ly do engine nay tung ve nhieu vung hon han so voi khi
//      mo thang chart khung lon — ben kia loc top N, ben nay truoc do ve het.
if htfActive and array.size(hzTop) > 0
    // Buoc 1 — tra loi cau hoi (1) cho tung ho so. Tach rieng mot vong vi buoc 2 can biet
    // TOAN BO ket qua moi xep hang duoc: khong the vua duyet vua xep.
    array.clear(hzLive)
    for i = 0 to array.size(hzTop) - 1
        bool alive = false
        // Da chot chet thi khong hoi lai nua — day la cai lam cho phep thu nay MOT CHIEU.
        if not array.get(hzDead, i)
            alive := not array.get(hzMit, i)
            if not alive
                alive := htfHasLiveInner(array.get(hzTop, i), array.get(hzBot, i), array.get(hzBull, i), array.get(hzMitBar, i))
                if alive
                    // Ghi nhan: vung nay DA TUNG co hang. Tu gio tro di no moi du tu cach
                    // de "tieu het" theo dung nghia.
                    array.set(hzSeen, i, true)
                else if array.get(hzSeen, i)
                    // TUNG co, GIO het => dung nghia "cac OF 15m ben trong cung bi khai thac
                    // het". Chot chet vinh vien, OF khung nho moi sinh ra sau nay khong cuu lai.
                    array.set(hzDead, i, true)
                // Con lai: `hzMit` da bat nhung CHUA TUNG co OF khung nho nao con nguyen ben
                // trong. KHONG chot chet — chi tam an. Day la cho sua bug "vung 4H bien mat
                // trong khi ben trong no van con OF 15m song".
                //
                // Vi sao tap lai rong dung luc do: (D1) chi chay khi mot nen KHUNG LON vua
                // DONG, nen no phat hien "da bi khai thac" o CUOI nhip, sau khi ca 16 nen 15m
                // cua cay nen 4H do da chay xong. Trong 16 nen ay gia da lia qua phan tren cua
                // vung va lam XAM cac OF 15m nam o do. Den luc (D5) hoi thi dung cai khoanh
                // khac tap rong nhat cua ca qua trinh — roi chot chet vinh vien tai chinh do.
                // Vai nen sau gia tao OF 15m moi ngay trong vung, nhung cua da dong.
        array.push(hzLive, alive)
    // Buoc 2 — han ngach, to mau, keo dai mep phai.
    array.clear(hzRank)
    for i = 0 to array.size(hzTop) - 1
        box   z  = array.get(hzBox, i)
        bool  bl = array.get(hzBull, i)
        bool  lv = array.get(hzLive, i)
        float d  = ofDist(z)
        int rank = 0
        for j = 0 to array.size(hzTop) - 1
            if j != i and array.get(hzBull, j) == bl and array.get(hzLive, j)
                float dj = ofDist(array.get(hzBox, j))
                if dj < d or (dj == d and j < i)
                    rank += 1
        array.push(hzRank, rank)
        bool  vis   = lv and rank < htfOFMax
        color cBase = bl ? htfColD : htfColS
        box.set_right(z, time)
        box.set_bgcolor(z, vis ? color.new(cBase, htfOFTr) : transp)
        box.set_border_color(z, vis ? color.new(cBase, 35) : transp)
        // CHE DO SOI: vung dang bi AN van phai hien NHAN (mo, co dau `!` o dau). Khong co
        // cho nay thi dung cai vung ban dang thac mac lai la cai KHONG the di chuot vao —
        // nhan cua no vo hinh nen tooltip giai thich ly do cung khong voi toi duoc.
        label lb    = array.get(hzLbl, i)
        bool  lblOn = ofLabelOn and (vis or ofDbgTip)
        label.set_text(lb, lblOn ? (vis ? "" : "! ") + htfOFTf + " " + (bl ? OFD_TEXT : OFS_TEXT) : "")
        label.set_textcolor(lb, lblOn ? (vis ? cBase : color.new(color.gray, 25)) : na)
        // Ho so vung khung lon — de doi chieu TUNG CON SO voi chart khung lon that, va de
        // biet chinh xac vung dang hien nho dau: con nguyen, hay duoc OF khung nho cuu.
        if ofDbgTip
            label.set_tooltip(lb, htfOFTf + "  " + (bl ? OFD_TEXT : OFS_TEXT)
                 + "\ndinh " + str.tostring(array.get(hzTop, i), format.mintick)
                 + "  /  day " + str.tostring(array.get(hzBot, i), format.mintick)
                 + "\ntuoi " + str.tostring(int((time - array.get(hzLeft, i)) / hLen)) + " nen khung lon"
                 + "\nthu hang " + str.tostring(rank) + "  (nguong " + str.tostring(htfOFMax) + ")"
                 + (not array.get(hzMit, i) ? "\nCON NGUYEN — chua bi khai thac"
                   : lv ? "\nDA BI KHAI THAC nhung duoc CUU: ben trong con OF cung chieu chua bi khai thac"
                       : array.get(hzDead, i) ? "\nCHET HAN — da tung co OF cung chieu con nguyen ben trong, va da bi an het"
                           : "\nTAM AN — da khai thac, nhung CHUA TUNG co OF cung chieu nao con nguyen ben trong. Chua chot chet: co OF 15m moi trong vung la hien lai.")
                 + (array.get(hzAway, i) ? "" : "\n(chua co nen " + htfOFTf + " nao nam HAN ngoai vung"
                       + " => buoc 1 cua phep thu khai thac chua chay)")
                 + ("\nkhai thac can: 1 nen " + htfOFTf + " DONG CUA hoac MO CUA nam trong ["
                       + str.tostring(array.get(hzBot, i), format.mintick) + " ; "
                       + str.tostring(array.get(hzTop, i), format.mintick) + "]"
                       + (htfWickEnds ? "" : " - rau " + htfOFTf + " thoc vao KHONG tinh"))
                 + (lv and rank >= htfOFMax ? "\nDANG BI AN vi qua han ngach" : ""))

// ===== DO DEM THEO TUNG NEN (debug) =======================================
// Bang dem ben duoi chi ve duoc tai NEN CUOI CUNG (barstate.islast) — no khong tra loi duoc
// "cach day 300 nen luc do dang co bao nhieu vung". Cac do dem duoi day gan vao plot voi
// display.data_window: KHONG ve gi len chart, KHONG ton quota box/label, nhung chay MOI NEN
// => keo chuot ve bat ky nen qua khu nao trong Data Window cung doc duoc trang thai luc do.
// Day la thu duy nhat trong ca he thong debug xem duoc LICH SU chu khong chi hien tai.
// Bang dem cung DOC LAI dung may con so nay, khong dem lai lan hai.
int dwDL = 0
int dwDM = 0
int dwSL = 0
int dwSM = 0
if array.size(ofZone) > 0
    for i = 0 to array.size(ofZone) - 1
        bool bW = array.get(ofBull, i)
        bool mW = array.get(ofMit , i)
        if bW and mW
            dwDM += 1
        else if bW
            dwDL += 1
        else if mW
            dwSM += 1
        else
            dwSL += 1
int dwCD = 0
int dwCS = 0
if array.size(ofCBull) > 0
    for i = 0 to array.size(ofCBull) - 1
        if array.get(ofCBull, i)
            dwCD += 1
        else
            dwCS += 1
// Vung bi HAN NGACH day khoi top N. Sau khi bo (A2b) day la duong AN duy nhat con lai,
// nen `vis = false` chi con dung mot nghia. Lap theo size cua ofVisA vi anh chup lay TRUOC
// khoi (B), co the ngan hon ofZone dung bang so vung vua sinh tren chinh nen nay.
int dwQD = 0
int dwQS = 0
if array.size(ofVisA) > 0
    for i = 0 to array.size(ofVisA) - 1
        if not array.get(ofVisA, i)
            if array.get(ofBull, i)
                dwQD += 1
            else
                dwQS += 1
plot(dwDL, "dbg OF-D song" , display = display.data_window)
plot(dwDM, "dbg OF-D xam"  , display = display.data_window)
plot(dwSL, "dbg OF-S song" , display = display.data_window)
plot(dwSM, "dbg OF-S xam"  , display = display.data_window)
plot(dwCD, "dbg OF-D cho"  , display = display.data_window)
plot(dwCS, "dbg OF-S cho"  , display = display.data_window)
plot(dwQD, "dbg OF-D an-ngach", display = display.data_window)
plot(dwQS, "dbg OF-S an-ngach", display = display.data_window)

// ===== BANG DEM (debug) ===================================================
// Cot "cho" = ung vien chua xac nhan. Doc bang nay de biet vung bi mat o khau nao:
//   cho = 0            -> khong sinh duoc ung vien (loi o khoi Pullback / bo loc chieu)
//   cho > 0, song = 0  -> ung vien khong bao gio cham duoc bien xa (dieu kien #1 qua chat)
//   song tang roi tut  -> bi xoa boi vong doi hoac han ngach
var table dbgT = table.new(position.top_right, 4, 32, bgcolor = color.new(color.black, 20), border_width = 1)
if showDbg and barstate.islast
    // So vung OF lay thang tu khoi do dem theo nen o tren. Dem hai noi thi som muon gi cung
    // co ngay hai noi lech nhau, va luc do chinh cai debug tro thanh nguon nghi ngo.
    int pSL = 0
    int pSM = 0
    if array.size(supplyMit) > 0
        for i = 0 to array.size(supplyMit) - 1
            if array.get(supplyMit, i)
                pSM += 1
            else
                pSL += 1
    int pDL = 0
    int pDM = 0
    if array.size(demandMit) > 0
        for i = 0 to array.size(demandMit) - 1
            if array.get(demandMit, i)
                pDM += 1
            else
                pDL += 1
    // KIEM TRA CAN DOI. Moi vung DA VE thi hoac con nam trong bo nho, hoac da di qua DUNG MOT
    // trong BON cua xoa: Q (bi quet) - V (pivot phu nhan) - K (nap cung) - W (nhuong ban hep).
    // Khac 0 nghia la con mot duong xoa chua duoc dem => dung tin cac dong con lai cua pheu.
    // Bon khau HUY (o 3, 4, 7, 8) khong co mat o day: chung giet UNG VIEN truoc khi ve box.
    int balD = array.get(ofStat, 1) - array.get(ofStat, 5) - array.get(ofStat, 2) - array.get(ofStat, 6) - array.get(ofStat, 9) - (dwDL + dwDM)
    int balS = array.get(ofStat, 11) - array.get(ofStat, 15) - array.get(ofStat, 12) - array.get(ofStat, 16) - array.get(ofStat, 19) - (dwSL + dwSM)

    table.cell(dbgT, 0, 0, ""    , text_color = color.gray , text_size = size.small)
    table.cell(dbgT, 1, 0, "song", text_color = color.gray , text_size = size.small)
    table.cell(dbgT, 2, 0, "xam" , text_color = color.gray , text_size = size.small)
    table.cell(dbgT, 3, 0, "cho" , text_color = color.gray , text_size = size.small)
    table.cell(dbgT, 0, 1, "OF-D", text_color = colorOFBull, text_size = size.small)
    table.cell(dbgT, 1, 1, str.tostring(dwDL), text_color = color.white, text_size = size.small)
    table.cell(dbgT, 2, 1, str.tostring(dwDM), text_color = color.white, text_size = size.small)
    table.cell(dbgT, 3, 1, str.tostring(dwCD), text_color = color.white, text_size = size.small)
    table.cell(dbgT, 0, 2, "OF-S", text_color = colorOFBear, text_size = size.small)
    table.cell(dbgT, 1, 2, str.tostring(dwSL), text_color = color.white, text_size = size.small)
    table.cell(dbgT, 2, 2, str.tostring(dwSM), text_color = color.white, text_size = size.small)
    table.cell(dbgT, 3, 2, str.tostring(dwCS), text_color = color.white, text_size = size.small)
    table.cell(dbgT, 0, 3, "POI-S", text_color = colorSupply, text_size = size.small)
    table.cell(dbgT, 1, 3, str.tostring(pSL), text_color = color.white, text_size = size.small)
    table.cell(dbgT, 2, 3, str.tostring(pSM), text_color = color.white, text_size = size.small)
    table.cell(dbgT, 0, 4, "POI-D", text_color = colorDemand, text_size = size.small)
    table.cell(dbgT, 1, 4, str.tostring(pDL), text_color = color.white, text_size = size.small)
    table.cell(dbgT, 2, 4, str.tostring(pDM), text_color = color.white, text_size = size.small)

    // PHEU OF — cong don tu dau chart. Cho biet ung vien chet o KHAU NAO chu khong chi con lai bao nhieu.
    // Da du ca 9 khau: 4 cua HUY (ung vien) + 3 cua XOA (vung da ve) + khau sinh va khau ve box.
    // Hai dong ve vung long nhau la HAI NHANH cua cung mot phep thu, dung doc lan:
    //   huy: trong OF truoc  = vung ngoai DA hoan tat nhip tiep dien => hai OF rieng biet
    //   huy: ban rong (c->b) = chua co nhip nao o giua => cung mot nhip hoi, ban hep thang
    idxs = array.from(0, 1, 3, 7, 8, 4, 5, 2, 6, 9)
    lbls = array.from("ung vien sinh", "-> ve box", "huy: pha nham", "huy: trong OF truoc", "huy: ban rong (c->b)", "huy: het han", "xoa: bi quet", "xoa: pivot (V)", "xoa: nap cung (K)", "xoa: nhuong ban hep (W)")
    table.cell(dbgT, 0, 5, "PHEU OF", text_color = color.yellow  , text_size = size.small)
    table.cell(dbgT, 1, 5, "D"      , text_color = colorOFBull, text_size = size.small)
    table.cell(dbgT, 2, 5, "S"      , text_color = colorOFBear, text_size = size.small)
    for k = 0 to 9
        kk = array.get(idxs, k)
        table.cell(dbgT, 0, k + 6, array.get(lbls, k), text_color = color.gray , text_size = size.small)
        table.cell(dbgT, 1, k + 6, str.tostring(array.get(ofStat, kk))     , text_color = color.white, text_size = size.small)
        table.cell(dbgT, 2, k + 6, str.tostring(array.get(ofStat, kk + 10)), text_color = color.white, text_size = size.small)
    // KHONG thuoc pheu: pheu dem SU KIEN cong don tu dau chart, con day la TRANG THAI ngay tai
    // nen hien tai. Day la duong AN duy nhat con lai — bi day khoi top N vi co vung cung chieu,
    // cung trang thai dang nam gan gia hon. Tang han ngach la no hien lai ngay.
    table.cell(dbgT, 0, 16, "an: ngach", text_color = color.orange, text_size = size.small)
    table.cell(dbgT, 1, 16, str.tostring(dwQD), text_color = color.white, text_size = size.small)
    table.cell(dbgT, 2, 16, str.tostring(dwQS), text_color = color.white, text_size = size.small)
    // Phai bang 0. Khac 0 = pheu dang thieu mot duong xoa nao do, ket qua khong dang tin.
    table.cell(dbgT, 0, 17, "kiem tra", text_color = color.gray, text_size = size.small)
    table.cell(dbgT, 1, 17, str.tostring(balD), text_color = balD == 0 ? color.green : color.red, text_size = size.small)
    table.cell(dbgT, 2, 17, str.tostring(balS), text_color = balS == 0 ? color.green : color.red, text_size = size.small)

    // ===== PHEU CUA ENGINE KHUNG LON =====
    // Doc GIONG HET phan tren, chi khac la dem bang nen cua khung lon. Dong dau tien tra loi
    // ngay cau hoi quan trong nhat: engine nay co SINH duoc ung vien nao khong.
    //   sinh = 0            -> engine pullback khung lon khong chay (xem `htfActive`)
    //   sinh > 0, ve box = 0-> ung vien khong bao gio xac nhan duoc
    //   ve box > 0, ho so 0 -> vung ve ra roi bi xoa/an het, doc 4 dong xoa/an de biet cua nao
    // CON HANG = ket qua buoc 1 cua (D5), doc thang tu `hzLive` chu khong tinh lai — tinh
    // lai la co hai noi cung dien giai mot bo luat, som muon gi cung lech nhau.
    int hLiveD = 0
    int hLiveS = 0
    int hRecD  = 0
    int hRecS  = 0
    int hSavD  = 0
    int hSavS  = 0
    int hDedD  = 0
    int hDedS  = 0
    if array.size(hzTop) > 0
        for i = 0 to array.size(hzTop) - 1
            bool bh = array.get(hzBull, i)
            if bh
                hRecD += 1
            else
                hRecS += 1
            bool lvh = false
            if i < array.size(hzLive)
                lvh := array.get(hzLive, i)
            if lvh
                if bh
                    hLiveD += 1
                else
                    hLiveS += 1
                // da bi khai thac ma van song => dang duoc mot OF khung nho cuu
                if array.get(hzMit, i)
                    if bh
                        hSavD += 1
                    else
                        hSavS += 1
            else if array.get(hzDead, i)
                if bh
                    hDedD += 1
                else
                    hDedS += 1
    hIdx = array.from(0, 1, 3, 7, 8, 4, 5, 2, 6, 9)
    hLbl = array.from("ung vien sinh", "-> ve box", "huy: pha nham", "huy: trong OF truoc", "huy: ban rong (c->b)", "huy: het han", "xoa: bi quet", "xoa: qua tuoi", "xoa: nap cung (K)", "danh dau da khai thac")
    table.cell(dbgT, 0, 18, "PHEU " + htfOFTf, text_color = color.yellow, text_size = size.small)
    table.cell(dbgT, 1, 18, "D", text_color = htfColD, text_size = size.small)
    table.cell(dbgT, 2, 18, "S", text_color = htfColS, text_size = size.small)
    for k = 0 to 9
        kk = array.get(hIdx, k)
        table.cell(dbgT, 0, k + 19, array.get(hLbl, k), text_color = color.gray , text_size = size.small)
        table.cell(dbgT, 1, k + 19, str.tostring(array.get(hStat, kk))     , text_color = color.white, text_size = size.small)
        table.cell(dbgT, 2, k + 19, str.tostring(array.get(hStat, kk + 10)), text_color = color.white, text_size = size.small)
    // HO SO = tong so vung con trong bo nho (ke ca vung da khai thac, giu lai de phuc vu luat
    // long nhau). DANG VE = so vung thuc su co hinh tren chart truoc khi loc han ngach.
    table.cell(dbgT, 0, 29, "ho so / con hang", text_color = color.orange, text_size = size.small)
    table.cell(dbgT, 1, 29, str.tostring(hRecD) + " / " + str.tostring(hLiveD), text_color = color.white, text_size = size.small)
    table.cell(dbgT, 2, 29, str.tostring(hRecS) + " / " + str.tostring(hLiveS), text_color = color.white, text_size = size.small)
    // CHET HAN vs TAM AN — hai ly do an khac han nhau, va chi mot trong hai la khong the cuu.
    table.cell(dbgT, 3, 29, "chet han " + str.tostring(hDedD) + "/" + str.tostring(hDedS), text_color = color.red, text_size = size.small)
    // Dong quan trong nhat cua luat moi: bao nhieu vung dang song CHI nho co OF khung nho
    // cung chieu con nguyen ben trong. Nhung vung nay chinh la cho luat moi khac luat cu —
    // truoc day chung da bi an ngay luc bi khai thac.
    table.cell(dbgT, 0, 31, "trong do: duoc cuu", text_color = color.orange, text_size = size.small)
    table.cell(dbgT, 1, 31, str.tostring(hSavD), text_color = color.white, text_size = size.small)
    table.cell(dbgT, 2, 31, str.tostring(hSavS), text_color = color.white, text_size = size.small)
    table.cell(dbgT, 0, 30, "engine bat?", text_color = color.gray, text_size = size.small)
    table.cell(dbgT, 1, 30, htfActive ? "CO" : "KHONG", text_color = htfActive ? color.green : color.red, text_size = size.small)
    table.cell(dbgT, 2, 30, str.tostring(array.size(hcTop)) + " cho", text_color = color.white, text_size = size.small)
    if not htfActive
        table.cell(dbgT, 3, 30, "khung dang xem >= " + htfOFTf, text_color = color.red, text_size = size.small)

// ===== BANG SOI TUNG VUNG (debug) =========================================
// Bang dem tra loi "con bao nhieu vung", bang nay tra loi "vung NAO, va vi sao khong thay no".
// Xep theo KHOANG CACH toi gia — vung dau bang la vung gia se gap truoc tien neu quay dau lai.
// Cot trang thai doc thang tu anh chup cua khoi (A3), khong dien giai lai bo luat lan hai.
var table dbgL = table.new(position.bottom_right, 8, 50, bgcolor = color.new(color.black, 20), border_width = 1)
if ofDbgList and barstate.islast
    table.clear(dbgL, 0, 0, 7, 49)
    table.cell(dbgL, 0, 0, "id"        , text_color = color.gray, text_size = size.tiny)
    table.cell(dbgL, 1, 0, "ben"       , text_color = color.gray, text_size = size.tiny)
    table.cell(dbgL, 2, 0, "dinh"      , text_color = color.gray, text_size = size.tiny)
    table.cell(dbgL, 3, 0, "day"       , text_color = color.gray, text_size = size.tiny)
    table.cell(dbgL, 4, 0, "tuoi"      , text_color = color.gray, text_size = size.tiny)
    table.cell(dbgL, 5, 0, "cach gia"  , text_color = color.gray, text_size = size.tiny)
    table.cell(dbgL, 6, 0, "hang"      , text_color = color.gray, text_size = size.tiny)
    table.cell(dbgL, 7, 0, "trang thai", text_color = color.gray, text_size = size.tiny)
    // Pine khong co ham sap xep mang box => chon lan luot vung gan nhat trong so CHUA IN,
    // dung ky thuat tim-min lap lai giong het trimOF.
    array.clear(usedL)
    if array.size(ofZone) > 0
        for i = 0 to array.size(ofZone) - 1
            array.push(usedL, false)
    int rowL = 0
    while rowL < ofDbgListN
        int   pick  = -1
        float bestD = na
        if array.size(ofZone) > 0
            for i = 0 to array.size(ofZone) - 1
                if not array.get(usedL, i)
                    float dz = ofDist(array.get(ofZone, i))
                    if na(bestD) or dz < bestD
                        bestD := dz
                        pick  := i
        if pick == -1
            break
        array.set(usedL, pick, true)
        [tz, bz, lz] = marginZone(array.get(ofZone, pick))
        bool blz = array.get(ofBull, pick)
        bool mtz = array.get(ofMit , pick)
        // Anh chup lay TRUOC khoi (B) nen vung VUA SINH tren chinh nen nay chua co trong do
        // => mang anh chup NGAN hon ofZone dung o phan duoi. Kiem tra bang `if`, khong dung
        // bieu thuc ba ngoi: Pine khong hua bo qua nhanh khong duoc chon, ma mot lan array.get
        // vuot chi so la ca indicator dung lai.
        bool vsz = true
        if pick < array.size(ofVisA)
            vsz := array.get(ofVisA, pick)
        int rkz = 0
        if pick < array.size(ofRankA)
            rkz := array.get(ofRankA, pick)
        int idz = 0
        if pick < array.size(ofId)
            idz := array.get(ofId, pick)
        // vsz la trang thai THAT nen cot nay khong bi cong tac debug lam sai lech.
        // Hai truc tach bach: vsz quyet dinh hien/an, mtz phan biet song/xam trong nhanh "hien".
        // Sau khi bo (A2b) chi con dung mot ly do an nen khong con "AN-long" / "AN-ca hai".
        string stz = vsz ? (mtz ? "XAM" : "HIEN") : "AN-ngach"
        color  stc = not vsz ? color.red : mtz ? color.silver : color.lime
        table.cell(dbgL, 0, rowL + 1, "#" + str.tostring(idz), text_color = color.gray, text_size = size.tiny)
        table.cell(dbgL, 1, rowL + 1, blz ? "D" : "S", text_color = blz ? colorOFBull : colorOFBear, text_size = size.tiny)
        table.cell(dbgL, 2, rowL + 1, str.tostring(tz, format.mintick), text_color = color.white, text_size = size.tiny)
        table.cell(dbgL, 3, rowL + 1, str.tostring(bz, format.mintick), text_color = color.white, text_size = size.tiny)
        table.cell(dbgL, 4, rowL + 1, str.tostring(int((time - lz) / len)), text_color = color.white, text_size = size.tiny)
        table.cell(dbgL, 5, rowL + 1, str.tostring(bestD, format.mintick), text_color = color.white, text_size = size.tiny)
        table.cell(dbgL, 6, rowL + 1, str.tostring(rkz), text_color = color.white, text_size = size.tiny)
        table.cell(dbgL, 7, rowL + 1, stz, text_color = stc, text_size = size.tiny)
        rowL += 1

    // ===== KHOI VUNG KHUNG LON — noi ngay duoi, dung chung bang =====
    // Day la duong doc trang thai vung khung lon KHONG phai re chuot. Tooltip tren nhan chi
    // song khi `DEBUG - Tooltip` dang bat VA chuot trung dung cai nhan ti hon o mep trai vung —
    // mep trai thuong nam ngoai man hinh. Bang thi luon o day.
    // Cot `tuoi` o khoi nay dem bang NEN KHUNG LON, khong phai nen cua chart.
    int rowH = rowL + 2
    if array.size(hzTop) > 0
        table.cell(dbgL, 0, rowH, htfOFTf, text_color = color.yellow, text_size = size.tiny)
        table.cell(dbgL, 7, rowH, "trang thai", text_color = color.gray, text_size = size.tiny)
        rowH += 1
        for i = 0 to array.size(hzTop) - 1
            if rowH < 49
                bool  bh = array.get(hzBull, i)
                float th = array.get(hzTop, i)
                float bhh = array.get(hzBot, i)
                bool  lvh = false
                if i < array.size(hzLive)
                    lvh := array.get(hzLive, i)
                int rkh = 0
                if i < array.size(hzRank)
                    rkh := array.get(hzRank, i)
                bool vish = lvh and rkh < htfOFMax
                // Bon trang thai, dung thu tu uu tien cua khoi (D5).
                string sth = not array.get(hzMit, i) ? "CON NGUYEN"
                   : lvh ? "duoc CUU"
                       : array.get(hzDead, i) ? "CHET HAN" : "TAM AN"
                if lvh and not vish
                    sth := "AN-ngach"
                color sch = not array.get(hzMit, i) ? color.lime
                   : lvh ? (vish ? color.aqua : color.red)
                       : array.get(hzDead, i) ? color.red : color.orange
                table.cell(dbgL, 0, rowH, array.get(hzAway, i) ? "da roi" : "CHUA roi", text_color = array.get(hzAway, i) ? color.gray : color.orange, text_size = size.tiny)
                table.cell(dbgL, 1, rowH, bh ? "D" : "S", text_color = bh ? htfColD : htfColS, text_size = size.tiny)
                table.cell(dbgL, 2, rowH, str.tostring(th , format.mintick), text_color = color.white, text_size = size.tiny)
                table.cell(dbgL, 3, rowH, str.tostring(bhh, format.mintick), text_color = color.white, text_size = size.tiny)
                table.cell(dbgL, 4, rowH, str.tostring(int((time - array.get(hzLeft, i)) / hLen)), text_color = color.white, text_size = size.tiny)
                table.cell(dbgL, 5, rowH, str.tostring(ofDist(array.get(hzBox, i)), format.mintick), text_color = color.white, text_size = size.tiny)
                table.cell(dbgL, 6, rowH, str.tostring(rkh), text_color = color.white, text_size = size.tiny)
                table.cell(dbgL, 7, rowH, sth, text_color = sch, text_size = size.tiny)
                rowH += 1

// ===== NHAT KY SU KIEN (debug) ============================================
// Chieu THOI GIAN ma hai bang tren deu thieu: bang dem la tong cong don tu dau chart, bang soi
// la anh chup ngay bay gio. Moi nhat len dau. Dung table nen khong dung den quota 500 nhan.
var table dbgG = table.new(position.bottom_left, 4, 41, bgcolor = color.new(color.black, 20), border_width = 1)
if ofDbgLog and barstate.islast
    table.clear(dbgG, 0, 0, 3, 40)
    table.cell(dbgG, 0, 0, "luc"    , text_color = color.gray, text_size = size.tiny)
    table.cell(dbgG, 1, 0, "vung"   , text_color = color.gray, text_size = size.tiny)
    table.cell(dbgG, 2, 0, "su kien", text_color = color.gray, text_size = size.tiny)
    table.cell(dbgG, 3, 0, "muc gia", text_color = color.gray, text_size = size.tiny)
    int nLog  = array.size(logEv)
    int nShow = math.min(nLog, ofDbgLogN)
    if nShow > 0
        for k = 0 to nShow - 1
            int    idx = nLog - 1 - k
            bool   bg  = array.get(logBl, idx)
            string ev  = array.get(logEv, idx)
            // Xanh = vung ra doi - Do = vung mat di - Cam = ung vien bi huy giua chung.
            color evc = str.startswith(ev, "xoa") ? color.red : str.startswith(ev, "huy") ? color.orange : color.lime
            table.cell(dbgG, 0, k + 1, str.format_time(array.get(logBar, idx), "MM-dd HH:mm", syminfo.timezone), text_color = color.gray, text_size = size.tiny)
            table.cell(dbgG, 1, k + 1, (bg ? "D#" : "S#") + str.tostring(array.get(logId, idx)), text_color = bg ? colorOFBull : colorOFBear, text_size = size.tiny)
            table.cell(dbgG, 2, k + 1, ev, text_color = evc, text_size = size.tiny)
            table.cell(dbgG, 3, k + 1, str.tostring(array.get(logLvl, idx), format.mintick), text_color = color.white, text_size = size.tiny)
// Chấm swing giờ vẽ bằng label trong khối cấu trúc (addSwingDot) — không còn plot nào.
// Nhờ dùng xloc.bar_time nên cũng không cần tách 2 cặp plot theo khung như trước.
//#endregion
