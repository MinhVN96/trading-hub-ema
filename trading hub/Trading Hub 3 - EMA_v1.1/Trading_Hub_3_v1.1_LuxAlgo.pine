//@version=5
// Trading Hub 3 v1.1 — BIẾN THỂ LUXALGO
// Engine cấu trúc (CHoCH / BOS / IDM / Sweep) được thay hoàn toàn bằng
// "Market Structure with Inducements & Sweeps [LuxAlgo]" (CC BY-NC-SA 4.0).
// Các module POI / Order Block / SCOB / Inside Bar / Pullback giữ nguyên của Trading Hub 3.
// Xem Yeu_cau_bo_sung_SMC_LuxAlgo.md — mục #L1, #L2.
indicator("Trading_Hub_3_v1.1_LuxAlgo", "Trading_Hub_3_v1.1_LuxAlgo", true, max_bars_back = 5000, max_labels_count = 500, max_lines_count = 500)

//drawing options
showPOI = input.bool(true, "Show POI", group="POI settings")
poi_type = input.string ("---",title='POI type', group="POI settings", options=["---", "Mother Bar"])
mergeRatio = input.float(defval=0, minval=0, maxval=0.5, step=0.02, title="Merge Ratio", group="POI settings" )
maxBarHistory = input.int(2000, title="Max IPA age", group="POI settings")

// #L2 — hai tham số này là bản chất của engine fractal LuxAlgo, không phải lựa chọn thiết kế.
// Mốc CHoCH chỉ được xác nhận SAU chochLen nến => trên H4, 50 nến ~ 8.3 ngày.
chochLen = input.int(50, "CHoCH Detection Period", minval = 5, group = "Structure")
idmLen   = input.int(3 , "IDM Detection Period"  , minval = 1, group = "Structure")

showChoCh = input.bool(true, "Show CHoCH", group = "Structure")
showBOS = input.bool(true, "Show B O S", group = "Structure")
showIDM = input.bool(true,"Show IDM", group = "Structure")
showSw = input.bool(true, "Show Sweeps", inline = "sweep", group = "Structure")
markX = input.bool(true, 'Mark "X"', inline = "sweep", group = "Structure")
showSwings = input.bool(true, "Mark Swing points", group = "Structure")
showLive = input.bool(true, "Show live levels", inline = "live", group = "Structure")
liveLen = input.int(15, title="", inline = "live", group = "Structure")

showMn = input.bool(false, "Show pullback", group = "Structure")
maxPbHistory = input.int(500, "Max pullback history", minval = 50, group = "Structure")
showSCOB = input.bool(true, "Show SCOB", group = "Structure")

bull = input.color(color.green, "Bullish", group = "Structure | Color")
bear = input.color(color.red , "Bearish", group = "Structure | Color")
scobUp = input.color(#0b3ff9   , "Bullish SCOB", group = "Structure | Color")
scobDn = input.color(#da781d, "Bearish SCOB", group = "Structure | Color")
colorIDM = input.color(color.gray, "IDM", group = "Structure | Color")
colorSweep = input.color(color.gray, "Sweep", group = "Structure | Color")
colorDemand = input.color(color.rgb(47, 130, 96, 80), 'Demand', group = "Structure | Color")
colorSupply = input.color(color.rgb(205, 92, 72, 80), 'Supply', group = "Structure | Color")
colorMitigated = input.color(color.rgb(192, 192, 192, 80), 'Mitigated', group = "Structure | Color")

//#region variable declaration
//Constant
const string IDM_TEXT = "I D M"
const string CHOCH_TEXT = "CHoCH"
const string BOS_TEXT = "B O S"

//pullback leg state (thay cho bool + na: Pine không cho gán 'na' vào biến 'const bool')
const int MN_UP = 1
const int MN_DN = -1
const int MN_NA = 0

//inside bar
var motherHigh = high[1]
var motherLow = low[1]
var int motherBar = time[1]

//pullback
var int mnStrc = MN_NA
var int prevMnStrc = MN_NA
var float top = high
var float bot = low
var float top_ = high
var float bot_ = low
var int bar = time
var int bar_ = time

//poi
var bool isSweepOBS = false
var int current_OBS = na
var float high_MOBS = na
var float low_MOBS = na

var   bool isSweepOBD = false
var   int current_OBD = na
var   float low_MOBD = na
var   float high_MOBD = na

//Array
var puHigh = array.new_float(0)
var puHBar = array.new_int(0)
var puLow = array.new_float(0)
var puLBar = array.new_int(0)
var demandZone = array.new_box(0)
var supplyZone = array.new_box(0)

//color
color transp = color.new(color.gray,100)

//Caculate
barIdx = bar_index
curTf = timeframe.in_seconds(timeframe.period)
len = curTf*1000

//#endregion

//#region Inside Bar
isb = motherHigh > high and motherLow < low
if isb
    motherHigh := motherHigh
    motherLow := motherLow
    motherBar := motherBar
else
    motherHigh := high
    motherLow := low
    motherBar := time

//#endregion

//#region drawing function
textCenter(int left, int right) => int(math.avg(left,right))

getStyleLabel(bool style) => style ? label.style_label_down : label.style_label_up
getStyleArrow(bool style) => style ? label.style_arrowdown : label.style_arrowup

getYloc(bool style) =>   style ? yloc.abovebar : yloc.belowbar

getNLastValue(arr, n) =>
    if array.size(arr) > n - 1
        array.get(arr, array.size(arr) - n)

// #L5 (một phần) — pullback không còn khách hàng nào tiêu thụ & xoá mảng như IDM cũ,
// nên phải tự chặn mảng phình vô hạn.
trimArr(arr) =>
    if array.size(arr) > maxPbHistory
        array.shift(arr)

drawPullback(int x, float y, bool trend) =>
    color = trend ? bear : bull
    if showMn
        label.new(x, y, "", xloc.bar_time, getYloc(trend), color, getStyleArrow(trend), size = size.tiny )

// Vẽ CHoCH / BOS. Theo quy ước LuxAlgo: CHoCH nét đứt, BOS nét liền.
drawStrc(string txt, int xBar, float y, bool trend) =>
    col = trend ? bull : bear
    line.new(xBar, y, time, y, xloc.bar_time, color = col, style = txt == BOS_TEXT ? line.style_solid : line.style_dashed)
    label.new(textCenter(time, xBar), y, txt, xloc.bar_time, color = transp, style = getStyleLabel(trend), textcolor = col, size = size.small)

drawIdm(int xBar, float y, bool trend) =>
    line.new(xBar, y, time, y, xloc.bar_time, color = colorIDM, style = line.style_dotted)
    label.new(textCenter(time, xBar), y, IDM_TEXT, xloc.bar_time, color = transp, textcolor = colorIDM, style = getStyleLabel(trend), size = size.small)

drawSweep(int xBar, float y, bool trend) =>
    line.new(xBar, y, time, y, xloc.bar_time, color = colorSweep, style = line.style_dotted)
    if markX
        label.new(textCenter(time, xBar), y, "x", xloc.bar_time, color = transp, textcolor = colorSweep, style = getStyleLabel(trend), size = size.small)

createBox(left, right, top, bottom, color) =>
    box.new(left=left, right=right, top=top, bottom=bottom, xloc = xloc.bar_time, bgcolor=color, border_color=color, extend = extend.right)

removeZone(zoneArray, box zone) =>
    index = array.indexof(zoneArray, zone)
    box.delete(zone)
    array.remove(zoneArray, index)

marginZone(zone) => [box.get_top(zone), box.get_bottom(zone), box.get_left(zone)]

handleZone(zoneArray, left, top, bot, color) =>
    _top = top
    _bot = bot
    _left = left

    zone = getNLastValue(zoneArray, 1)

    [topZone, botZone, leftZone] = marginZone(zone)
    rangeTop = math.abs(_top-topZone)/(topZone-botZone) < mergeRatio
    rangeBot = math.abs(_bot-botZone)/(topZone-botZone) < mergeRatio

    //Merge zone
    if _top >= topZone and _bot <= botZone or rangeTop or rangeBot
        _top := math.max(_top,topZone)
        _bot := math.min(_bot,botZone)
        _left := leftZone
        removeZone(zoneArray, zone)

    if not (_top <= topZone and _bot >= botZone)
        array.push(zoneArray, createBox(_left, time, _top, _bot, color))

processZones(zones, isSupply) =>
    if array.size(zones) > 0
        for i = array.size(zones) - 1 to 0 by 1
            zone = array.get(zones, i)
            [topZone, botZone, leftZone] = marginZone(zone)

            //Breaker block zones
            if isSupply and low < botZone and close > topZone
                array.push(demandZone, createBox(leftZone, time, topZone, botZone, colorDemand))
            else if not isSupply and high > topZone and close < botZone
                array.push(supplyZone, createBox(leftZone, time, topZone, botZone, colorSupply))
            //Mitigated zones
            else if (isSupply and high >= botZone and high < topZone) or (not isSupply and low <= topZone and low > botZone)
                box.set_right(zone, time)
                box.set_extend(zone,extend.none)
                box.set_bgcolor(zone, colorMitigated)
                box.set_border_color(zone, colorMitigated)

            //Delete sweep zones
            if (time - leftZone > len*maxBarHistory) or (isSupply and high >= topZone) or (not isSupply and low <= botZone)
                removeZone(zones, zone)

scob(zones, isSupply) =>
    [topZone, botZone, leftZone] = marginZone(getNLastValue(zones, 1))

    if not isb[1]
        if not isSupply and low[1] < low[2] and low[1] < low and close > high[1] and low[1] < topZone and low[1] > botZone
            scobUp
        else if isSupply and high[1] > high[2] and high[1] > high and close < low[1] and high[1] < topZone and high[1] > botZone
            scobDn
        else
            na
//#endregion

//#region Pullback  — GIỮ NGUYÊN của Trading Hub 3
// Sau khi thay engine, pullback không còn nuôi IDM nữa. Giữ lại làm nguồn dữ liệu
// cho #9 (Order Flow) và #16 (SCOB tại pullback). Xem mục #1 trong tài liệu biến thể.
if high >= top and low <= bot //notrend
    if mnStrc != MN_NA
        prevMnStrc := mnStrc

    if prevMnStrc == MN_UP
        top_ := top
        bar_ := bar
    else
        bot_ := bot
        bar_ := bar

    top :=   high
    bot :=   low
    bar :=   time
    mnStrc   := MN_NA

if high >= top and low > bot //uptrend
    if prevMnStrc == MN_UP and mnStrc == MN_NA
        array.push(puHBar, bar_)
        array.push(puHigh, top_)
        array.push(puLBar, bar)
        array.push(puLow, bot)
        drawPullback(bar_, top_, true)
        drawPullback(bar, bot, false)
    else if (prevMnStrc == MN_DN and mnStrc == MN_NA) or mnStrc == MN_DN
        array.push(puLBar, bar)
        array.push(puLow, bot)
        drawPullback(bar, bot, false)

    top := high
    bot := low
    bar := time
    prevMnStrc := MN_NA
    mnStrc := MN_UP

if high < top and low <= bot //downtrend
    if prevMnStrc == MN_DN and mnStrc == MN_NA
        array.push(puHBar, bar)
        array.push(puHigh, top)
        array.push(puLBar, bar_)
        array.push(puLow, bot_)
        drawPullback(bar, top, true)
        drawPullback(bar_, bot_, false)
    else if (prevMnStrc == MN_UP and mnStrc == MN_NA) or mnStrc == MN_UP
        array.push(puHBar, bar)
        array.push(puHigh, top)
        drawPullback(bar, top, true)

    top := high
    bot := low
    bar := time
    prevMnStrc := MN_NA
    mnStrc := MN_DN

trimArr(puHigh)
trimArr(puHBar)
trimArr(puLow)
trimArr(puLBar)
//#endregion

//#region ===== ENGINE CẤU TRÚC — LUXALGO =====================================
// Nguồn: Document/smc_structure_luxalgo dòng 33-165.
// Khác bản gốc LuxAlgo: dùng xloc.bar_time thay cho bar_index để đồng bộ với POI/OB
// và để chiếu được đường "live" ra tương lai.

swings(int length) =>
    var int os = 0
    var int topx = na
    var int btmx = na

    upper = ta.highest(length)
    lower = ta.lowest(length)

    os := high[length] > upper ? 0 : low[length] < lower ? 1 : os[1]

    top = os == 0 and os[1] != 0 ? high[length] : na
    topx := os == 0 and os[1] != 0 ? time[length] : topx

    btm = os == 1 and os[1] != 1 ? low[length] : na
    btmx := os == 1 and os[1] != 1 ? time[length] : btmx

    [top, topx, btm, btmx]

[swTop, swTopBar, swBtm, swBtmBar] = swings(chochLen)
[sTop , sTopBar , sBtm , sBtmBar ] = swings(idmLen)

// bias: 1 = bullish, 0 = bearish
var int os = 0

// mốc CHoCH (swing thô, chochLen nến)
var float chTop = na
var float chBtm = na
var int   chTopBar = na
var int   chBtmBar = na
var bool  topCrossed = false
var bool  btmCrossed = false

// mốc BOS (cực trị chạy từ lần lật bias gần nhất)
var float bosMax = na
var float bosMin = na
var int   bosMaxBar = na
var int   bosMinBar = na
var int   bosMaxIdx = na
var int   bosMinIdx = na

// cổng IDM
var bool idmHiCrossed = false
var bool idmLoCrossed = false

// mốc IDM (swing mịn, idmLen nến) — fixnan giữ giá trị hợp lệ gần nhất
idmHi = fixnan(sTop)
idmLo = fixnan(sBtm)
idmHiBar = sTopBar
idmLoBar = sBtmBar

//--- Cập nhật mốc CHoCH khi có swing mới ------------------------------------
if not na(swTop)
    chTop := swTop
    chTopBar := swTopBar
    topCrossed := false

if not na(swBtm)
    chBtm := swBtm
    chBtmBar := swBtmBar
    btmCrossed := false

//--- CHoCH: đóng nến vượt mốc swing, ngược chiều bias -> lật bias ------------
if not na(chTop) and close > chTop and not topCrossed
    os := 1
    topCrossed := true

if not na(chBtm) and close < chBtm and not btmCrossed
    os := 0
    btmCrossed := true

//--- Vẽ CHoCH + reset toàn bộ trạng thái khi bias lật -----------------------
if os != os[1]
    bosMax := high
    bosMin := low
    bosMaxBar := time
    bosMinBar := time
    bosMaxIdx := barIdx
    bosMinIdx := barIdx
    idmHiCrossed := false
    idmLoCrossed := false

    if showChoCh
        if os == 1
            drawStrc(CHOCH_TEXT, chTopBar, chTop, true)
        else
            drawStrc(CHOCH_TEXT, chBtmBar, chBtm, false)

//--- Bullish: IDM rồi BOS ---------------------------------------------------
// IDM xác nhận bằng RÂU nến (không cần đóng nến) — giống Trading Hub bản gốc.
// Guard idmLo != chBtm: mốc IDM không được trùng mốc CHoCH.
if not na(idmLo) and low < idmLo and not idmLoCrossed and os == 1 and idmLo != chBtm
    if showIDM
        drawIdm(idmLoBar, idmLo, false)
    idmLoCrossed := true

if not na(bosMax) and close > bosMax and idmLoCrossed and os == 1
    if showBOS
        drawStrc(BOS_TEXT, bosMaxBar, bosMax, true)
    idmLoCrossed := false

//--- Bearish: IDM rồi BOS ---------------------------------------------------
if not na(idmHi) and high > idmHi and not idmHiCrossed and os == 0 and idmHi != chTop
    if showIDM
        drawIdm(idmHiBar, idmHi, true)
    idmHiCrossed := true

if not na(bosMin) and close < bosMin and idmHiCrossed and os == 0
    if showBOS
        drawStrc(BOS_TEXT, bosMinBar, bosMin, false)
    idmHiCrossed := false

//--- Sweeps: quét râu qua mốc BOS nhưng không đóng nến ----------------------
// LƯU Ý: đây là sweep tại mốc BOS. Sweep tại mốc CHoCH chưa có — xem #L3.
if showSw and not na(bosMax) and high > bosMax and close < bosMax and os == 1 and barIdx - bosMaxIdx > 1
    drawSweep(bosMaxBar, bosMax, true)

if showSw and not na(bosMin) and low < bosMin and close > bosMin and os == 0 and barIdx - bosMinIdx > 1
    drawSweep(bosMinBar, bosMin, false)

//--- Cực trị chạy: PHẢI đặt SAU các khối check ở trên -----------------------
// Đây chính là cơ chế "râu quét nâng mốc tham chiếu" (BankTrap trang 7).
bosMax := na(bosMax) ? high : math.max(high, bosMax)
bosMin := na(bosMin) ? low  : math.min(low , bosMin)

// na(bosMaxBar) bắt buộc phải có: bias khởi tạo = 0 (bearish) nên khối BOS/sweep phía dưới
// có thể chạy TRƯỚC lần lật bias đầu tiên, khi đó mốc bar vẫn còn na => vẽ hỏng.
if na(bosMaxBar) or bosMax > nz(bosMax[1], bosMax)
    bosMaxBar := time
    bosMaxIdx := barIdx

if na(bosMinBar) or bosMin < nz(bosMin[1], bosMin)
    bosMinBar := time
    bosMinIdx := barIdx

//--- Đường "live": mốc đang chờ bị phá --------------------------------------
var line  liveChochLn  = na
var line  liveBosLn    = na
var line  liveIdmLn    = na
var label liveChochLbl = na
var label liveBosLbl   = na
var label liveIdmLbl   = na

if barstate.islast
    line.delete(liveChochLn), line.delete(liveBosLn), line.delete(liveIdmLn)
    label.delete(liveChochLbl), label.delete(liveBosLbl), label.delete(liveIdmLbl)

    if showLive
        // đường live dùng xloc.bar_index để chiếu thẳng ra tương lai — không phụ thuộc
        // khoảng cách thời gian giữa các nến (an toàn với phiên nghỉ / cuối tuần)
        x2 = bar_index + liveLen

        chY   = os == 1 ? chBtm : chTop
        chCol = os == 1 ? bear : bull
        chUp  = os != 1
        bosY  = os == 1 ? bosMax : bosMin
        bosCol= os == 1 ? bull : bear
        idmY  = os == 1 ? idmLo : idmHi
        idmPending = os == 1 ? not idmLoCrossed : not idmHiCrossed

        if showChoCh and not na(chY)
            liveChochLn  := line.new(bar_index, chY, x2, chY, xloc.bar_index, color = chCol, style = line.style_dashed)
            liveChochLbl := label.new(x2, chY, CHOCH_TEXT, xloc.bar_index, color = transp, textcolor = chCol, style = getStyleLabel(chUp), size = size.small)

        if showBOS and not na(bosY)
            liveBosLn  := line.new(bar_index, bosY, x2, bosY, xloc.bar_index, color = bosCol, style = line.style_solid)
            liveBosLbl := label.new(x2, bosY, BOS_TEXT, xloc.bar_index, color = transp, textcolor = bosCol, style = getStyleLabel(os == 1), size = size.small)

        if showIDM and idmPending and not na(idmY)
            liveIdmLn  := line.new(bar_index, idmY, x2, idmY, xloc.bar_index, color = colorIDM, style = line.style_dotted)
            liveIdmLbl := label.new(x2, idmY, IDM_TEXT, xloc.bar_index, color = transp, textcolor = colorIDM, style = getStyleLabel(os != 1), size = size.small)
//#endregion

//#region POI  — GIỮ NGUYÊN của Trading Hub 3
if showPOI
    if not isSweepOBS
        high_MOBS := high[3]
        low_MOBS := low[3]
        current_OBS := time[3]
        if high_MOBS > high[4] and high_MOBS > high[2]
            isSweepOBS := true
    else
        if low_MOBS > high[1]
            handleZone(supplyZone, current_OBS, high_MOBS, low_MOBS, colorSupply)
            isSweepOBS := false
        else
            if poi_type == "Mother Bar" and isb[2]
                high_MOBS := math.max(high_MOBS,motherHigh[2])
                low_MOBS := math.min(low_MOBS,motherLow[2])
                current_OBS := math.min(current_OBS,motherBar)
            else
                high_MOBS := high[2]
                low_MOBS := low[2]
                current_OBS := time[2]

    if not isSweepOBD
        low_MOBD := low[3]
        high_MOBD := high[3]
        current_OBD := time[3]
        if low_MOBD < low[4] and low_MOBD < low[2]
            isSweepOBD := true
    else
        if high_MOBD < low[1]
            handleZone(demandZone, current_OBD, high_MOBD, low_MOBD, colorDemand)
            isSweepOBD := false
        else
            if poi_type == "Mother Bar" and isb[2]
                high_MOBD := math.max(high_MOBD,motherHigh[2])
                low_MOBD := math.min(low_MOBD,motherLow[2])
                current_OBD := math.min(current_OBD,motherBar)
            else
                high_MOBD := high[2]
                low_MOBD := low[2]
                current_OBD := time[2]
//#endregion

//#region run function
barcolor(showSCOB ? scob(supplyZone, true) : na, -1)
barcolor(showSCOB ? scob(demandZone, false) : na, -1)
processZones(supplyZone, true)
processZones(demandZone, false)

// chấm swing — vẽ lùi về đúng nến tạo đỉnh/đáy
plot(showSwings ? swTop : na, 'Swing High', color.new(bear, 50), 4, plot.style_circles, offset = -chochLen)
plot(showSwings ? swBtm : na, 'Swing Low' , color.new(bull, 50), 4, plot.style_circles, offset = -chochLen)
//#endregion
